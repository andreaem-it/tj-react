# =============================================================================
# Backend (tj-api) — variabili solo sul deploy del backend
# =============================================================================
# Newsletter (Brevo), Meta/social stats, GA4/GSC/AdSense per dashboard, DB, R2,
# webhook WordPress, Turso, ecc. sono configurati in tj-api (.env).
# Documentazione: repo tj-api e .env.example lì.

# =============================================================================
# Frontend (Next — questo progetto)
# =============================================================================

# Obbligatorio per le route /api/* che fanno proxy verso tj-api (articoli, auth,
# analytics, newsletter, price-radar, …). Esempio locale: http://localhost:3003
# SSR pagine /compatibility: con questo valorizzato le fetch vanno dirette a tj-api (evita deadlock
# in dev su fetch al proprio /api); senza → come prima (proxy /api o NEXT_PUBLIC_TJ_API_BASE_URL).
TJ_API_BASE_URL=

# Chiamate pubbliche read-only dal browser verso tj-api (Price Radar, post, megamenu, social-stats).
# Se omesso o vuoto → fetch su /api/... (proxy Next, stesso origin, niente CORS).
# Se imposti un host (es. https://backend.techjournal.it), su tj-api servono CORS_ORIGINS
# che includano https://www.techjournal.it (vedi tj-api .env.example).
# Produzione consigliata: lasciare vuoto e usare solo il proxy Next, oppure api/backend con CORS sul backend.
NEXT_PUBLIC_TJ_API_BASE_URL=
# NEXT_PUBLIC_TJ_API_BASE_URL=https://api.techjournal.it

# API pubblica articoli / WordPress (default in codice se omesso)
NEXT_PUBLIC_API_BASE=https://api.techjournal.it
# NEXT_PUBLIC_WP_BASE=https://api.techjournal.it/wp-json/tj/v1

# Token server-side inviato come header X-TJ-WP-Token verso api.techjournal.it/wp-json/tj/v1/*.
# Su Cloudflare: regola WAF Skip per path /wp-json/tj/v1/* quando l'header coincide (evita 403 da IP Vercel).
# WP_TJ_BYPASS_TOKEN=

# Sito (sitemap, canonical, OG)
# NEXT_PUBLIC_SITE_URL=https://www.techjournal.it

# Purge Cloudflare alla pubblicazione di un articolo (lib/cacheInvalidation.ts).
# La CDN serve l'HTML dalla propria cache e non si accorge che l'origin è
# cambiato: senza queste due variabili `purgeCloudflare()` resta inerte e i
# contenuti nuovi restano invisibili fino alla scadenza del max-age (24h).
# Il token richiede il solo permesso "Zone → Cache Purge → Purge".
# Lo Zone ID è nella dashboard Cloudflare, Overview della zona (32 char hex).
# In locale si lasciano vuote: il purge va fatto partire solo dalla produzione.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=

# GA4 lato browser (Measurement ID)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity (Project ID da clarity.microsoft.com → Settings → Setup)
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# AdSense — slot e publisher (client)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_SKYSCRAPER_LEFT=
NEXT_PUBLIC_ADSENSE_SLOT_SKYSCRAPER_RIGHT=
# NEXT_PUBLIC_ADSENSE_TEST=on

# iubenda
NEXT_PUBLIC_IUBENDA_SITE_ID=
NEXT_PUBLIC_IUBENDA_COOKIE_POLICY_ID=
# NEXT_PUBLIC_IUBENDA_LANG=it
# NEXT_PUBLIC_IUBENDA_PRIVACY_URL=
# NEXT_PUBLIC_IUBENDA_COOKIE_POLICY_URL=
# NEXT_PUBLIC_IUBENDA_TERMS_URL=

# TechRadar / Price Radar (feature flag UI)
# NEXT_PUBLIC_PRICE_RADAR_ENABLED=true
# NEXT_PUBLIC_PRICE_RADAR_BETA_ENABLED=true
# NEXT_PUBLIC_PRICE_RADAR_SQLITE_ENABLED=true
# NEXT_PUBLIC_TECHRADAR_API_BASE=https://api.techjournal.it/techradar/api

# Notifiche push (§46). Solo la chiave pubblica sta qui: serve al browser per
# sottoscriversi (lib/push/vapid.ts, components/push/PushOptIn.tsx). La chiave
# PRIVATA va nell'ambiente di tj-api, MAI in questo progetto: è quel servizio
# a firmare e inviare i push, non questo frontend.
#
# Generarle senza dipendenze aggiuntive (Node ha già tutto):
#   node -e '
#     const c=require("crypto");
#     const {publicKey,privateKey}=c.generateKeyPairSync("ec",{namedCurve:"prime256v1",
#       publicKeyEncoding:{type:"spki",format:"der"},privateKeyEncoding:{type:"pkcs8",format:"der"}});
#     const b64u=b=>b.toString("base64").replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,"");
#     const pub=publicKey.subarray(publicKey.length-65);
#     const sec1=c.createPrivateKey({key:privateKey,format:"der",type:"pkcs8"}).export({format:"der",type:"sec1"});
#     const i=sec1.indexOf(Buffer.from([4,32]));
#     console.log("PUBLIC ", b64u(pub));
#     console.log("PRIVATE", b64u(sec1.subarray(i+2,i+34)));
#   '
#
# Contratto atteso da tj-api (repository separato, non in questo progetto):
#   POST /api/push/subscribe    { endpoint, keys: { p256dh, auth }, topics?: string[] }
#     → upsert per `endpoint` (un browser può richiamarlo più volte)
#   POST /api/push/unsubscribe  { endpoint }
#     → delete per `endpoint`; endpoint sconosciuto = no-op, non errore
# Questo frontend inoltra entrambi via proxyToTjApi senza guardare il corpo
# (stesso schema di /api/newsletter). L'invio effettivo (firma VAPID, incontro
# con la libreria web-push o equivalente) resta lato tj-api.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Verifica Search Console (meta tag)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# OG default
# OG_DEFAULT_IMAGE_URL=
# NEXT_PUBLIC_OG_DEFAULT_IMAGE_URL=

# Image optimization fallback:
# default behavior is passthrough (no `/_next/image`) to prevent 402 in production.
# Set to 0 only if your deploy has stable/billed image optimization enabled.
# NEXT_IMAGE_PASSTHROUGH=0

# Contatti
# NEXT_PUBLIC_CONTACT_EMAIL=

# =============================================================================
# Modulo compatibilità Apple — dati su Neon tramite tj-api (TJ_API_BASE_URL + proxy /api/compatibility/*)
# Stesse regole delle altre fetch proxy (post, megamenu, …) in lib/tjApiClient.ts
# =============================================================================

# =============================================================================
# Auth (route /api/* su questo Next se usate; pannello articoli = tj-react-admin; compatibilità: solo tj-react-admin)
# =============================================================================
# Sessione cookie per route protette di questo frontend (se usate).
AUTH_SECRET=

# Stesso segreto di tj-react-admin / tj-api per le route /api/admin/* (proxy verso tj-api).
# Protegge anche l'anteprima del digest newsletter:
#   GET /api/newsletter/digest            → oggetto + HTML + testo pronti per l'invio
#   GET /api/newsletter/digest?format=html → sola anteprima HTML nel browser
#   parametri: ?hours=24 (finestra) ?items=8 (voci)
# L'endpoint compone il contenuto e non spedisce: l'invio resta a tj-api, dove
# stanno le credenziali Brevo.
# PRICE_RADAR_ADMIN_SECRET=
