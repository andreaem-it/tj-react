{
  "name": "techjournal-clone",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "eslint-plugin-react-hooks": "7.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "cf:build:production": "TJ_API_BASE_URL=${TJ_API_BUILD_BASE_URL:-https://backend.techjournal.it} opennextjs-cloudflare build --config wrangler.production.jsonc",
    "cf:deploy:production": "npm run cf:check:production && wrangler deploy --config wrangler.production.jsonc",
    "cf:upload:production": "npm run cf:check:production && wrangler versions upload --config wrangler.production.jsonc",
    "cf:check:production": "node scripts/check-cloudflare-build.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "@mep-agency/next-iubenda": "1.0.0-alpha5",
    "@microsoft/clarity": "^1.0.2",
    "@opennextjs/cloudflare": "1.20.6",
    "@types/bcryptjs": "^2.4.6",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.2",
    "next": "16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.35.3",
    "styled-jsx": "5.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "wrangler": "4.131.2"
  }
}
