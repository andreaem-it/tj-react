d:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L23",null,{"posts":[{"id":18048,"date":"2026-09-25T09:06:00+02:00","modified":"2026-09-25T07:06:00+00:00","slug":"tim-cook-incontra-ursula-von-der-leyen-eu-kids-act-social-minori","title":"Tim Cook incontra Ursula von der Leyen: sul tavolo l’EU Kids Act per limitare i social ai minori","excerpt":"Tim Cook ha incontrato Ursula von der Leyen a Manhattan. Al centro del colloquio l’EU Kids Act, proposta UE per limitare l’accesso dei minori ai social e imporre nuove tutele alle piattaforme.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/tim-cook-ursula-europa-eu-kids-act-768x432.jpg","imageAlt":"tim-cook-ursula-europa-eu-kids-act","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18095,"date":"2026-09-28T16:56:17+02:00","modified":"2026-09-28T14:56:17+00:00","slug":"apple-condannata-5-7-miliardi-violazione-brevetti-aptici","title":"Apple condannata a pagare 5,7 miliardi per violazione di brevetti aptici","excerpt":"Un tribunale federale ha ordinato ad Apple di pagare 5,7 miliardi di dollari a Taction Technology per l’infrazione di due brevetti relativi alla tecnologia aptica.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/apple-watch-series-9-display-768x432.jpeg","imageAlt":"apple-watch-series-9-display","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18101,"date":"2026-09-28T16:20:17+02:00","modified":"2026-09-28T14:20:17+00:00","slug":"watchos-27-12-novita-da-provare-su-apple-watch","title":"watchOS 27: 12 novità da provare su Apple Watch","excerpt":"watchOS 27 è disponibile dal 14 settembre. Ecco 12 cambiamenti e funzioni da scoprire, tra Siri dedicato, Smart Stack più intelligente, nuove gesture e aggiornamenti per salute e allenamenti.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/watchOS-27-Hands-On-Thumb-768x432.jpg","imageAlt":"watchOS-27-Hands-On-Thumb","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18097,"date":"2026-09-28T15:35:48+02:00","modified":"2026-09-28T13:35:48+00:00","slug":"apple-tv-screensaver-audio-si-parte-da-snoopy","title":"Apple TV: gli screensaver potrebbero avere l’audio, si parte da Snoopy","excerpt":"Nel codice di tvOS 27 sono emerse impostazioni nascoste per attivare effetti sonori nei salvaschermo di Apple TV. Il primo a beneficiarne potrebbe essere quello dedicato a Snoopy.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/tvos-27-salvaschermo-audio-featured-768x432.jpg","imageAlt":"tvos-27-salvaschermo-audio-featured","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18103,"date":"2026-09-28T15:00:49+02:00","modified":"2026-09-28T13:03:57+00:00","slug":"apple-valuta-quattro-concept-nuovo-headset-vision-pro","title":"Apple valuta quattro concept per un nuovo headset Vision Pro","excerpt":"Apple starebbe esplorando quattro diverse idee per un nuovo headset legato alla linea Vision Pro, con l’obiettivo di definire forme, funzionalità e approcci di prodotto differenti.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/Vision-Pro-M5-Announcement-768x423.jpg","imageAlt":"Vision-Pro-M5-Announcement","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18068,"date":"2026-09-26T08:22:00+02:00","modified":"2026-09-26T06:22:00+00:00","slug":"square-annuncia-integrazione-apple-business","title":"Square annuncia l’integrazione con Apple Business per aggiornare i dati","excerpt":"Square introduce una nuova integrazione con Apple Business per aiutare le attività a mantenere informazioni aggiornate su Apple Maps, Apple Wallet e Siri AI direttamente dal Dashboard.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/Square-Apple-Maps-768x432.jpeg","imageAlt":"Square-Apple-Maps","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18066,"date":"2026-09-26T08:00:00+02:00","modified":"2026-09-26T06:00:00+00:00","slug":"watchos-27-2-indizi-anteprime-screenshot-stile-iphone-su-apple-watch","title":"watchOS 27.2: indizi di anteprime screenshot “stile iPhone” su Apple Watch","excerpt":"In watchOS 27.2 potrebbero arrivare anteprime degli screenshot su Apple Watch con opzioni per condividerli o eliminarli, in un’esperienza più simile a quella dell’iPhone.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/watchos-27-2-screenshot-768x432.jpg","imageAlt":"watchos-27-2-screenshot","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18058,"date":"2026-09-25T12:02:00+02:00","modified":"2026-09-25T10:02:00+00:00","slug":"cop