d:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L25",null,{"posts":[{"id":16890,"date":"2026-08-11T22:50:23+02:00","modified":"2026-08-11T20:50:23+00:00","slug":"tvos-27-watchos-27-terze-beta-pubbliche","title":"tvOS 27 e watchOS 27: disponibili le terze beta pubbliche","excerpt":"Apple rilascia le terze beta pubbliche di tvOS 27 e watchOS 27, con novità su Siri AI, Smart Stack, Find My e miglioramenti per Apple TV e HomePod.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/08/watchos-27-768x432.jpg","imageAlt":"watchos-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17858,"date":"2026-09-18T08:22:00+02:00","modified":"2026-09-18T06:22:00+00:00","slug":"apple-prime-beta-watchos-27-2-tvos-27-2-visionos-27-2","title":"Apple rilascia le prime beta di watchOS 27.2, tvOS 27.2 e visionOS 27.2","excerpt":"Apple ha reso disponibili le prime versioni beta di watchOS 27.2, tvOS 27.2 e visionOS 27.2, aprendo la fase di test per le piattaforme dedicate a Apple Watch, Apple TV e Vision Pro.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/General-visionOS-watchOS-and-tvOS-Betas-Feature-Redux-768x432.jpg","imageAlt":"General-visionOS-watchOS-and-tvOS-Betas-Feature-Redux","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17817,"date":"2026-09-16T12:46:00+02:00","modified":"2026-09-16T10:46:00+00:00","slug":"icloud-plus-apple-tv-apple-arcade-oltre-100-paesi","title":"iCloud+ si espande: Apple TV, Apple Arcade e nuove stazioni Apple Music in oltre 100 Paesi","excerpt":"Apple porta i contenuti di Apple TV e Apple Arcade dentro i piani iCloud+ in più di 100 Paesi, includendo anche Apple Music Select. Accesso automatico per gli abbonati esistenti.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/Apple-iCloud-Plus-expansion-hero-768x512.jpg","imageAlt":"Apple-iCloud-Plus-expansion-hero","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17790,"date":"2026-09-15T12:24:00+02:00","modified":"2026-09-15T10:24:00+00:00","slug":"nuova-apple-tv-homepod-mini-lanci-in-arrivo-entro-lanno","title":"Nuova Apple TV e HomePod Mini: lanci in arrivo entro l’anno","excerpt":"Nuovi dispositivi Apple in arrivo: una nuova Apple TV e un HomePod Mini, con ulteriori novità in preparazione per il lancio entro l’anno.","categoryName":"Smart Home","categorySlug":"smart-home","categoryId":11,"imageUrl":"https://static.techjournal.it/2026/09/HomePod-mini-and-Apple-TV-Sage-768x432.jpg","imageAlt":"HomePod-mini-and-Apple-TV-Sage","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17627,"date":"2026-09-11T12:46:00+02:00","modified":"2026-09-11T10:46:00+00:00","slug":"apple-tv-4k-nuovo-chip-salto-potenza-apple-intelligence","title":"Apple TV 4K: il nuovo chip potrebbe essere un salto di potenza per Apple Intelligence","excerpt":"Le indiscrezioni sulla nuova Apple TV 4K puntano a un chip più moderno e pronto per Apple Intelligence. Ora emergono segnali che suggeriscono un salto di potenza più grande del previsto.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/apple-tv-a19-chip-768x432.jpg","imageAlt":"apple-tv-a19-chip","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17567,"date":"2026-09-10T10:12:00+02:00","modified":"2026-09-09T17:52:23+00:00","slug":"prossimo-apple-tv-4k-chip-a19-ram-8-12-gb","title":"Chip A19 per il prossimo Apple TV 4K: possibili RAM da 8 o 12 GB","excerpt":"Il prossimo Apple TV 4K potrebbe passare a un chip A19 o A19 Pro. In arrivo anche più RAM (8 o 12 GB) e nuove funzioni legate a Siri, rete Wi‑Fi 7 e un Siri Remote aggiornato.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/Where-is-the-New-Apple-TV-Feature-768x432.jpg","imageAlt":"Where-is-the-New-Apple-TV-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17295,"date":"2026-08-29T12:02:00+02:00","modified":"2026-08-29T10:02:00+00:00","slug":"apple-tv-acquista-small-prophets-prima-volta","title":"Apple TV acquista “Small Prophets”: prima volta per un successo già affermato","excerpt":"Apple TV ha acquistato i diritti mondiali di “Small Prophets”, serie inglese già diventata un successo prima dell’arrivo sulla piattaforma. Debutto globale dal 7 ottobre, con eccezione del Regno Unito.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/08/Apple-TV-Color-768x432.jpg","imageAlt":"Apple-TV-Color","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":4,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17238,"date":"2026-08-28T12:02:00+02:00","modified":"2026-08-28T10:02:00+00:00","slug":"ios-27-nuove-funzioni-ai-apple-tv-4k-homepod","title":"iOS 27: nuove funzioni AI in arrivo su Apple TV 4K ed HomePod","excerpt":"Dai primi indizi sul codice di iOS 27 emergono possibili nuove funzioni basate sull’intelligenza artificiale in arrivo su Apple TV 4K e HomePod.","categoryName":"Smart Home","categorySlug":"smart-home","categoryId":11,"imageUrl":"https://static.techjournal.it/2026/08/apple-tv-homepod-siri-ai-768x432.jpg","imageAlt":"apple-tv-homepod-siri-ai","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null}],"heading":"Artic