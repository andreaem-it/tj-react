c:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L27",null,{"posts":[{"id":18085,"date":"2026-09-26T09:28:00+02:00","modified":"2026-09-26T07:28:00+00:00","slug":"come-controllare-data-di-produzione-mac-macos-27","title":"Come controllare la data di produzione del tuo Mac in macOS 27","excerpt":"Con macOS 27 Golden Gate puoi risalire alla data di produzione del tuo Mac tramite la sezione “Regulatory Certification” nel System Report.","categoryName":"Guide","categorySlug":"guide","categoryId":196,"imageUrl":"https://static.techjournal.it/2026/09/2026-mac-mini-blue-768x432.jpeg","imageAlt":"2026-mac-mini-blue","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18050,"date":"2026-09-25T09:28:00+02:00","modified":"2026-09-25T07:28:00+00:00","slug":"apple-beta-pubblica-ios-27-2-ipados-27-2-macos-27-2-app-salute","title":"Apple rilascia la beta pubblica di iOS 27.2, iPadOS 27.2 e macOS 27.2: arriva l’app Salute","excerpt":"Disponibile la prima beta pubblica di iOS 27.2, iPadOS 27.2 e macOS 27.2: la nuova app Salute è tra le novità provabili da subito dai tester.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/ios-27.2-beta-1-pubblica-768x432.jpg","imageAlt":"ios-27.2-beta-1-pubblica","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18046,"date":"2026-09-25T08:44:00+02:00","modified":"2026-09-25T06:44:00+00:00","slug":"apple-intelligence-oltre-30gb-su-alcuni-mac-con-macos-27-golden-gate","title":"Apple Intelligence supera i 30GB su alcuni Mac con macOS 27 Golden Gate","excerpt":"Dopo l’installazione di macOS 27 Golden Gate, Apple Intelligence può scaricare modelli AI multi‑gigabyte sul Mac. In alcuni casi lo spazio occupato supera i 30GB, anche oltre le soglie indicate da Apple.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/apple-intelligence-black-768x432.jpeg","imageAlt":"apple-intelligence-black","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18037,"date":"2026-09-24T12:46:00+02:00","modified":"2026-09-24T10:46:00+00:00","slug":"mac-studio-m5-max-m5-ultra-prime-recensioni-prezzo-altissimo","title":"Mac Studio M5 Max ed M5 Ultra, le prime recensioni: il Mac più potente di sempre, ma il prezzo arriva a cifre altissime","excerpt":"Le prime recensioni di Mac Studio con chip M5 Max e M5 Ultra lo descrivono come il Mac più potente mai realizzato, ma con un listino che può raggiungere cifre molto elevate.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/mac-studio-2026-review-768x432.jpg","imageAlt":"mac-studio-2026-review","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18020,"date":"2026-09-23T12:33:22+02:00","modified":"2026-09-23T10:33:22+00:00","slug":"apple-prime-beta-pubbliche-ios-27-2-macos-golden-gate-27-2","title":"Apple avvia le prime beta pubbliche di iOS 27.2 e macOS Golden Gate 27.2","excerpt":"Apple ha rilasciato le prime beta pubbliche di iOS 27.2, iPadOS 27.2, macOS Golden Gate 27.2, tvOS 27.2 e watchOS 27.2. Novità principali: app Salute ridisegnata e nuove opzioni in Apple TV con Siri AI in più lingue.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/iOS-27.2-Next-to-iPhone-768x432.jpg","imageAlt":"iOS-27.2-Next-to-iPhone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17958,"date":"2026-09-22T08:00:00+02:00","modified":"2026-09-22T06:00:00+00:00","slug":"apple-seconda-be