c:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L24",null,{"posts":[{"id":17936,"date":"2026-09-20T09:28:00+02:00","modified":"2026-09-20T07:28:00+00:00","slug":"top-stories-ios-27-macos-golden-gate-siri-ai-waitlist","title":"Top Stories: iOS 27 e macOS Golden Gate disponibili, Siri AI in waitlist e altro","excerpt":"Disponibili iOS 27 e macOS Golden Gate con Siri AI e nuove funzioni. Siri AI richiede una waitlist, iPhone 18 Pro Max negli USA usa un modem diverso e iCloud+ si amplia in oltre 100 paesi.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/top-stories-2026-09-19-768x432.jpg","imageAlt":"top-stories-2026-09-19","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17872,"date":"2026-09-18T08:44:00+02:00","modified":"2026-09-18T06:44:00+00:00","slug":"macos-golden-gate-50-novita-siri-app-interfaccia","title":"macOS Golden Gate: 50 novità tra Siri, app Apple e interfaccia","excerpt":"macOS 27 Golden Gate porta un’esperienza Siri rinnovata, nuove funzioni in Safari, Foto, Mail e Calendario, miglioramenti all’interfaccia e aggiornamenti per AirDrop, i widget e molto altro.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/50-New-macOS-Golden-Gate-Features-and-Changes-Worth-Checking-Out-Feature-768x432.jpg","imageAlt":"50-New-macOS-Golden-Gate-Features-and-Changes-Worth-Checking-Out-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17784,"date":"2026-09-16T08:00:00+02:00","modified":"2026-09-16T06:00:00+00:00","slug":"macos-golden-gate-10-funzioni-da-provare-subito","title":"macOS Golden Gate: 10 funzioni da provare subito","excerpt":"Da Siri AI a Visual Intelligence, fino a Liquid Glass e miglioramenti di performance: ecco le 10 novità di macOS Golden Gate da testare appena installato.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/10-macOS-Features-to-Try-First-Feature-768x432.jpg","imageAlt":"10-macOS-Features-to-Try-First-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17351,"date":"2026-09-01T12:46:00+02:00","modified":"2026-09-01T10:46:00+00:00","slug":"apple-rilascia-beta-8-macos-golden-gate","title":"Apple rilascia la beta 8 di macOS Golden Gate per sviluppatori","excerpt":"Apple ha distribuito la beta 8 di macOS Golden Gate agli sviluppatori. Aggiornamento via Software Update, con nuove funzioni per Siri AI, miglioramenti di interfaccia e strumenti di editing foto basati sull’AI.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":4,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17154,"date":"2026-08-25T08:00:00+02:00","modified":"2026-08-25T06:00:00+00:00","slug":"apple-rilascia-beta-7-macos-golden-gate-siri-ai-nuove-funzioni-ui","title":"Apple rilascia la beta 7 di macOS Golden Gate: Siri AI, nuove funzioni e ritocchi UI","excerpt":"Apple mette a disposizione degli sviluppatori la settima beta di macOS Golden Gate. Tra le novità: Siri AI in stile chatbot, miglioramenti di interfaccia e strumenti AI in Foto, Safari, Password e Image Playground.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/08/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16993,"date":"2026-08-19T09:06:00+02:00","modified":"2026-08-19T07:06:00+00:00","slug":"apple-rilascia-beta-6-macos-golden-gate-per-sviluppatori","title":"Apple rilascia la beta 6 di macOS Golden Gate per sviluppatori","excerpt":"Arriva la sesta beta di macOS Golden Gate: aggiornamento via Software Update, nuove modifiche di design e un’evoluzione di Siri in “Siri AI”, con funzioni legate a Spotlight e Visual Intelligence.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/08/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16850,"date":"2026-08-11T08:22:00+02:00","modified":"2026-08-11T06:22:00+00:00","slug":"apple-rilascia-beta-5-macos-golden-gate-siri-ai-nuove-funzioni-ui-aggiornata","title":"Apple rilascia la beta 5 di macOS Golden Gate: Siri AI, nuove funzioni e UI aggiornata","excerpt":"Apple ha reso disponibile la quinta beta di macOS Golden Gate per gli sviluppatori. Tra le novità: Siri AI in Spotlight, miglioramenti di design e strumenti AI in app come Foto, Safari e Password.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/08/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16493,"date":"2026-07-24T18:58:21+02:00","modified":"2026-07-24T16:58:21+00:00","slug":"macos-27-beta-reworks-mail-compose-write-with-siri","title":"macOS 27: la beta rivede la finestra di composizione di Mail attorno a “Write with Siri”","excerpt":"Nelle beta di macOS 27 emergono novità per Mail: una nuova barra di formattazione mette in primo piano “Write with Siri”, integra Smart Reply contestuali e introduce opzioni come Proofread e Rewrite.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/07/iOS-27-Mail-Feature-768x432.jpg","imageAlt":"iOS-27-Mail-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null}],"heading":"Articoli correlati"}]}]
