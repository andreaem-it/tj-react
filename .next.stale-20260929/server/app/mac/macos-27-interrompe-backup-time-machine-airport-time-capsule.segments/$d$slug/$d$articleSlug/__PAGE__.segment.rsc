d:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L26",null,{"posts":[{"id":17162,"date":"2026-08-24T22:35:00+02:00","modified":"2026-08-24T20:35:00+00:00","slug":"apple-seconda-release-candidate-macos-tahoe-26-7-sequoia-15-8","title":"Apple rilascia le seconde Release Candidate di macOS Tahoe 26.7 e macOS Sequoia 15.8","excerpt":"Apple distribuisce agli sviluppatori le seconde Release Candidate di macOS Tahoe 26.7 e macOS Sequoia 15.8, a una settimana dalle prime. In parallelo arriva anche la beta 7 di macOS 27 Golden Gate.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/08/macos-tahoe-768x432.jpg","imageAlt":"macos-tahoe","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18087,"date":"2026-09-26T12:02:00+02:00","modified":"2026-09-26T10:02:00+00:00","slug":"macos-golden-gate-cosa-sparisce-e-cosa-cambia-con-macos-28","title":"macOS Golden Gate: cosa sparisce oggi e cosa cambia con macOS 28","excerpt":"Con macOS Golden Gate Apple taglia supporto per Intel, Boot Camp, Rosetta 2 (in modo definitivo) e servizi legacy come AFP, Time Capsule e AirPort Utility. Ulteriori riduzioni sono attese con macOS 28.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18085,"date":"2026-09-26T09:28:00+02:00","modified":"2026-09-26T07:28:00+00:00","slug":"come-controllare-data-di-produzione-mac-macos-27","title":"Come controllare la data di produzione del tuo Mac in macOS 27","excerpt":"Con macOS 27 Golden Gate puoi risalire alla data di produzione del tuo Mac tramite la sezione “Regulatory Certification” nel System Report.","categoryName":"Guide","categorySlug":"guide","categoryId":196,"imageUrl":"https://static.techjournal.it/2026/09/2026-mac-mini-blue-768x432.jpeg","imageAlt":"2026-mac-mini-blue","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18050,"date":"2026-09-25T09:28:00+02:00","modified":"2026-09-25T07:28:00+00:00","slug":"apple-beta-pubblica-ios-27-2-ipados-27-2-macos-27-2-app-salute","title":"Apple rilascia la beta pubblica di iOS 27.2, iPadOS 27.2 e macOS 27.2: arriva l’app Salute","excerpt":"Disponibile la prima beta pubblica di iOS 27.2, iPadOS 27.2 e macOS 27.2: la nuova app Salute è tra le novità provabili da subito dai tester.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/ios-27.2-beta-1-pubblica-768x432.jpg","imageAlt":"ios-27.2-beta-1-pubblica","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18046,"date":"2026-09-25T08:44:00+02:00","modified":"2026-09-25T06:44:00+00:00","slug":"apple-intelligence-oltre-30gb-su-alcuni-mac-con-macos-27-golden-gate","title":"Apple Intelligence supera i 30GB su alcuni Mac con macOS 27 Golden Gate","excerpt":"Dopo l’installazione di macOS 27 Golden Gate, Apple Intelligence può scaricare modelli AI multi‑gigabyte sul Mac. In alcuni casi lo spazio occupato supera i 30GB, anche oltre le soglie indicate da Apple.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/apple-intelligence-black-768x432.jpeg","imageAlt":"apple-intelligence-black","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18020,"date":"2026-09-23T12:33:22+02:00","modified":"2026-09-23T10:33:22+00:00","slug":"apple-prime-beta-pubbliche-ios-27-2-m