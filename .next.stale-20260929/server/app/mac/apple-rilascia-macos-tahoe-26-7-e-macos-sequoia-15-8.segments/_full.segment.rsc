3f:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L4e",null,{"posts":[{"id":17162,"date":"2026-08-24T22:35:00+02:00","modified":"2026-08-24T20:35:00+00:00","slug":"apple-seconda-release-candidate-macos-tahoe-26-7-sequoia-15-8","title":"Apple rilascia le seconde Release Candidate di macOS Tahoe 26.7 e macOS Sequoia 15.8","excerpt":"Apple distribuisce agli sviluppatori le seconde Release Candidate di macOS Tahoe 26.7 e macOS Sequoia 15.8, a una settimana dalle prime. In parallelo arriva anche la beta 7 di macOS 27 Golden Gate.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/08/macos-tahoe-768x432.jpg","imageAlt":"macos-tahoe","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":14763,"date":"2026-05-11T08:15:05+02:00","modified":"2026-05-11T06:15:05+00:00","slug":"macos-27-nuove-modifiche-design-organize-tabs","title":"macOS 27: nuove modifiche al design e opzione “Organize Tabs”","excerpt":"Secondo Bloomberg, macOS 27 avrà un leggero redesign rispetto a macOS Tahoe e una funzione AI in Safari per raggruppare automaticamente le schede.","categoryName":"macOS","categorySlug":"macos","categoryId":100,"imageUrl":"https://static.techjournal.it/2026/05/MacBook-Pro-Low-Angle-Wide-Lens-768x432.jpg","imageAlt":"MacBook-Pro-Low-Angle-Wide-Lens","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18087,"date":"2026-09-26T12:02:00+02:00","modified":"2026-09-26T10:02:00+00:00","slug":"macos-golden-gate-cosa-sparisce-e-cosa-cambia-con-macos-28","title":"macOS Golden Gate: cosa sparisce oggi e cosa cambia con macOS 28","excerpt":"Con macOS Golden Gate Apple taglia supporto per Intel, Boot Camp, Rosetta 2 (in modo definitivo) e servizi legacy come AFP, Time Capsule e AirPort Utility. Ulteriori riduzioni sono attese con macOS 28.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18085,"date":"2026-09-26T09:28:00+02:00","modified":"2026-09-26T07:28:00+00:00","slug":"come-controllare-data-di-produzione-mac-macos-27","title":"Come controllare la data di produzione del tuo Mac in macOS 27","excerpt":"Con macOS 27 Golden Gate puoi risalire alla data di produzione del tuo Mac tramite la sezione “Regulatory Certification” nel System Report.","categoryName":"Guide","categorySlug":"guide","categoryId":196,"imageUrl":"https://static.techjournal.it/2026/09/2026-mac-mini-blue-768x432.jpeg","imageAlt":"2026-mac-mini-blue","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18046,"date":"2026-09-25T08:44:00+02:00","modified":"2026-09-25T06:44:00+00:00","slug":"apple-intelligence-oltre-30gb-su-alcuni-mac-con-macos-27-golden-gate","title":"Apple Intelligence supera i 30GB su alcuni Mac con macOS 27 Golden Gate","excerpt":"Dopo l’installazione di macOS 27 Golden Gate, Apple Intelligence può scaricare modelli AI multi‑gigabyte sul Mac. In alcuni casi lo spazio occupato supera i 30GB, anche oltre le soglie indicate da Apple.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/apple-intelligence-black-768x432.jpeg","imageAlt":"apple-intelligence-black","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17958,"date":"2026-09-22T08:00:00+02:00","modified":"2026-09-22T06:00:00+00:00","slug":"apple-seconda-beta-macos-golden-gate-27-2-sviluppatori","title":"Apple rilascia la seconda beta di macOS Golden Gate 27.2 agli sviluppatori","excerpt":"Apple sta testando macOS Golden Gate 27.2 e ha reso disponibile agli sviluppatori la seconda beta, a una settimana dalla prima. Novità attesa: Siri AI in nuove lingue.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17856,"date":"2026-09-18T08:00:00+02:00","modified":"2026-09-18T06:00:00+00:00","slug":"apple-prima-beta-macos-golden-gate-27-2-sviluppatori","title":"Apple rilascia la prima beta di macOS Golden Gate 27.2 agli sviluppatori","excerpt":"Apple avvia la beta di macOS Golden Gate 27.2 per gli sviluppatori. Il test arriva a pochi giorni dal rilascio di macOS Golden Gate 27.0 e riaccende le attese su funzioni di Apple Intelligence e su Suggestions in Messaggi.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17848,"date":"2026-09-17T12:46:00+02:00","modified":"2026-09-17T10:46:00+00:00","slug":"macos-27-interrompe-backup-time-machine-airport-time-capsule","title":"Reminder: macOS 27 interrompe i backup Time Machine su AirPort Time Capsule","excerpt":"Con macOS 27, Time Machine non potrà più eseguire backup su AirPort Time Capsule: viene rimosso il supporto AFP e i backup passano esclusivamente a SMB.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/time-capsule-768x432.jpg","imageAlt":"time-capsule","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null}],"heading":"Articoli correlati"}]}]
