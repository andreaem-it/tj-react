c:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L25",null,{"posts":[{"id":18050,"date":"2026-09-25T09:28:00+02:00","modified":"2026-09-25T07:28:00+00:00","slug":"apple-beta-pubblica-ios-27-2-ipados-27-2-macos-27-2-app-salute","title":"Apple rilascia la beta pubblica di iOS 27.2, iPadOS 27.2 e macOS 27.2: arriva l’app Salute","excerpt":"Disponibile la prima beta pubblica di iOS 27.2, iPadOS 27.2 e macOS 27.2: la nuova app Salute è tra le novità provabili da subito dai tester.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/ios-27.2-beta-1-pubblica-768x432.jpg","imageAlt":"ios-27.2-beta-1-pubblica","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17960,"date":"2026-09-21T22:12:43+02:00","modified":"2026-09-21T20:12:43+00:00","slug":"apple-seconda-beta-ios-27-2","title":"Apple rilascia la seconda beta di iOS 27.2 e aggiorna anche iPadOS","excerpt":"Apple ha distribuito la seconda beta di iOS 27.2 agli sviluppatori, a una settimana dalla prima. Presente anche una beta di iPadOS 27.2, con novità su app Salute e Siri.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/iOS-27.2-Next-to-iPhone-768x432.jpg","imageAlt":"iOS-27.2-Next-to-iPhone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17936,"date":"2026-09-20T09:28:00+02:00","modified":"2026-09-20T07:28:00+00:00","slug":"top-stories-ios-27-macos-golden-gate-siri-ai-waitlist","title":"Top Stories: iOS 27 e macOS Golden Gate disponibili, Siri AI in waitlist e altro","excerpt":"Disponibili iOS 27 e macOS Golden Gate con Siri AI e nuove funzioni. Siri AI richiede una waitlist, iPhone 18 Pro Max negli USA usa un modem diverso e iCloud+ si amplia in oltre 100 paesi.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/top-stories-2026-09-19-768x432.jpg","imageAlt":"top-stories-2026-09-19","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16981,"date":"2026-08-19T08:22:00+02:00","modified":"2026-08-19T06:22:00+00:00","slug":"disponibili-ios-27-macos-golden-gate-beta-6-e-non-solo-ecco-tutte-le-novita","title":"Disponibili iOS 27 e macOS Golden Gate beta 6 (e non solo): ecco tutte le novità","excerpt":"Apple rilascia le beta 6 di iOS 27 e macOS Golden Gate, insieme alle versioni beta 6 di iPadOS 27, watchOS 27 e tvOS 27.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/08/ios-27-three-iphones-fi.jpg-768x384.webp","imageAlt":"ios-27-three-iphones-fi.jpg","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18016,"date":"2026-09-24T09:28:00+02:00","modified":"2026-09-24T07:28:00+00:00","slug":"stili-fotografici-pelle-morbida-texture-anche-su-iphone-precedenti-ios-27","title":"Stili fotografici: “Pelle Morbida” e nuove texture arrivano anche su iPhone precedenti con iOS 27","excerpt":"Con iOS 27 i nuovi controlli per texture e grana degli Stili fotografici, inclusi “Pelle Morbida”, potranno essere usati anche su dispositivi iPhone precedenti.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/ios-27-texture-soft-skin-768x432.jpg","imageAlt":"ios-27-texture-soft-skin","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18009,"date":"2026-09-24T08:22:00+02:00","modified":"2026-09-24T06:22:00+00:00","slug":"apple-limita-texture-e-grain-niente-su-iphone-piu-vecchi","title":"Apple limita Texture e Grain: niente su iPhone più vecchi","excerpt":"I nuovi controlli Texture e Grain per le Photographic Styles in iOS 27 risultano disponibili solo su iPhone 18 Pro e, per iPhone Duo, su specifiche fotocamere. La compatibilità indicata inizialmente per “i modelli che supportano le Photographic Styles” è stata poi ristretta.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/photographic-styles-3402x-768x432.jpg","imageAlt":"photographic-styles-3402x","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18007,"date":"2026-09-23T14:00:00+02:00","modified":"2026-09-23T12:22:28+00:00","slug":"apple-lavora-funzione-anti-rapina-bloccare-iphone-auto-lock","title":"Apple lavora a una funzione anti-rapina per bloccare gli iPhone rubati","excerpt":"Nelle ultime build di iOS 27.2 emergono riferimenti a una funzione interna chiamata “AutoLock” che, in caso di rapina, potrebbe bloccare l’iPhone e attivare la protezione del dispositivo rubato.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/apple-lock-security-bug-vulnerability-fix-privacy-768x432.jpg","imageAlt":"apple-lock-security-bug-vulnerability-fix-privacy","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17994,"date":"2026-09-22T14:17:10+02:00","modified":"2026-09-22T12:17:10+00:00","slug":"apple-licenzia-parte-team-fitness-plus-integrazione-app-salute","title":"Apple licenzia parte del team di Fitness+: possibile integrazione in Salute","excerpt":"Apple avrebbe licenziato parte del team di Fitness+. Il servizio potrebbe essere integrato nell’app Salute, con un possibile cambio di strategia per l’esperienza fitness su iPhone e Apple Watch.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/apple-fitness-768x432.jpg","imageAlt":"apple-fitness","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null}],"heading":"Articoli correlati"}]}]
