c:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L27",null,{"posts":[{"id":18009,"date":"2026-09-24T08:22:00+02:00","modified":"2026-09-24T06:22:00+00:00","slug":"apple-limita-texture-e-grain-niente-su-iphone-piu-vecchi","title":"Apple limita Texture e Grain: niente su iPhone più vecchi","excerpt":"I nuovi controlli Texture e Grain per le Photographic Styles in iOS 27 risultano disponibili solo su iPhone 18 Pro e, per iPhone Duo, su specifiche fotocamere. La compatibilità indicata inizialmente per “i modelli che supportano le Photographic Styles” è stata poi ristretta.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/photographic-styles-3402x-768x432.jpg","imageAlt":"photographic-styles-3402x","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17515,"date":"2026-09-08T08:00:00+02:00","modified":"2026-09-08T06:00:00+00:00","slug":"cinque-nuove-funzioni-camera-iphone-18-pro-ios-27-codice","title":"Cinque nuove funzioni Camera per iPhone 18 Pro: iOS 27 le nasconde nel codice","excerpt":"Nel codice di iOS 27 emergono cinque possibili novità per l’app Fotocamera: waveform/istogramma per l’esposizione, focus peaking e avvisi di highlight, autoscatto ripetuto, messa a fuoco manuale e correzioni basate sull’apertura.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/iphone-17-pro-dark-blue-1-768x432.jpg","imageAlt":"iphone-17-pro-dark-blue-1","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18074,"date":"2026-09-26T09:06:00+02:00","modified":"2026-09-26T07:06:00+00:00","slug":"texture-grana-stili-fotografici-solo-iphone-18-pro-duo-apple-aggiorna-comunicato","title":"Texture e grana degli Stili fotografici solo su iPhone 18 Pro e Duo: Apple aggiorna il comunicato","excerpt":"Apple ha corretto la nota del comunicato stampa italiano di iPhone 18 Pro: i nuovi controlli per texture e grana degli Stili fotografici non arriveranno su iPhone 16, iPhone 17 e iPhone Air, ma risultano riservati a iPhone 18 Pro e Duo.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/texture-pelle-morbida-stile-fotografico-ios-27-iphone-768x432.jpg","imageAlt":"texture-pelle-morbida-stile-fotografico-ios-27-iphone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18050,"date":"2026-09-25T09:28:00+02:00","modified":"2026-09-25T07:28:00+00:00","slug":"apple-beta-pubblica-ios-27-2-ipados-27-2-macos-27-2-app-salute","title":"Apple rilascia la beta pubblica di iOS 27.2, iPadOS 27.2 e macOS 27.2: arriva l’app Salute","excerpt":"Disponibile la prima beta pubblica di iOS 27.2, iPadOS 27.2 e macOS 27.2: la nuova app Salute è tra le novità provabili da subito dai tester.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/ios-27.2-beta-1-pubblica-768x432.jpg","imageAlt":"ios-27.2-beta-1-pubblica","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18007,"date":"2026-09-23T14:00:00+02:00","modified":"2026-09-23T12:22:28+00:00","slug":"apple-lavora-funzione-anti-rapina-bloccare-iphone-auto-lock","title":"Apple lavora a una funzione anti-rapina per bloccare gli iPhone rubati","excerpt":"Nelle ultime build di iOS 27.2 emergono riferimenti a una funzione interna chiamata “AutoLock” che, in caso di rapina, potrebbe bloccare l’iPhone e attivare la protezione del dispositivo rubato.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/apple-lock-security-bug-vulnerability-fix-privacy-768x432.jpg","imageAlt":"apple-lock-security-bug-vulnerability-fix-privacy","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18020,"date":"2026-09-23T12:33:22+02:00","modified":"2026-09-23T10:33:22+00:00","slug":"apple-prime-beta-pubbliche-ios-27-2-macos-golden-gate-27-2","title":"Apple avvia le prime beta pubbliche di iOS 27.2 e macOS Golden Gate 27.2","excerpt":"Apple ha rilasciato le prime beta pubbliche di iOS 27.2, iPadOS 27.2, macOS Golden Gate 27.2, tvOS 27.2 e watchOS 27.2. Novità principali: app Salute ridisegnata e nuove opzioni in Apple TV con Siri AI in più lingue.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/iOS-27.2-Next-to-iPhone-768x432.jpg","imageAlt":"iOS-27.2-Next-to-iPhone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17990,"date":"2026-09-22T11:48:25+02:00","modified":"2026-09-22T09:48:25+00:00","slug":"non-si-puo-piu-fare-downgrade-da-ios-27-a-ios-26","title":"Non si può più fare downgrade da iOS 27 a iOS 26","excerpt":"Apple non sta più firmando iOS 26.6.2: dopo l’aggiornamento a iOS 27 non è più possibile tornare a iOS 26. Inoltre non si può passare a iOS 26.7 perché è un aggiornamento OTA senza file di ripristino.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/iOS-27-Feature-Warm-768x432.jpg","imageAlt":"iOS-27-Feature-Warm","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17967,"date":"2026-09-22T08:22:00+02:00","modified":"2026-09-22T06:22:00+00:00","slug":"alcuni-utenti-iphone-18-pro-segnalano-problemi-con-face-id","title":"Alcuni utenti iPhone 18 Pro segnalano problemi con Face I