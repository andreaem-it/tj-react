3e:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L4b",null,{"posts":[{"id":17856,"date":"2026-09-18T08:00:00+02:00","modified":"2026-09-18T06:00:00+00:00","slug":"apple-prima-beta-macos-golden-gate-27-2-sviluppatori","title":"Apple rilascia la prima beta di macOS Golden Gate 27.2 agli sviluppatori","excerpt":"Apple avvia la beta di macOS Golden Gate 27.2 per gli sviluppatori. Il test arriva a pochi giorni dal rilascio di macOS Golden Gate 27.0 e riaccende le attese su funzioni di Apple Intelligence e su Suggestions in Messaggi.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17956,"date":"2026-09-21T21:50:24+02:00","modified":"2026-09-21T19:50:24+00:00","slug":"iphone-14-pro-vs-iphone-18-pro-guida-alla-upgrade","title":"iPhone 14 Pro vs iPhone 18 Pro: guida all’upgrade","excerpt":"Dopo quattro generazioni, iPhone 18 Pro porta display più grandi, USB‑C, ricarica più rapida, nuove fotocamere, più autonomia e supporto ad Apple Intelligence. Ecco quando conviene davvero passare da iPhone 14 Pro.","categoryName":"Guide","categorySlug":"guide","categoryId":196,"imageUrl":"https://static.techjournal.it/2026/09/iphone-14-pro-vs-iphone-18-pro-768x432.jpg","imageAlt":"iphone-14-pro-vs-iphone-18-pro","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17936,"date":"2026-09-20T09:28:00+02:00","modified":"2026-09-20T07:28:00+00:00","slug":"top-stories-ios-27-macos-golden-gate-siri-ai-waitlist","title":"Top Stories: iOS 27 e macOS Golden Gate disponibili, Siri AI in waitlist e altro","excerpt":"Disponibili iOS 27 e macOS Golden Gate con Siri AI e nuove funzioni. Siri AI richiede una waitlist, iPhone 18 Pro Max negli USA usa un modem diverso e iCloud+ si amplia in oltre 100 paesi.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/top-stories-2026-09-19-768x432.jpg","imageAlt":"top-stories-2026-09-19","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17872,"date":"2026-09-18T08:44:00+02:00","modified":"2026-09-18T06:44:00+00:00","slug":"macos-golden-gate-50-novita-siri-app-interfaccia","title":"macOS Golden Gate: 50 novità tra Siri, app Apple e interfaccia","excerpt":"macOS 27 Golden Gate porta un’esperienza Siri rinnovata, nuove funzioni in Safari, Foto, Mail e Calendario, miglioramenti all’interfaccia e aggiornamenti per AirDrop, i widget e molto altro.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/50-New-macOS-Golden-Gate-Features-and-Changes-Worth-Checking-Out-Feature-768x432.jpg","imageAlt":"50-New-macOS-Golden-Gate-Features-and-Changes-Worth-Checking-Out-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17627,"date":"2026-09-11T12:46:00+02:00","modified":"2026-09-11T10:46:00+00:00","slug":"apple-tv-4k-nuovo-chip-salto-potenza-apple-intelligence","title":"Apple TV 4K: il nuovo chip potrebbe essere un salto di potenza per Apple Intelligence","excerpt":"Le indiscrezioni sulla nuova Apple TV 4K puntano a un chip più moderno e pronto per Apple Intelligence. Ora emergono segnali che suggeriscono un salto di potenza più grande del previsto.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/apple-tv-a19-chip-768x432.jpg","imageAlt":"apple-tv-a19-chip","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17158,"date":"2026-08-25T08:22:00+02:00","modified":"2026-08-25T06:22:00+00:00","slug":"apple-settima-beta-ios-27-ipados-27-sviluppatori","title":"Apple rilascia la settima beta di iOS 27 e iPadOS 27 agli sviluppatori","excerpt":"Apple ha distribuito la settima beta di iOS 27 e iPadOS 27 agli sviluppatori per i test. L’aggiornamento arriva una settimana dopo la sesta beta e introduce Siri AI, nuove funzioni Apple Intelligence e miglioramenti di performance.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/08/iOS-27-Feature-Dark-768x432.jpg","imageAlt":"iOS-27-Feature-Dark","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16947,"date":"2026-08-14T14:33:10+02:00","modified":"2026-08-14T12:33:10+00:00","slug":"apple-addestra-proprio-modello-ai-cina-supporto-alibaba","title":"Apple addestra un proprio modello AI per la Cina con il supporto di Alibaba","excerpt":"Apple avrebbe addestrato un proprio large language model per il mercato cinese, con l’aiuto di Alibaba. L’obiettivo è abilitare le funzioni di Apple Intelligence in Cina con una strategia “dual-track”.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/08/apple-intelligence-black-768x432.jpeg","imageAlt":"apple-intelligence-black","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16745,"date":"2026-08-05T09:06:00+02:00","modified":"2026-08-05T07:06:00+00:00","slug":"apple-chiude-class-action-ritardi-siri-250-milioni","title":"Apple chiude una class action sui ritardi di Siri: 250 milioni di dollari","excerpt":"Il giudice ha firmato l’approvazione preliminare dell’accordo da 250 milioni di dollari per la class action sui ritardi di Siri e Apple Intelligence: ora si apre la fase dei rimborsi.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/08/accordo-siri-250-milioni-featured-768x432.jpg","imageAlt":"accordo-siri-250-milioni-featured","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":6,"review":null,"changelog":[],"tldr":[],"breaking":null}],"heading":"Articoli correlati"}]}]
