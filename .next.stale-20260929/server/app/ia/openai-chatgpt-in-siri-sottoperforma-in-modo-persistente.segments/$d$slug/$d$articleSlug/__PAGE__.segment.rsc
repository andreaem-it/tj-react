c:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L24",null,{"posts":[{"id":17788,"date":"2026-09-15T12:02:00+02:00","modified":"2026-09-15T10:02:00+00:00","slug":"musk-ritira-causa-apple-siri-chatgpt-continua-causa-openai","title":"Musk ritira la causa contro Apple per il deal Siri-ChatGPT, ma continua a fare causa a OpenAI","excerpt":"Elon Musk ritira la causa legale contro Apple legata a un accordo che coinvolge Siri e ChatGPT, ma prosegue l’azione legale contro OpenAI.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/X-twitter-logo-768x432.jpg","imageAlt":"X-twitter-logo","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17773,"date":"2026-09-14T19:31:11+02:00","modified":"2026-09-14T17:31:11+00:00","slug":"siri-puo-passare-ad-altri-ai-claude-chatgpt","title":"Siri può passare ad altri AI: Claude e ChatGPT tra le opzioni mostrate","excerpt":"Nuovi dettagli mostrano la possibilità di sostituire l’AI di Siri con modelli alternativi come Claude e ChatGPT, aprendo scenari su personalizzazione e integrazioni.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/macOS-iOS-27-Siri-App-Feature-768x432.jpg","imageAlt":"macOS-iOS-27-Siri-App-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18101,"date":"2026-09-28T16:20:17+02:00","modified":"2026-09-28T14:20:17+00:00","slug":"watchos-27-12-novita-da-provare-su-apple-watch","title":"watchOS 27: 12 novità da provare su Apple Watch","excerpt":"watchOS 27 è disponibile dal 14 settembre. Ecco 12 cambiamenti e funzioni da scoprire, tra Siri dedicato, Smart Stack più intelligente, nuove gesture e aggiornamenti per salute e allenamenti.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/watchOS-27-Hands-On-Thumb-768x432.jpg","imageAlt":"watchOS-27-Hands-On-Thumb","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18052,"date":"2026-09-25T12:02:00+02:00","modified":"2026-09-25T10:02:00+00:00","slug":"siri-ai-arrivo-su-homepod-cosa-cambia-per-l-assistente-in-casa","title":"Siri AI in arrivo su HomePod: cosa cambia per l’assistente in casa","excerpt":"L’arrivo di Siri AI su HomePod punta a rendere l’assistente più capace e reattivo nelle attività quotidiane in casa, rafforzando l’esperienza di interazione vocale.","categoryName":"Smart Home","categorySlug":"smart-home","categoryId":11,"imageUrl":"https://static.techjournal.it/2026/09/Siri-AI-768x430.jpg","imageAlt":"Siri-AI","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17958,"date":"2026-09-22T08:00:00+02:00","modified":"2026-09-22T06:00:00+00:00","slug":"apple-seconda-beta-macos-golden-gate-27-2-sviluppatori","title":"Apple rilascia la seconda beta di macOS Golden Gate 27.2 agli sviluppatori","excerpt":"Apple sta testando macOS Golden Gate 27.2 e ha reso disponibile agli sviluppatori la seconda beta, a una settimana dalla prima. Novità attesa: Siri AI in nuove lingue.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17951,"date":"2026-09-21T12:47:18+02:00","modified":"2026-09-21T10:47:18+00:00",