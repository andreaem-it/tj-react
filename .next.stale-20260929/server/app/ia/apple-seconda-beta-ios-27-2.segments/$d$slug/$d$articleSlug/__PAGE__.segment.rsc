c:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L26",null,{"posts":[{"id":18050,"date":"2026-09-25T09:28:00+02:00","modified":"2026-09-25T07:28:00+00:00","slug":"apple-beta-pubblica-ios-27-2-ipados-27-2-macos-27-2-app-salute","title":"Apple rilascia la beta pubblica di iOS 27.2, iPadOS 27.2 e macOS 27.2: arriva l’app Salute","excerpt":"Disponibile la prima beta pubblica di iOS 27.2, iPadOS 27.2 e macOS 27.2: la nuova app Salute è tra le novità provabili da subito dai tester.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/ios-27.2-beta-1-pubblica-768x432.jpg","imageAlt":"ios-27.2-beta-1-pubblica","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18020,"date":"2026-09-23T12:33:22+02:00","modified":"2026-09-23T10:33:22+00:00","slug":"apple-prime-beta-pubbliche-ios-27-2-macos-golden-gate-27-2","title":"Apple avvia le prime beta pubbliche di iOS 27.2 e macOS Golden Gate 27.2","excerpt":"Apple ha rilasciato le prime beta pubbliche di iOS 27.2, iPadOS 27.2, macOS Golden Gate 27.2, tvOS 27.2 e watchOS 27.2. Novità principali: app Salute ridisegnata e nuove opzioni in Apple TV con Siri AI in più lingue.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/iOS-27.2-Next-to-iPhone-768x432.jpg","imageAlt":"iOS-27.2-Next-to-iPhone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17936,"date":"2026-09-20T09:28:00+02:00","modified":"2026-09-20T07:28:00+00:00","slug":"top-stories-ios-27-macos-golden-gate-siri-ai-waitlist","title":"Top Stories: iOS 27 e macOS Golden Gate disponibili, Siri AI in waitlist e altro","excerpt":"Disponibili iOS 27 e macOS Golden Gate con Siri AI e nuove funzioni. Siri AI richiede una waitlist, iPhone 18 Pro Max negli USA usa un modem diverso e iCloud+ si amplia in oltre 100 paesi.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/top-stories-2026-09-19-768x432.jpg","imageAlt":"top-stories-2026-09-19","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17829,"date":"2026-09-17T09:28:00+02:00","modified":"2026-09-17T07:28:00+00:00","slug":"ios-27-siri-ai-lista-attesa-come-attivarla","title":"iOS 27 e Siri AI: lista d’attesa e come attivarla su iPhone","excerpt":"Dopo l’aggiornamento a iOS 27, Siri AI e l’app dedicata non sono immediatamente disponibili per tutti: serve iscriversi alla lista d’attesa. Ecco i passaggi e i requisiti dei modelli compatibili.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/macOS-iOS-27-Siri-App-Feature-768x432.jpg","imageAlt":"macOS-iOS-27-Siri-App-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17756,"date":"2026-09-15T08:00:00+02:00","modified":"2026-09-15T06:00:00+00:00","slug":"ios-27-arrivo-8-novita-siri-ai","title":"iOS 27 in arrivo: 8 novità, con Siri AI al centro","excerpt":"iOS 27 sarà disponibile lunedì 14 settembre: tra le novità spicca un Siri completamente ripensato (Siri AI), insieme a miglioramenti di performance, nuove funzioni per Foto, CarPlay e Find My.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/iOS-27-Icon-iPhone-768x432.jpeg","imageAlt":"iOS-27-Icon-iPhone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17655,"date":"2026-09-11T16:04:00+02:00","modified":"2026-09-11T14:04:00+00:00","s