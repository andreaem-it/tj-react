c:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L25",null,{"posts":[{"id":18046,"date":"2026-09-25T08:44:00+02:00","modified":"2026-09-25T06:44:00+00:00","slug":"apple-intelligence-oltre-30gb-su-alcuni-mac-con-macos-27-golden-gate","title":"Apple Intelligence supera i 30GB su alcuni Mac con macOS 27 Golden Gate","excerpt":"Dopo l’installazione di macOS 27 Golden Gate, Apple Intelligence può scaricare modelli AI multi‑gigabyte sul Mac. In alcuni casi lo spazio occupato supera i 30GB, anche oltre le soglie indicate da Apple.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/apple-intelligence-black-768x432.jpeg","imageAlt":"apple-intelligence-black","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18030,"date":"2026-09-24T12:02:00+02:00","modified":"2026-09-24T10:02:00+00:00","slug":"apple-mette-in-pausa-progetto-ciondolo-ai-fotocamera","title":"Apple mette in pausa il progetto del ciondolo AI con fotocamera","excerpt":"Apple avrebbe sospeso, almeno temporaneamente, lo sviluppo del ciondolo AI con fotocamera, un dispositivo indossabile pensato per funzioni basate sull’intelligenza artificiale.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/apple-ai-pin-768x432.jpg","imageAlt":"apple-ai-pin","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17951,"date":"2026-09-21T12:47:18+02:00","modified":"2026-09-21T10:47:18+00:00","slug":"sito-settlement-siri-ai-ora-online-apple-paghera-alcuni-proprietari-iphone","title":"Sito per il settlement Siri AI ora online: Apple pagherà alcuni proprietari di iPhone","excerpt":"È online il sito dedicato al settlement legato a Siri AI: Apple prevede pagamenti ad alcuni proprietari di iPhone. Ecco cosa significa per gli utenti.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/iOS-18-Siri-Personal-Context-768x432.jpg","imageAlt":"iOS-18-Siri-Personal-Context","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17936,"date":"2026-09-20T09:28:00+02:00","modified":"2026-09-20T07:28:00+00:00","slug":"top-stories-ios-27-macos-golden-gate-siri-ai-waitlist","title":"Top Stories: iOS 27 e macOS Golden Gate disponibili, Siri AI in waitlist e altro","excerpt":"Disponibili iOS 27 e macOS Golden Gate con Siri AI e nuove funzioni. Siri AI richiede una waitlist, iPhone 18 Pro Max negli USA usa un modem diverso e iCloud+ si amplia in oltre 100 paesi.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/top-stories-2026-09-19-768x432.jpg","imageAlt":"top-stories-2026-09-19","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17850,"date":"2026-09-17T13:08:00+02:00","modified":"2026-09-17T11:08:00+00:00","slug":"kids-act-ue-stop-social-under-13-chatbot-ai","title":"Kids Act UE: stop ai social per under 13 e limiti per chatbot AI","excerpt":"L’UE prepara il Kids Act: divieto di social media per i minori di 13 anni senza supervisione, regole più stringenti tra 13 e 15 e obblighi di tutela anche per gaming e chatbot AI.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/european-commission-768x432.jpg","imageAlt":"european-commission","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17831,"date":"2026-09-17T12:02:00+02:00","modified":"2026-09-17T10:02:00+00:00","slug":"primo-benchmark-chip-m5-ultra-boost-prestazionale","title":"Primo benchmark per il chip M5 Ultra: boost prestazionale in evidenza","excerpt":"Il primo risultato di benchmark relativo al chip M5 Ultra mostra un incremento delle prestazioni, offrendo un primo assaggio della nuova generazione di silicio orientata all’AI.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/M5-Ultra-Hero-768x432.jpeg","imageAlt":"M5-Ultra-Hero","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17844,"date":"2026-09-17T12:02:00+02:00","modified":"2026-09-17T10:02:00+00:00","slug":"fornitore-memoria-apple-valuta-produzione-usa-con-intel","title":"Fornitore di memoria di Apple valuta produzione negli Stati Uniti con Intel","excerpt":"SK Hynix, fornitore di memoria per Apple, sarebbe in colloqui esplorativi con Intel per produrre chip di memoria negli Stati Uniti. Ipotesi: leasing di parte dell’impianto in Ohio o joint venture con cloud provider.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/sk-hynix-intel-768x432.png","imageAlt":"sk-hynix-intel","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18052,"date":"2026-09-25T12:02:00+02:00","modified":"2026-09-25T10:02:00+00:00","slug":"siri-ai-arrivo-su-homepod-cosa-cambia-per-l-assistente-in-casa","title":"Siri AI in arrivo su HomePod: cosa cambia per l’assistente in casa","excerpt":"L’arrivo di Siri AI su HomePod punta a rendere l’assistente più capace e reattivo nelle attività quotidiane in casa, rafforzando l’esperienza di interazione vocale.","categoryName":"Smart Home","categorySlug":"smart-home","categoryId":11,"imageUrl":"https://static.techjournal.it/