c:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L26",null,{"posts":[{"id":18020,"date":"2026-09-23T12:33:22+02:00","modified":"2026-09-23T10:33:22+00:00","slug":"apple-prime-beta-pubbliche-ios-27-2-macos-golden-gate-27-2","title":"Apple avvia le prime beta pubbliche di iOS 27.2 e macOS Golden Gate 27.2","excerpt":"Apple ha rilasciato le prime beta pubbliche di iOS 27.2, iPadOS 27.2, macOS Golden Gate 27.2, tvOS 27.2 e watchOS 27.2. Novità principali: app Salute ridisegnata e nuove opzioni in Apple TV con Siri AI in più lingue.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/iOS-27.2-Next-to-iPhone-768x432.jpg","imageAlt":"iOS-27.2-Next-to-iPhone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17958,"date":"2026-09-22T08:00:00+02:00","modified":"2026-09-22T06:00:00+00:00","slug":"apple-seconda-beta-macos-golden-gate-27-2-sviluppatori","title":"Apple rilascia la seconda beta di macOS Golden Gate 27.2 agli sviluppatori","excerpt":"Apple sta testando macOS Golden Gate 27.2 e ha reso disponibile agli sviluppatori la seconda beta, a una settimana dalla prima. Novità attesa: Siri AI in nuove lingue.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17872,"date":"2026-09-18T08:44:00+02:00","modified":"2026-09-18T06:44:00+00:00","slug":"macos-golden-gate-50-novita-siri-app-interfaccia","title":"macOS Golden Gate: 50 novità tra Siri, app Apple e interfaccia","excerpt":"macOS 27 Golden Gate porta un’esperienza Siri rinnovata, nuove funzioni in Safari, Foto, Mail e Calendario, miglioramenti all’interfaccia e aggiornamenti per AirDrop, i widget e molto altro.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/50-New-macOS-Golden-Gate-Features-and-Changes-Worth-Checking-Out-Feature-768x432.jpg","imageAlt":"50-New-macOS-Golden-Gate-Features-and-Changes-Worth-Checking-Out-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17829,"date":"2026-09-17T09:28:00+02:00","modified":"2026-09-17T07:28:00+00:00","slug":"ios-27-siri-ai-lista-attesa-come-attivarla","title":"iOS 27 e Siri AI: lista d’attesa e come attivarla su iPhone","excerpt":"Dopo l’aggiornamento a iOS 27, Siri AI e l’app dedicata non sono immediatamente disponibili per tutti: serve iscriversi alla lista d’attesa. Ecco i passaggi e i requisiti dei modelli compatibili.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/macOS-iOS-27-Siri-App-Feature-768x432.jpg","imageAlt":"macOS-iOS-27-Siri-App-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17784,"date":"2026-09-16T08:00:00+02:00","modified":"2026-09-16T06:00:00+00:00","slug":"macos-golden-gate-10-funzioni-da-provare-subito","title":"macOS Golden Gate: 10 funzioni da provare subito","excerpt":"Da Siri AI a Visual Intelligence, fino a Liquid Glass e miglioramenti di performance: ecco le 10 novità di macOS Golden Gate da testare appena installato.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/10-macOS-Features-to-Try-First-Feature-768x432.jpg","imageAlt":"10-macOS-Features-to-Try-First-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17756,"date":"2026-09-15T08:00:00+02:00","modified":"2026-09-15T06:00:00+00:00","slug":"ios-27-arrivo-8-novita-siri-ai","title":"iOS 27 in arrivo: 8 novità, con Siri AI al centro","excerpt":"iOS 27 sarà disponibile lunedì 14 settembre: tra le novità spicca un Siri completamente ripensato (Siri AI), insieme a miglioramenti di performance, nuove funzioni per Foto, CarPlay e Find My.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/iOS-27-Icon-iPhone-768x432.jpeg","imageAlt":"iOS-27-Icon-iPhone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17655,"date":"2026-09-11T16:04:00+02:00","modified":"2026-09-11T14:04:00+00:00","slug":"siri-ai-arriva-solo-in-inglese-limiti-giornalieri-cinque-lingue-ottobre-ma-non-italiano","title":"Siri AI arriva solo in inglese e con limiti giornalieri: a ottobre cinque lingue in più, ma non l’italiano","excerpt":"Siri AI, la funzione attesa di iOS 27, parte solo in inglese e sarà soggetta a limiti d’uso giornalieri. Ad ottobre arrivano cinque nuove lingue, ma l’italiano resta escluso.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/siri-ai-lingue-limiti-uso-pagamento-1-768x432.jpg","imageAlt":"siri-ai-lingue-limiti-uso-pagamento-1","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17351,"date":"2026-09-01T12:46:00+02:00","modified":"2026-09-01T10:46:00+00:00","slug":"apple-rilascia-beta-8-macos-golden-gate","title":"Apple rilascia la beta 8 di macOS Golden Gate per sviluppatori","excerpt":"Apple ha distribuito la beta 8 di macOS Golden Gate agli sviluppatori. Aggiornamento via Software Update, con nuove funzioni per Siri AI, miglioramenti di interfaccia e strumenti di editing foto basati sull’AI.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":4,"review":null,"changelog":[],"tldr":[],"breaking":null}],"heading":"Articoli correlati"}]}]
