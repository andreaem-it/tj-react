3e:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L4a",null,{"posts":[{"id":17936,"date":"2026-09-20T09:28:00+02:00","modified":"2026-09-20T07:28:00+00:00","slug":"top-stories-ios-27-macos-golden-gate-siri-ai-waitlist","title":"Top Stories: iOS 27 e macOS Golden Gate disponibili, Siri AI in waitlist e altro","excerpt":"Disponibili iOS 27 e macOS Golden Gate con Siri AI e nuove funzioni. Siri AI richiede una waitlist, iPhone 18 Pro Max negli USA usa un modem diverso e iCloud+ si amplia in oltre 100 paesi.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/top-stories-2026-09-19-768x432.jpg","imageAlt":"top-stories-2026-09-19","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17756,"date":"2026-09-15T08:00:00+02:00","modified":"2026-09-15T06:00:00+00:00","slug":"ios-27-arrivo-8-novita-siri-ai","title":"iOS 27 in arrivo: 8 novità, con Siri AI al centro","excerpt":"iOS 27 sarà disponibile lunedì 14 settembre: tra le novità spicca un Siri completamente ripensato (Siri AI), insieme a miglioramenti di performance, nuove funzioni per Foto, CarPlay e Find My.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/iOS-27-Icon-iPhone-768x432.jpeg","imageAlt":"iOS-27-Icon-iPhone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17655,"date":"2026-09-11T16:04:00+02:00","modified":"2026-09-11T14:04:00+00:00","slug":"siri-ai-arriva-solo-in-inglese-limiti-giornalieri-cinque-lingue-ottobre-ma-non-italiano","title":"Siri AI arriva solo in inglese e con limiti giornalieri: a ottobre cinque lingue in più, ma non l’italiano","excerpt":"Siri AI, la funzione attesa di iOS 27, parte solo in inglese e sarà soggetta a limiti d’uso giornalieri. Ad ottobre arrivano cinque nuove lingue, ma l’italiano resta escluso.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/siri-ai-lingue-limiti-uso-pagamento-1-768x432.jpg","imageAlt":"siri-ai-lingue-limiti-uso-pagamento-1","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16958,"date":"2026-08-16T08:00:00+02:00","modified":"2026-08-16T06:00:00+00:00","slug":"ios-27-30-nuove-funzioni-iphone-siri-contestuale-foto","title":"iOS 27: 30 nuove funzioni per iPhone, tra Siri contestuale e foto potenziate","excerpt":"iOS 27 arriverà a settembre: ecco le principali novità per iPhone, tra Siri più contestuale, organizzazione intelligente di Safari, funzioni avanzate in Foto e nuove opzioni in Wallet, Maps e Accessibilità.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/08/Everything-New-Your-iPhone-Can-Do-on-iOS-27-Feature-1-768x432.jpg","imageAlt":"Everything-New-Your-iPhone-Can-Do-on-iOS-27-Feature-1","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16848,"date":"2026-08-11T08:00:00+02:00","modified":"2026-08-11T06:00:00+00:00","slug":"ios-27-beta-5-nuovi-icon-siri-safari-impostazioni","title":"iOS 27 Beta 5: nuovi icon per Siri, Safari, Impostazioni e altre app","excerpt":"Nella quinta beta di iOS 27 arrivano aggiornamenti alle icone in stile Liquid Glass per Safari, Siri, Impostazioni, App Store, Remote e Preview, con modifiche anche alla trasparenza e ai dettagli grafici.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/08/ios-27-b5-icons-768x432.jpg","imageAlt":"ios-27-b5-icons","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18052,"date":"2026-09-25T12:02:00+02:00","modified":"2026-09-25T10:02:00+00:00","slug":"siri-ai-arrivo-su-homepod-cosa-cambia-per-l-assistente-in-casa","title":"Siri AI in arrivo su HomePod: cosa cambia per l’assistente in casa","excerpt":"L’arrivo di Siri AI su HomePod punta a rendere l’assistente più capace e reattivo nelle attività quotidiane in casa, rafforzando l’esperienza di interazione vocale.","categoryName":"Smart Home","categorySlug":"smart-home","categoryId":11,"imageUrl":"https://static.techjournal.it/2026/09/Siri-AI-768x430.jpg","imageAlt":"Siri-AI","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18060,"date":"2026-09-25T12:02:00+02:00","modified":"2026-09-25T10:02:00+00:00","slug":"openai-chatgpt-in-siri-sottoperforma-in-modo-persistente","title":"OpenAI: ChatGPT in Siri “sottoperforma in modo persistente”","excerpt":"OpenAI valuta negativamente le prestazioni di ChatGPT integrato in Siri, definendole “persistently underperforming”. Un giudizio che riaccende l’attenzione sul livello di qualità dell’esperienza utente.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/chatgpt-logo-768x432.jpg","imageAlt":"chatgpt-logo","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18050,"date":"2026-09-25T09:28:00+02:00","modified":"2026-09-25T07:28:00+00:00","slug":"apple-beta-pubblica-ios-27-2-ipados-27-2-macos-27-2-app-salute","title":"Apple rilascia la beta pubblica di iOS 27.2, iPadOS 27.2 e macOS 27.2: arriva l’app Salute","excerpt":"Disponibile la prima beta pubblica di iOS 27.2, iPadOS 27.2 e macOS 27.2: la nuova app Salute è tra le novità provabili da subito dai tester.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/ios-27.2-beta-1-pubblica-768x432.jpg","imageAlt":"ios-27.2-beta-1-pubblica","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null}],"heading":"Articoli correlati"}]}]
