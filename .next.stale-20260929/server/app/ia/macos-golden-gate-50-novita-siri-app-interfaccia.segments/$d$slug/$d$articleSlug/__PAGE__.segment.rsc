c:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L27",null,{"posts":[{"id":17958,"date":"2026-09-22T08:00:00+02:00","modified":"2026-09-22T06:00:00+00:00","slug":"apple-seconda-beta-macos-golden-gate-27-2-sviluppatori","title":"Apple rilascia la seconda beta di macOS Golden Gate 27.2 agli sviluppatori","excerpt":"Apple sta testando macOS Golden Gate 27.2 e ha reso disponibile agli sviluppatori la seconda beta, a una settimana dalla prima. Novità attesa: Siri AI in nuove lingue.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17936,"date":"2026-09-20T09:28:00+02:00","modified":"2026-09-20T07:28:00+00:00","slug":"top-stories-ios-27-macos-golden-gate-siri-ai-waitlist","title":"Top Stories: iOS 27 e macOS Golden Gate disponibili, Siri AI in waitlist e altro","excerpt":"Disponibili iOS 27 e macOS Golden Gate con Siri AI e nuove funzioni. Siri AI richiede una waitlist, iPhone 18 Pro Max negli USA usa un modem diverso e iCloud+ si amplia in oltre 100 paesi.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/top-stories-2026-09-19-768x432.jpg","imageAlt":"top-stories-2026-09-19","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17784,"date":"2026-09-16T08:00:00+02:00","modified":"2026-09-16T06:00:00+00:00","slug":"macos-golden-gate-10-funzioni-da-provare-subito","title":"macOS Golden Gate: 10 funzioni da provare subito","excerpt":"Da Siri AI a Visual Intelligence, fino a Liquid Glass e miglioramenti di performance: ecco le 10 novità di macOS Golden Gate da testare appena installato.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/10-macOS-Features-to-Try-First-Feature-768x432.jpg","imageAlt":"10-macOS-Features-to-Try-First-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17351,"date":"2026-09-01T12:46:00+02:00","modified":"2026-09-01T10:46:00+00:00","slug":"apple-rilascia-beta-8-macos-golden-gate","title":"Apple rilascia la beta 8 di macOS Golden Gate per sviluppatori","excerpt":"Apple ha distribuito la beta 8 di macOS Golden Gate agli sviluppatori. Aggiornamento via Software Update, con nuove funzioni per Siri AI, miglioramenti di interfaccia e strumenti di editing foto basati sull’AI.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":4,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17154,"date":"2026-08-25T08:00:00+02:00","modified":"2026-08-25T06:00:00+00:00","slug":"apple-rilascia-beta-7-macos-golden-gate-siri-ai-nuove-funzioni-ui","title":"Apple rilascia la beta 7 di macOS Golden Gate: Siri AI, nuove funzioni e ritocchi UI","excerpt":"Apple mette a disposizione degli sviluppatori la settima beta di macOS Golden Gate. Tra le novità: Siri AI in stile chatbot, miglioramenti di interfaccia e strumenti AI in Foto, Safari, Password e Image Playground.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/08/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18101,"date":"2026-09-28T16:20:17+02:00","modified":"2026-09-28T14:20:17+00:00","slug":"watchos-27-12-novita-da-provare-su-apple-watch","title":"watchOS 27: 12 novità da provare su Apple Watch","excerpt":"watchOS 27 è disponibile dal 14 settembre. Ecco 12 cambiamenti e funzioni da scoprire, tra Siri dedicato, Smart Stack più intelligente, nuove gesture e aggiornamenti per salute e allenamenti.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/watchOS-27-Hands-On-Thumb-768x432.jpg","imageAlt":"watchOS-27-Hands-On-Thumb","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18060,"date":"2026-09-25T12:02:00+02:00","modified":"2026-09-25T10:02:00+00:00","slug":"openai-chatgpt-in-siri-sottoperforma-in-modo-persistente","title":"OpenAI: ChatGPT in Siri “sottoperforma in modo persistente”","excerpt":"OpenAI valuta negativamente le prestazioni di ChatGPT integrato in Siri, definendole “persistently underperforming”. Un giudizio che riaccende l’attenzione sul livello di qualità dell’esperienza utente.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/chatgpt-logo-768x432.jpg","imageAlt":"chatgpt-logo","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18052,"date":"2026-09-25T12:02:00+02:00","modified":"2026-09-25T10:02:00+00:00","slug":"siri-ai-arrivo-su-homepod-cosa-cambia-per-l-assistente-in-casa","title":"Siri AI in arrivo su HomePod: cosa cambia per l’assistente in casa","excerpt":"L’arrivo di Siri AI su HomePod punta a rendere l’assistente più capace e reattivo nelle attività quotidiane in casa, rafforzando l’esperienza di interazione vocale.","categoryName":"Smart Home","categorySlug":"smart-home","categoryId":11,"imageUrl":"https://static.techjournal.it/2026/09/Siri-AI-768x430.jpg","imageAlt":"Siri-AI","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null}],"heading":"Articoli correlati"}]}]
