3:["$","div",null,{"className":"flex flex-col lg:flex-row gap-8","children":[["$","div",null,{"className":"flex-1 min-w-0","children":["$","$Lf",null,{"initialPosts":[{"id":17848,"date":"2026-09-17T12:46:00+02:00","modified":"2026-09-17T10:46:00+00:00","slug":"macos-27-interrompe-backup-time-machine-airport-time-capsule","title":"Reminder: macOS 27 interrompe i backup Time Machine su AirPort Time Capsule","excerpt":"Con macOS 27, Time Machine non potrà più eseguire backup su AirPort Time Capsule: viene rimosso il supporto AFP e i backup passano esclusivamente a SMB.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/time-capsule-768x432.jpg","imageAlt":"time-capsule","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17798,"date":"2026-09-16T09:06:00+02:00","modified":"2026-09-16T07:06:00+00:00","slug":"apple-rilascia-macos-tahoe-26-7-e-macos-sequoia-15-8","title":"Apple rilascia macOS Tahoe 26.7 e macOS Sequoia 15.8","excerpt":"Apple ha pubblicato macOS Tahoe 26.7 e macOS Sequoia 15.8. Gli aggiornamenti includono correzioni di sicurezza e si scaricano da Impostazioni di Sistema > Aggiornamento software.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/macos-tahoe-768x432.jpg","imageAlt":"macos-tahoe","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17786,"date":"2026-09-16T08:22:00+02:00","modified":"2026-09-16T06:22:00+00:00","slug":"macbook-pro-oled-touch-macos-27-1","title":"MacBook Pro con schermo OLED touch e macOS 27.1: cosa sappiamo","excerpt":"Un nuovo MacBook Pro con display OLED touch e l’arrivo di macOS 27.1 sono al centro delle indiscrezioni: ecco i punti chiave su ciò che è stato indicato.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/Apple-MacBook-Pro-M4-hero-768x432.jpg","imageAlt":"Apple-MacBook-Pro-M4-hero","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17784,"date":"2026-09-16T08:00:00+02:00","modified":"2026-09-16T06:00:00+00:00","slug":"macos-golden-gate-10-funzioni-da-provare-subito","title":"macOS Golden Gate: 10 funzioni da provare subito","excerpt":"Da Siri AI a Visual Intelligence, fino a Liquid Glass e miglioramenti di performance: ecco le 10 novità di macOS Golden Gate da testare appena installato.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/10-macOS-Features-to-Try-First-Feature-768x432.jpg","imageAlt":"10-macOS-Features-to-Try-First-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17754,"date":"2026-09-14T08:22:00+02:00","modified":"2026-09-14T06:22:00+00:00","slug":"animazione-apertura-iphone-duo-arriva-su-macbook-mac-duo","title":"L’animazione di apertura di iPhone Duo arriva sul MacBook: Mac Duo è gratis, open source e ha sei effetti","excerpt":"L’animazione di sfocatura prospettica di iPhone Duo, che segnala il passaggio tra display all’apertura o alla chiusura, arriva su MacBook con Mac Duo: progetto gratuito, open source e con sei effetti.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/mac-duo-effetto-apertura-768x432.jpg","imageAlt":"mac-duo-effetto-apertura","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17490,"date":"2026-09-06T08:44:00+02:00","modified":"2026-09-06T06:44:00+00:00","slug":"macos-26-7-code-hints-due-nuovi-controller-apple","title":"macOS 26.7: i “code hints” suggeriscono due nuovi controller Apple in arrivo","excerpt":"Nel codice di macOS 26.7 emergono indizi che puntano allo sviluppo di due controller per videogiochi Apple non ancora annunciati.","categoryName":"Games","categorySlug":"games","categoryId":7,"imageUrl":"https://static.techjournal.it/2026/09/apple-game-controller-graphic.jpg-768x432.png","imageAlt":"apple-game-controller-graphic.jpg","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17384,"date":"2026-09-02T12:24:00+02:00","modified":"2026-09-02T10:24:00+00:00","slug":"macos-golden-gate-suggerisce-macbook-pro-con-display-oled","title":"macOS Golden Gate suggerisce MacBook Pro con display OLED","excerpt":"Nella beta di macOS Golden Gate emergono miglioramenti “Liquid Glass” che risultano ancora più definiti su alcuni display OLED di fascia alta con supporto HDR. Un indizio verso futuri MacBook Pro con pannelli OLED.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/macOS-Golden-Gate-HDR-768x432.jpg","imageAlt":"macOS-Golden-Gate-HDR","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17376,"date":"2026-09-02T09:06:00+02:00","modified":"2026-09-02T07:06:00+00:00","slug":"mac-app-store-app-universali-abbandonare-mac-intel","title":"Mac App Store: le app universali possono ora abbandonare i Mac Intel","excerpt":"Apple consente agli sviluppatori di rimuovere il supporto per i Mac Intel per le app universali del Mac App Store che richiedono macOS 13 o successivo. Gli utenti Intel continueranno a usare l’ultima versione compatibile.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/intel-macs-no-more-updates-768x432.jpg","imageAlt":"intel-macs-no-more-updates","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17351,"date":"2026-09-01T12:46:00+02:00","modified":"2026-09-01T10:46:00+00:00","slug":"apple-rilascia-beta-8-macos-golden-gate","title":"Apple rilascia la beta 8 di macOS Golden Gate per sviluppatori","excerpt":"Apple ha distribuito la beta 8 di macOS Golden Gate agli sviluppatori. Aggiornamento via Software Update, con nuove funzioni per Siri AI, miglioramenti di interfaccia e strumenti di editing foto basati sull’AI.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":4,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17291,"date":"2026-08-29T12:46:00+02:00","modified":"2026-08-29T10:46:00+00:00","slug":"afterglow-screen-saver-after-dark-su-macos","title":"Afterglow porta i classici screen saver “After Dark” su macOS","excerpt":"È disponibile Afterglow, un’app che permette di eseguire i moduli originali di After Dark su macOS moderni, senza dipendenze da ROM o da classic Mac OS.","categoryName":"Applicazioni","categorySlug":"applicazioni","categoryId":13,"imageUrl":"https://static.techjournal.it/2026/08/Afterglow-768x432.jpg","imageAlt":"Afterglow","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17265,"date":"2026-08-29T08:44:00+02:00","modified":"2026-08-29T06:44:00+00:00","slug":"nuovi-mac-mini-mac-studio-con-macos-golden-gate","title":"Nuovi Mac mini e Mac Studio in arrivo con macOS Golden Gate","excerpt":"I nuovi Mac mini e Mac Studio annunciati da Apple sarebbero predisposti per arrivare con macOS Golden Gate, grazie a riferimenti alle funzioni di Siri AI nelle pagine prodotto e alle tempistiche di rilascio.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/08/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17240,"date":"2026-08-28T12:02:00+02:00","modified":"2026-08-28T10:02:00+00:00","slug":"apple-spiega-perche-spotlight-indicizzazione-giorni-dopo-aggiornamento","title":"Apple spiega perché l’indicizzazione di Spotlight può richiedere giorni dopo un aggiornamento","excerpt":"Dopo un aggiornamento, Spotlight può impiegare giorni per completare l’indicizzazione. Apple chiarisce le ragioni del rallentamento e cosa aspettarsi durante la fase iniziale.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/08/iOS-27-Feature-Cool-768x432.jpg","imageAlt":"iOS-27-Feature-Cool","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null}],"initialConsumedPosts":["$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:0:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:1:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:2:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:3:props:children:props:post","$3:props:children:0:props:children:props:initialPosts:0","$3:props:children:0:props:children:props:initialPosts:1","$3:props:children:0:props:children:props:initialPosts:2","$3:props:children:0:props:children:props:initialPosts:3","$3:props:children:0:props:children:props:initialPosts:4","$3:props:children:0:props:children:props:initialPosts:5","$3:props:children:0:props:children:props:initialPosts:6","$3:props:children:0:props:children:props:initialPosts:7","$3:props:children:0:props:children:props:initialPosts:8","$3:props:children:0:props:children:props:initialPosts:9