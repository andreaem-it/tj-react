0:{"buildId":"9TlFmGfeM2r8bkklJXHxo","data":[{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"w-full min-w-0 max-w-7xl mx-auto px-[5px] md:px-4 py-6","children":[["$","h1",null,{"className":"sr-only","children":"macOS: ultime notizie e articoli"}],"$undefined",["$","section",null,{"className":"w-full mb-6 md:mb-8","children":["$","div",null,{"className":"grid grid-cols-1 lg:grid-cols-12 lg:grid-rows-2 gap-2 md:gap-3","children":[["$","div",null,{"className":"relative lg:col-start-1 lg:col-span-6 lg:row-span-2 min-h-[240px] sm:min-h-[280px] lg:min-h-[320px]","children":["$","$L2",null,{"post":{"id":18087,"date":"2026-09-26T12:02:00+02:00","modified":"2026-09-26T10:02:00+00:00","slug":"macos-golden-gate-cosa-sparisce-e-cosa-cambia-con-macos-28","title":"macOS Golden Gate: cosa sparisce oggi e cosa cambia con macOS 28","excerpt":"Con macOS Golden Gate Apple taglia supporto per Intel, Boot Camp, Rosetta 2 (in modo definitivo) e servizi legacy come AFP, Time Capsule e AirPort Utility. Ulteriori riduzioni sono attese con macOS 28.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},"variant":"hero","size":"large","priority":true}]}],["$","div",null,{"className":"relative lg:col-start-7 lg:col-span-3 lg:row-span-2 min-h-[160px] sm:min-h-[190px] lg:min-h-[320px]","children":["$","$L2",null,{"post":{"id":17958,"date":"2026-09-22T08:00:00+02:00","modified":"2026-09-22T06:00:00+00:00","slug":"apple-seconda-beta-macos-golden-gate-27-2-sviluppatori","title":"Apple rilascia la seconda beta di macOS Golden Gate 27.2 agli sviluppatori","excerpt":"Apple sta testando macOS Golden Gate 27.2 e ha reso disponibile agli sviluppatori la seconda beta, a una settimana dalla prima. Novità attesa: Siri AI in nuove lingue.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},"variant":"hero","size":"medium"}]}],["$","div",null,{"className":"relative lg:col-start-10 lg:col-span-3 lg:row-start-1 min-h-[160px] sm:min-h-[190px] lg:min-h-[158px]","children":["$","$L2",null,{"post":{"id":17872,"date":"2026-09-18T08:44:00+02:00","modified":"2026-09-18T06:44:00+00:00","slug":"macos-golden-gate-50-novita-siri-app-interfaccia","title":"macOS Golden Gate: 50 novità tra Siri, app Apple e interfaccia","excerpt":"macOS 27 Golden Gate porta un’esperienza Siri rinnovata, nuove funzioni in Safari, Foto, Mail e Calendario, miglioramenti all’interfaccia e aggiornamenti per AirDrop, i widget e molto altro.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/50-New-macOS-Golden-Gate-Features-and-Changes-Worth-Checking-Out-Feature-768x432.jpg","imageAlt":"50-New-macOS-Golden-Gate-Features-and-Changes-Worth-Checking-Out-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},"variant":"hero","size":"small"}]}],["$","div",null,{"className":"relative lg:col-start-10 lg:col-span-3 lg:row-start-2 min-h-[160px] sm:min-h-[190px] lg:min-h-[158px]","children":["$","$L2",null,{"post":{"id":17856,"date":"2026-09-18T08:00:00+02:00","modified":"2026-09-18T06:00:00+00:00","slug":"apple-prima-beta-macos-golden-gate-27-2-sviluppatori","title":"Apple rilascia la prima beta di macOS Golden Gate 27.2 agli sviluppatori","excerpt":"Apple avvia la beta di macOS Golden Gate 27.2 per gli sviluppatori. Il test arriva a pochi giorni dal rilascio di macOS Golden Gate 27.0 e riaccende le attese su funzioni di Apple Intelligence e su Suggestions in Messaggi.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},"variant":"hero","size":"small"}]}]]}]}],"$undefined","$L3","$undefined"]}],["$L4"],"$L5"]}],"isPartial":"$@6","staleTime":"$7","varyParams":null},{"rsc":"$L8","isPartial":"$@9","staleTime":"$7","varyParams":null},{"rsc":"$La","isPartial":"$@b","staleTime":"$7","varyParams":"$c"}],"isUpgradeableISRFallback":false,"a":"$@d","rootVaryParams":null,"needsRuntimeRequest":"$@e"}
