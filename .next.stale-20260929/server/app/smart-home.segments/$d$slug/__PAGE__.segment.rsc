3:["$","div",null,{"className":"flex flex-col lg:flex-row gap-8","children":[["$","div",null,{"className":"flex-1 min-w-0","children":["$","$Lf",null,{"initialPosts":[{"id":17472,"date":"2026-09-05T09:28:00+02:00","modified":"2026-09-05T07:28:00+00:00","slug":"apple-servizio-sicurezza-monitoraggio-casa-2027-nuovo-sensore","title":"Apple prepara un servizio di sicurezza e monitoraggio domestico: debutto nel 2027","excerpt":"Apple starebbe lavorando a un servizio di sicurezza e monitoraggio per la casa, previsto per il 2027, insieme a un nuovo sensore dedicato.","categoryName":"Smart Home","categorySlug":"smart-home","categoryId":11,"imageUrl":"https://static.techjournal.it/2026/09/apple-servizio-di-sicurezza-domestico-768x432.jpg","imageAlt":"apple-servizio-di-sicurezza-domestico","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17468,"date":"2026-09-05T08:44:00+02:00","modified":"2026-09-05T06:44:00+00:00","slug":"homepod-audioos-27-surround-4-speaker-party-mode","title":"HomePod, audioOS 27 prepara surround a 4 speaker e Party Mode","excerpt":"Nel codice di audioOS 27 emergono riferimenti a un sistema surround con quattro altoparlanti, una Party Mode e un nuovo hardware non ancora presente in gamma.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/homepod-4-surround-768x432.jpg","imageAlt":"homepod-4-surround","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17466,"date":"2026-09-05T08:22:00+02:00","modified":"2026-09-05T06:22:00+00:00","slug":"apple-prepara-sistema-surround-quattro-homepod","title":"Apple prepara un vero sistema surround con quattro HomePod?","excerpt":"Nel codice di audioOS 27 emergono indizi su un possibile sistema surround basato su quattro HomePod, insieme a un nuovo Party Mode e a un dispositivo ancora non identificato.","categoryName":"Smart Home","categorySlug":"smart-home","categoryId":11,"imageUrl":"https://static.techjournal.it/2026/09/homepods-four-768x432.jpg","imageAlt":"homepods-four","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17238,"date":"2026-08-28T12:02:00+02:00","modified":"2026-08-28T10:02:00+00:00","slug":"ios-27-nuove-funzioni-ai-apple-tv-4k-homepod","title":"iOS 27: nuove funzioni AI in arrivo su Apple TV 4K ed HomePod","excerpt":"Dai primi indizi sul codice di iOS 27 emergono possibili nuove funzioni basate sull’intelligenza artificiale in arrivo su Apple TV 4K e HomePod.","categoryName":"Smart Home","categorySlug":"smart-home","categoryId":11,"imageUrl":"https://static.techjournal.it/2026/08/apple-tv-homepod-siri-ai-768x432.jpg","imageAlt":"apple-tv-homepod-siri-ai","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17198,"date":"2026-08-26T08:44:00+02:00","modified":"2026-08-26T06:44:00+00:00","slug":"home-hub-codice-suggerisce-cambio-profilo-ambient-sensing","title":"Home Hub: il codice suggerisce il cambio profilo basato sull’identità","excerpt":"Nel codice dell’aggiornamento macOS Tahoe 26.7 emergono riferimenti a “Personal Content” e “ambient sensing”, con possibili cambi profilo automatici per utenti diversi in casa.","categoryName":"Smart Home","categorySlug":"smart-home","categoryId":11,"imageUrl":"https://static.techjournal.it/2026/08/Apple-AI-Command-Center-Concept-Mock-3-768x432.jpg","imageAlt":"Apple-AI-Command-Center-Concept-Mock-3","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17179,"date":"2026-08-26T08:00:00+02:00","modified":"2026-08-26T06:00:00+00:00","slug":"apple-riorganizza-apple-store-casa-intelligente-nuovi-spazi-espositivi","title":"Apple riorganizza gli Apple Store per la casa intelligente: nuovi spazi espositivi","excerpt":"Apple si prepara a riorganizzare gli Apple Store con aree dedicate alla casa intelligente, pensate per mettere in evidenza i nuovi prodotti.","categoryName":"Smart Home","categorySlug":"smart-home","categoryId":11,"imageUrl":"https://static.techjournal.it/2026/08/apple-store-nuovo-look-per-prodotti-home-768x432.jpg","imageAlt":"apple-store-nuovo-look-per-prodotti-home","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17051,"date":"2026-08-21T08:00:00+02:00","modified":"2026-08-21T06:00:00+00:00","slug":"codice-macos-nuova-casa-apple-homepad-homepod-mini-2-videocamera","title":"Il codice di macOS svela la nuova casa Apple: HomePad, HomePod mini 2 e una videocamera","excerpt":"La Release Candidate di macOS 26.7 avrebbe rivelato nuovi dispositivi per la casa Apple: HomePad, HomePod mini 2, una videocamera di sicurezza e altri accessori non ancora annunciati.","categoryName":"Smart Home","categorySlug":"smart-home","categoryId":11,"imageUrl":"https://static.techjournal.it/2026/08/homepad-concept-768x432.jpg","imageAlt":"homepad-concept","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17041,"date":"2026-08-20T12:46:00+02:00","modified":"2026-08-20T10:46:00+00:00","slug":"apple-prepara-smart-display-come-funzionera-con-iphone","title":"Apple prepara il suo smart display: come funzionerà con l’iPhone","excerpt":"Il futuro Home Hub di Apple dovrebbe integrare widget e nuove funzionalità pensate per lavorare in sinergia con l’iPhone.","categoryName":"Smart Home","categorySlug":"smart-home","categoryId":11,"imageUrl":"https://static.techjournal.it/2026/08/homepod-ai-768x432.jpg","imageAlt":"homepod-ai","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17023,"date":"2026-08-20T09:06:00+02:00","modified":"2026-08-20T07:06:00+00:00","slug":"apple-home-hub-galleria-widget-supporto-iphone-widget","title":"Home Hub di Apple: galleria widget e supporto ai widget per iPhone","excerpt":"Il prossimo Home Hub di Apple includerà una galleria widget con supporto ai widget per iPhone, ampliando le opzioni di personalizzazione e accesso alle informazioni in casa.","categoryName":"Smart Home","categorySlug":"smart-home","categoryId":11,"imageUrl":"https://static.techjournal.it/2026/08/Apple-AI-Command-Center-Concept-Mock-3-768x432.jpg","imageAlt":"Apple-AI-Command-Center-Concept-Mock-3","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16596,"date":"2026-07-30T09:28:00+02:00","modified":"2026-07-30T07:28:00+00:00","slug":"apple-home-hub-possibile-lancio-ottobre-2026","title":"Apple Home Hub: possibile lancio già a ottobre 2026","excerpt":"Un nuovo Apple Home Hub potrebbe arrivare già a ottobre 2026, rafforzando l’ecosistema per la domotica e l’integrazione dei dispositivi smart in casa.","categoryName":"Smart Home","categorySlug":"smart-home","categoryId":11,"imageUrl":"https://static.techjournal.it/2026/07/Home-Hub-Command-Center-with-Dome-Base-Feature-768x432.jpg","imageAlt":"Home-Hub-Command-Center-with-Dome-Base-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":4,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16588,"date":"2026-07-30T08:00:00+02:00","modified":"2026-07-30T06:00:00+00:00","slug":"apple-nuove-generazioni-apple-tv-homepod-mini-home-hub-siri-ai","title":"Apple prepara nuove generazioni di Apple TV, HomePod mini e un Home Hub con Siri AI","excerpt":"Apple sarebbe pronta a lanciare una nuova Apple TV, una nuova versione di HomePod mini e un inedito Home Hub con display da 7 pollici e Siri AI.","categoryName":"Smart Home","categorySlug":"smart-home","categoryId":11,"imageUrl":"https://static.techjournal.it/2026/07/Home-Hub-Command-Center-with-Dome-Base-Feature-768x432.jpg","imageAlt":"Home-Hub-Command-Center-with-Dome-Base-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16550,"date":"2026-07-27T22:20:32+02:00","modified":"2026-07-27T20:20:32+00:00","slug":"apple-rilascia-tvos-26-6-per-apple-tv-4k","title":"Apple rilascia tvOS 26.6 per Apple TV 4K","excerpt":"Apple ha rilasciato tvOS 26.6, il sesto aggiornamento del sistema tvOS. Disponibile su Apple TV 4K, arriva due mesi dopo tvOS 26.5.","categoryName":"Smart Home","categorySlug":"smart-home","categoryId":11,"imageUrl":"https://static.techjournal.it/2026/07/tvOS-26-Feature-768x432.jpg","imageAlt":"tvOS-26-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null}],"initialConsumedPosts":["$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:0:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:1:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:2:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:3:props:children:props:post","$3:props:children:0:props:children:props:initialPosts:0","$3:props:children:0:props:children:props:initialPosts:1","$3:props:children:0:props:children:props:initialPosts:2","$3:props:children:0:props:children:props:initialPosts:3","$3:props:children:0:props:children:props:initialPosts:4","$3:props:children:0:props:children:props:initialPosts:5","$3:props:children:0:props:children:props:initialPosts:6","$3:props:children:0:props:children:props:initialPosts:7","$3:props:children:0:props:children:props:initialPosts:8","$3:props:children:0:props:children:props:initialPosts:9","$3:props:children:0:props:children:props:initialPosts:10","$3:props:children:0:props:children:props:initialPosts:11"],"in