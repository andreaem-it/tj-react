3:["$","div",null,{"className":"flex flex-col lg:flex-row gap-8","children":[["$","div",null,{"className":"flex-1 min-w-0","children":["$","$Lf",null,{"initialPosts":[{"id":18048,"date":"2026-09-25T09:06:00+02:00","modified":"2026-09-25T07:06:00+00:00","slug":"tim-cook-incontra-ursula-von-der-leyen-eu-kids-act-social-minori","title":"Tim Cook incontra Ursula von der Leyen: sul tavolo l’EU Kids Act per limitare i social ai minori","excerpt":"Tim Cook ha incontrato Ursula von der Leyen a Manhattan. Al centro del colloquio l’EU Kids Act, proposta UE per limitare l’accesso dei minori ai social e imporre nuove tutele alle piattaforme.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/tim-cook-ursula-europa-eu-kids-act-768x432.jpg","imageAlt":"tim-cook-ursula-europa-eu-kids-act","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18042,"date":"2026-09-25T08:00:00+02:00","modified":"2026-09-25T06:00:00+00:00","slug":"apple-rilascia-watchos-27-0-1-fix-riavvii-imprevisti","title":"Apple rilascia watchOS 27.0.1: fix per riavvii imprevisti","excerpt":"Apple ha rilasciato watchOS 27.0.1, aggiornamento minore per Apple Watch Series 12 e Apple Watch Ultra 4. Include correzioni di bug e un fix per riavvii inattesi.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/watchos-27-768x432.jpg","imageAlt":"watchos-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18037,"date":"2026-09-24T12:46:00+02:00","modified":"2026-09-24T10:46:00+00:00","slug":"mac-studio-m5-max-m5-ultra-prime-recensioni-prezzo-altissimo","title":"Mac Studio M5 Max ed M5 Ultra, le prime recensioni: il Mac più potente di sempre, ma il prezzo arriva a cifre altissime","excerpt":"Le prime recensioni di Mac Studio con chip M5 Max e M5 Ultra lo descrivono come il Mac più potente mai realizzato, ma con un listino che può raggiungere cifre molto elevate.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/mac-studio-2026-review-768x432.jpg","imageAlt":"mac-studio-2026-review","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18035,"date":"2026-09-24T12:24:00+02:00","modified":"2026-09-24T10:24:00+00:00","slug":"apple-rivale-whoop-braccialetto-fitness-senza-schermo-tempi-lunghi","title":"Apple prepara un rivale di Whoop: braccialetto fitness senza schermo, ma i tempi sono lunghi","excerpt":"Apple starebbe lavorando a un braccialetto fitness senza schermo, pensato per competere nel segmento di monitoraggio continuo. Ma l’arrivo sul mercato potrebbe richiedere tempo.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/apple-braccialetto-fitness-fascia-Whoop-1-768x432.jpg","imageAlt":"apple-braccialetto-fitness-fascia-Whoop-1","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18033,"date":"2026-09-24T12:02:00+02:00","modified":"2026-09-24T10:02:00+00:00","slug":"iphone-duo-scalda-troppo-4k-prima-prova-punto-preciso","title":"iPhone Duo scalda troppo in 4K: la prima prova indica un punto preciso","excerpt":"Le prime verifiche su iPhone Duo durante la registrazione video in 4K segnalano un surriscaldamento anomalo. L’attenzione si concentra su un’area specifica del dispositivo.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/iphone-duo-fotocamera-768x432.jpg","imageAlt":"iphone-duo-fotocamera","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18012,"date":"2026-09-24T08:44:00+02:00","modified":"2026-09-24T06:44:00+00:00","slug":"apple-iphone-doppio-display-2029","title":"Apple: iPhone con tecnologia a doppio display in arrivo nel 2029","excerpt":"Apple starebbe pianificando l’introduzione della tecnologia a doppio display, già associata a iPhone, su modelli Pro nel 2029.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/iphone-2028-punch-hole-design-768x432.jpg","imageAlt":"iphone-2028-punch-hole-design","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18024,"date":"2026-09-23T11:20:09+02:00","modified":"2026-09-23T09:20:09+00:00","slug":"gpt-6-sol-luna-miglioramenti-astra-piani-economici","title":"I nuovi modelli GPT-6 Sol e Luna di OpenAI portano miglioramenti Astra anche nei piani più economici","excerpt":"OpenAI introduce i modelli GPT-6 Sol e Luna, estendendo i miglioramenti legati ad Astra anche ai piani più economici. Una novità pensata per aumentare prestazioni e accessibilità.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/openai-logo-teal-768x432.jpg","imageAlt":"openai-logo-teal","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17980,"date":"2026-09-23T08:00:00+02:00","modified":"2026-09-23T06:00:00+00:00","slug":"apple-watch-series-12-ultra-4-riavvii-inattesi","title":"Apple Watch Series 12 e Ultra 4: segnalati riavvii inattesi","excerpt":"Alcuni proprietari di Apple Watch Series 12 e Ultra 4 segnalano riavvii inattesi. Un problema che, al momento, resta circoscritto alle segnalazioni degli utenti.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/apple-watch-s12-ultra-4-768x432.jpg","imageAlt":"apple-watch-s12-ultra-4","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18002,"date":"2026-09-22T22:50:09+02:00","modified":"2026-09-22T20:50:09+00:00","slug":"apple-smart-glasses-mercato-in-crescita-2026-09-22","title":"Apple punta alle smart glasses: ingresso in un mercato in crescita","excerpt":"Le smart glasses di Apple sarebbero in arrivo, con l’obiettivo di inserirsi in un mercato in rapida espansione e intercettare nuove esigenze di utilizzo quotidiano.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/Apple-Glasses-Blue-Feature-768x432.jpg","imageAlt":"Apple-Glasses-Blue-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17984,"date":"2026-09-22T09:06:00+02:00","modified":"2026-09-22T07:06:00+00:00","slug":"iphone-20-pro-primi-prototipi-display-piu-grandi-piu-definiti-forse-curvi-quattro-lati","title":"iPhone 20 Pro: i primi prototipi mostrano display più grandi, più definiti e forse curvi su quattro lati","excerpt":"I primi prototipi di iPhone 20 Pro suggeriscono un salto sul display: dimensioni maggiori, maggiore definizione e la possibilità di un design curvo su quattro lati.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/iphone-20-pro-display-senza-cornici-768x432.jpg","imageAlt":"iphone-20-pro-display-senza-cornici","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17971,"date":"2026-09-21T22:20:41+02:00","modified":"2026-09-21T20:20:41+00:00","slug":"apple-watch-series-12-ultra-4-flash-storage-128gb-nascosta","title":"Apple Watch Series 12 e Ultra 4: possibile memoria flash “nascosta” da 128GB","excerpt":"Apple Watch Series 12 e Ultra 4 potrebbero montare una memoria NAND da 128GB, anche se la capacità ufficiale disponibile è di 64GB. L’ipotesi: una parte riservata a buffer di durata o a dati intensivi dei sensori.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/apple-watch-s12-ultra-4-768x432.jpg","imageAlt":"apple-watch-s12-ultra-4","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17946,"date":"2026-09-21T09:50:25+02:00","modified":"2026-09-21T07:50:25+00:00","slug":"apple-pencil-piu-corto-iphone-duo-progetto-cancellato-supporto-usb-c-in-arrivo","title":"Apple Pencil più corto per iPhone Duo: progetto cancellato, supporto al modello USB‑C in arrivo","excerpt":"Un Apple Pencil più corto pensato per iPhone Duo era in sviluppo, ma Apple lo avrebbe cancellato per problemi tecnici legati alla produzione. In alternativa, iPhone Duo riceverà più avanti il supporto all’Apple Pencil USB‑C esistente.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/iphone-duo-hero-768x432.jpg","imageAlt":"iphone-duo-hero","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null}],"initialConsumedPosts":["$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:0:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:1:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:2:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:3:props:children:props:post","$3:props:children:0:props:children:props:initialPosts:0","$3:props:children:0:props:children:props:initialPosts:1","$3:props:children:0:props:children:props:initialPosts:2","$3:props:children:0:props:children:props:initialPosts:3","$3:props:children:0:props:children:prop