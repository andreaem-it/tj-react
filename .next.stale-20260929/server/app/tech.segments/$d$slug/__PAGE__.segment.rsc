oryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/watchos-27-2-screenshot-768x432.jpg","imageAlt":"watchos-27-2-screenshot","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},"variant":"hero","size":"medium"}]}],["$","div",null,{"className":"relative lg:col-start-10 lg:col-span-3 lg:row-start-1 min-h-[160px] sm:min-h-[190px] lg:min-h-[158px]","children":["$","$L2",null,{"post":{"id":18058,"date":"2026-09-25T12:02:00+02:00","modified":"2026-09-25T10:02:00+00:00","slug":"copland-apple-prova-os-in-browser-emulazione","title":"Copland di Apple torna a vivere: prova l’OS in emulazione direttamente dal browser","excerpt":"Dopo anni di sviluppo e cancellazione, Copland può finalmente essere provato in emulazione: grazie a modifiche a DingusPPC, è disponibile una versione avviabile nel browser.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/mac-copland-os-768x432.jpg","imageAlt":"mac-copland-os","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},"variant":"hero","size":"small"}]}],["$","div",null,{"className":"relative lg:col-start-10 lg:col-span-3 lg:row-start-2 min-h-[160px] sm:min-h-[190px] lg:min-h-[158px]","children":["$","$L2",null,{"post":{"id":18070,"date":"2026-09-25T12:02:00+02:00","modified":"2026-09-25T10:02:00+00:00","slug":"qualcomm-rinnova-accordo-globale-licenza-brevetti-apple-2027","title":"Qualcomm rinnova l’accordo globale di licenza brevetti con Apple","excerpt":"Qualcomm ha annunciato il rinnovo dell’accordo globale di licenza brevetti con Apple, con efficacia dal 1° aprile 2027. L’intesa è separata dal contratto per i modem cellulari.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/Qualcomm-Apple-Logo