3e:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L4b",null,{"posts":[{"id":18099,"date":"2026-09-28T15:58:01+02:00","modified":"2026-09-28T13:58:01+00:00","slug":"nuovo-ipad-mini-codice-apple-chip-a20-pro-dettaglio-iphone","title":"Nuovo iPad mini: il codice Apple svela chip A20 Pro e un dettaglio “preso” dall’iPhone","excerpt":"Dal codice Apple emergono riferimenti al prossimo iPad mini: tra le indicazioni c’è il chip A20 Pro, lo stesso degli iPhone 18 Pro, oltre a un dettaglio riconducibile all’iPhone.","categoryName":"iPad","categorySlug":"ipad","categoryId":10,"imageUrl":"https://static.techjournal.it/2026/09/ipad-mini-2026-leak-768x432.jpg","imageAlt":"ipad-mini-2026-leak","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18074,"date":"2026-09-26T09:06:00+02:00","modified":"2026-09-26T07:06:00+00:00","slug":"texture-grana-stili-fotografici-solo-iphone-18-pro-duo-apple-aggiorna-comunicato","title":"Texture e grana degli Stili fotografici solo su iPhone 18 Pro e Duo: Apple aggiorna il comunicato","excerpt":"Apple ha corretto la nota del comunicato stampa italiano di iPhone 18 Pro: i nuovi controlli per texture e grana degli Stili fotografici non arriveranno su iPhone 16, iPhone 17 e iPhone Air, ma risultano riservati a iPhone 18 Pro e Duo.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/texture-pelle-morbida-stile-fotografico-ios-27-iphone-768x432.jpg","imageAlt":"texture-pelle-morbida-stile-fotografico-ios-27-iphone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17902,"date":"2026-09-19T08:22:00+02:00","modified":"2026-09-19T06:22:00+00:00","slug":"compatibilita-cover-iphone-17-pro-iphone-18-pro","title":"Le cover iPhone 17 Pro sono compatibili con iPhone 18 Pro? La risposta di Apple","excerpt":"Apple indica che le cover per iPhone 17 Pro non sarebbero compatibili con iPhone 18 Pro, ma test pratici suggeriscono che nella maggior parte dei casi lo scambio funziona.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/iPhone-18-Pro-Case-3200x1800-1-768x432.jpeg","imageAlt":"iPhone-18-Pro-Case-3200x1800-1","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17823,"date":"2026-09-17T08:22:00+02:00","modified":"2026-09-17T06:22:00+00:00","slug":"iphone-16-pro-vs-iphone-18-pro-buyers-guide-valga-lupgrade","title":"iPhone 16 Pro vs. iPhone 18 Pro: Buyer’s Guide, vale l’upgrade?","excerpt":"Apple ha introdotto iPhone 18 Pro e iPhone 18 Pro Max due anni dopo i 16 Pro. Tra chip A20 Pro, fotocamera con apertura variabile, modem C2 e soprattutto autonomia record, ecco quando conviene davvero passare.","categoryName":"Guide","categorySlug":"guide","categoryId":196,"imageUrl":"https://static.techjournal.it/2026/09/iPhone-16-Pro-vs-18-Pro-Buyers-Guide-Feature-768x432.jpg","imageAlt":"iPhone-16-Pro-vs-18-Pro-Buyers-Guide-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17733,"date":"2026-09-13T12:46:00+02:00","modified":"2026-09-13T10:46:00+00:00","slug":"custodie-iphone-18-pro-compatibili-anche-con-iphone-17-pro","title":"Le custodie di iPhone 18 Pro sono compatibili anche con iPhone 17 Pro","excerpt":"Le nuove custodie ufficiali per iPhone 18 Pro e iPhone 18 Pro Max sono arrivate negli Apple Store e risultano compatibili anche con iPhone 17 Pro.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/custodie-iphone-18-pro-compatibili-iphone-17-pro-768x432.jpg","imageAlt":"custodie-iphone-18-pro-compatibili-iphone-17-pro","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17710,"date":"2026-09-13T12:02:00+02:00","modified":"2026-09-13T10:02:00+00:00","slug":"iphone-18-pro-piu-facile-da-riparare-di-iphone-17-pro-punteggi-etichetta-europea","title":"iPhone 18 Pro è un po’ più facile da riparare di iPhone 17 Pro: i punteggi ufficiali dell’etichetta europea","excerpt":"Dall’etichetta europea sulla riparabilità emerge che iPhone 18 Pro ottiene un punteggio leggermente migliore rispetto a iPhone 17 Pro, con differenze misurabili su componenti e interventi.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/iphone-18-pro-repair-score-reparability--768x432.jpg","imageAlt":"iphone-18-pro-repair-score-reparability-","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17708,"date":"2026-09-13T12:02:00+02:00","modified":"2026-09-13T10:02:00+00:00","slug":"upgrade-iphone-18-pro-da-iphone-17-pro-cosa-cambia","title":"Cosa cambia passando da iPhone 17 Pro a iPhone 18 Pro","excerpt":"iPhone 18 Pro e Pro Max puntano su upgrade mirati: più potenza, nuove funzioni per la fotocamera principale, autonomia migliorata e ricarica cablata più veloce. Alcune specifiche chiave restano invece invariate.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/What-Upgrading-to-iPhone-18-Pro-From-iPhone-17-Pro-Gets-You-Feature-768x432.jpg","imageAlt":"What-Upgrading-to-iPhone-18-Pro-From-iPhone-17-Pro-Gets-You-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18072,"date":"2026-09-26T08:44:00+02:00","modified":"2026-09-26T06:44:00+00:00","slug":"apple-conferma-aggiornamento-bugfix-iphone-18-pro-prossima-settimana","title":"Apple conferma: aggiornamento di correzione bug per iPhone 18 Pro la prossima settimana","excerpt":"Apple ha confermato l’arrivo di un aggiornamento di correzione bug per iPhone 18 Pro la prossima settimana, con l’obiettivo di migliorare stabilità e prestazioni.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/Face-ID-iPhone-18-Pro-768x432.jpg","imageAlt":"Face-ID-iPhone-18-Pro","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null}],"heading":"Articoli correlati"}]}]
