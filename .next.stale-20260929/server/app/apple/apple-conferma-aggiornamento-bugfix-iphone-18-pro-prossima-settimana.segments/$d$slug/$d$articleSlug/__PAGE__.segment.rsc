a:["$","div",null,{"className":"px-3 py-6 md:p-8","children":[null,null,false,["$","div",null,{"id":"article-reading-18072","children":["$","$L1d",null,{"safeHtml":"<p>Apple ha confermato che un aggiornamento di correzione bug per <strong><a href=\"/topic/iphone-18\" class=\"tj-entity-link\">iPhone 18</a> Pro</strong> arriverà <strong>la prossima settimana</strong>.</p>\n<p>L’intervento è pensato per affrontare problemi software riscontrati dagli utenti e per migliorare l’esperienza d’uso complessiva del dispositivo.</p>\n<h2 id=\"cosa-aspettarsi-dall-aggiornamento\">Cosa aspettarsi dall’aggiornamento</h2>\n<ul>\n<li><strong>Correzioni di bug</strong> per problemi segnalati nel software.</li>\n<li><strong>Stabilità migliorata</strong> e ottimizzazioni delle prestazioni.</li>\n<li><strong>Rilascio programmato</strong> per la prossima settimana.</li>\n</ul>\n<p>Per chi utilizza <a href=\"/iphone\" class=\"tj-entity-link\">iPhone</a> 18 Pro, il consiglio è di tenere d’occhio le notifiche e la sezione aggiornamenti in iOS non appena sarà disponibile il pacchetto.</p>\n","postId":18072}]}],["$","$L1e",null,{"postId":18072,"targetId":"article-reading-18072"}],false,["$","div",null,{"className":"mt-8 border-t border-border pt-5","children":[["$","h2",null,{"className":"mb-3 text-xs font-semibold uppercase tracking-wide text-muted","children":"Argomenti"}],["$","nav",null,{"aria-label":"Argomenti dell'articolo","children":["$","ul",null,{"className":"flex flex-wrap items-center gap-2","children":[["$","li","iphone-18",{"children":["$","$L3",null,{"prefetch":false,"href":"/topic/iphone-18","className":"inline-flex min-h-11 items-center rounded-full border border-border bg-surface-overlay px-3 py-1 text-xs font-medium text-foreground transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent","children":"iPhone 18"}]}]]}]}]]}],null,null,["$","section",null,{"className":"mt-8 rounded-lg border border-border bg-surface-overlay p-4 md:p-5","aria-labelledby":"tj-story","children":[["$","div",null,{"className":"mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1","children":[["$","h2",null,{"id":"tj-story","className":"text-sm font-semibold uppercase tracking-wide text-muted","children":["Gli sviluppi su ","iPhone 18"]}],["$","$L3",null,{"prefetch":false,"href":"/topic/iphone-18","className":"inline-flex min-h-11 items-center rounded text-sm text-accent hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent","children":[32," articoli →"]}]]}],[["$","p",null,{"className":"mb-2 text-xs font-semibold text-muted","children":"Dopo questo articolo"}],["$","ol",null,{"className":"mb-4 space-y-2 border-l border-border pl-3","children":[["$","li","18074",{"children":["$","$L3",null,{"prefetch":false,"href":"/ios/texture-grana-stili-fotografici-solo-iphone-18-pro-duo-apple-aggiorna-comunicato","className":"group flex min-h-11 flex-col justify-center rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent","children":[["$","time",null,{"className":"block text-xs uppercase tracking-wide text-muted","dateTime":"2026-09-26T09:06:00+02:00","children":"26 settembre 2026"}],["$","span",null,{"className":"text-sm text-foreground group-hover:text-accent group-hover:underline","children":"Texture e grana degli Stili fotografici solo su iPhone 18 Pro e Duo: Apple aggiorna il comunicato"}]]}]}],["$","li","18099",{"children":["$","$L3",null,{"prefetch":false,"href":"/ipad/nuovo-ipad-mini-codice-apple-chip-a20-pro-dettaglio-iphone","className":"group flex min-h-11 flex-col justify-center rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent","children":[["$","time",null,{"className":"block text-xs uppercase tracking-wide text-muted","dateTime":"2026-09-28T15:58:01+02:00","children":"28 settembre 2026"}],"$L1f"]}]}]]}]],"$L20"]}],null,"$L21"]}]
b:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L22",null,{"posts":[{"id":18099,"date":"2026-09-28T15:58:01+02:00","modified":"2026-09-28T13:58:01+00:00","slug":"nuovo-ipad-mini-codice-apple-chip-a20-pro-dettaglio-iphone","title":"Nuovo iPad mini: il codice Apple svela chip A20 Pro e un dettaglio “preso” dall’iPhone","excerpt":"Dal codice Apple emergono riferimenti al prossimo iPad mini: tra le indicazioni c’è il chip A20 Pro, lo stesso degli iPhone 18 Pro, oltre a un dettaglio riconducibile all’iPhone.","categoryName":"iPad","categorySlug":"ipad","categoryId":10,"imageUrl":"https://static.techjournal.it/2026/09/ipad-mini-2026-leak-768x432.jpg","imageAlt":"ipad-mini-2026-leak","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18074,"date":"2026-09-26T09:06:00+02:00","modified":"2026-09-26T07:06:00+00:00","slug":"texture-grana-stili-fotografici-solo-iphone-18-pro-duo-apple-aggiorna-comunicato","title":"Texture e grana degli Stili fotografici solo su iPhone 18 Pro e Duo: Apple aggiorna il comunicato","excerpt":"Apple ha corretto la nota del comunicato stampa italiano di iPhone 18 Pro: i nuovi controlli per texture e grana degli Stili fotografici non arriveranno su iPhone 16, iPhone 17 e iPhone Air, ma risultano riservati a iPhone 18 Pro e Duo.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/texture-pelle-morbida-stile-fotografico-ios-27-iphone-768x432.jpg","imageAlt":"texture-pelle-morbida-stile-fotografico-ios-27-iphone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18009,"date":"2026-09-24T08:22:00+02:00","modified":"2026-09-24T06:22:00+00:00","slug":"apple-limita-texture-e-grain-niente-su-iphone-piu-vecchi","title":"Apple limita Texture e Grain: niente su iPhone più vecchi","excerpt":"I nuovi controlli Texture e Grain per le Photographic Styles in iOS 27 risultano disponibili solo su iPhone 18 Pro e, per iPhone Duo, su specifiche fotocamere. La compatibilità indicata inizialmente per “i modelli che supportano le Photographic Styles” è stata poi ristretta.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/photographic-styles-3402x-768x432.jpg","imageAlt":"photographic-styles-3402x","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17967,"date":"2026-09-22T08:22:00+02:00","modified":"2026-09-22T06:22:00+00:00","slug":"alcuni-utenti-iphone-18-pro-segnalano-problemi-con-face-id","title":"Alcuni utenti iPhone 18 Pro segnalano problemi con Face ID","excerpt":"Alcuni utenti iPhone 18 Pro segnalano difficoltà legate al funzionamento di Face ID. Al momento si tratta di indiscrezioni e non di un quadro ufficiale.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/Face-ID-iPhone-18-Pro-768x432.jpg","imageAlt":"Face-ID-iPhone-18-Pro","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17956,"date":"2026-09-21T21:50:24+02:00","modified":"2026-09-21T19:50:24+00:00","slug":"iphone-14-pro-vs-iphone-18-pro-guida-alla-upgrade","title":"iPhone 14 Pro vs iPhone 18 Pro: guida all’upgrade","excerpt":"Dopo quattro generazioni, iPhone 18 Pro porta display più grandi, USB‑C, ricarica più rapida, nuove fotocamere, più autonomia e supporto ad Apple Intelligence. Ecco quando conviene davvero passare da iPhone 14 Pro.","categoryName":"Guide","categorySlug":"guide","categoryId":196,"imageUrl":"https://static.techjournal.it/2026/09/iphone-14-pro-vs-iphone-18-pro-768x432.jpg","imageAlt":"iphone-14-pro-vs-iphone-18-pro","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17949,"date":"2026-09-21T12:25:09+02:00","modified":"2026-09-21T10:25:09+00:00","slug":"ifixit-pubblica-teardown-iphone-18-pro-nuove-funzionalita","title":"iFixit pubblica il teardown di iPhone 18 Pro: ecco cosa emerge","excerpt":"Un teardown di iPhone 18 Pro offre uno sguardo ravvicinato all’hardware e alle novità interne del dispositivo, con l’analisi di iFixit sulle componenti e sulla struttura del telefono.","categoryName":"Guide","categorySlug":"guide","categoryId":196,"imageUrl":"https://static.techjournal.it/2026/09/iFixit-iPhone-18-Pro-Teardown-768x432.jpg","imageAlt":"iFixit-iPhone-18-Pro-Teardown","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17925,"date":"2026-09-20T09:06:00+02:00","modified":"2026-09-20T07:06:00+00:00","slug":"iphone-18-pro-max-usa-modem-qualcomm-snapdragon-x80","title":"iPhone 18 Pro Max USA con modem Qualcomm Snapdragon X80: cosa cambia","excerpt":"Un teardown conferma che la variante statunitense di iPhone 18 Pro Max monta il modem Qualcomm Snapdragon X80. Nel resto del mondo, invece, Apple usa il modem C2.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/deep-black-iphone-18-pro-768x432.jpg","imageAlt":"deep-black-iphone-18-pro","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17923,"date":"2026-09-20T08:44:00+02:00","modified":"2026-09-20T06:44:00+00:00","slug":"riparare-iphone-18-pro-pro-max-costa-fino-a-1059-euro-listino-italiano-applecare-plus","title":"Riparare iPhone 18 Pro e Pro Max costa fino a 1.059€: listino italiano e differenze con AppleCare+","excerpt":"Con l’arrivo di iPhone 18 Pro e iPhone 18 Pro Max in Italia, Apple ha aggiornato il listino delle riparazioni fuori garanzia: sostituzione batteria, display, vetro posteriore e fotocamere con costi fino a 1.059€. Ecco cosa cambia con AppleCare+.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/iphone-18-pro-repair-768x432.jpg","imageAlt":"iphone-18-pro-repair","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null}],"heading":"Articoli correlati"}]}]
