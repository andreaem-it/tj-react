c:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L22",null,{"posts":[{"id":18072,"date":"2026-09-26T08:44:00+02:00","modified":"2026-09-26T06:44:00+00:00","slug":"apple-conferma-aggiornamento-bugfix-iphone-18-pro-prossima-settimana","title":"Apple conferma: aggiornamento di correzione bug per iPhone 18 Pro la prossima settimana","excerpt":"Apple ha confermato l’arrivo di un aggiornamento di correzione bug per iPhone 18 Pro la prossima settimana, con l’obiettivo di migliorare stabilità e prestazioni.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/Face-ID-iPhone-18-Pro-768x432.jpg","imageAlt":"Face-ID-iPhone-18-Pro","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18048,"date":"2026-09-25T09:06:00+02:00","modified":"2026-09-25T07:06:00+00:00","slug":"tim-cook-incontra-ursula-von-der-leyen-eu-kids-act-social-minori","title":"Tim Cook incontra Ursula von der Leyen: sul tavolo l’EU Kids Act per limitare i social ai minori","excerpt":"Tim Cook ha incontrato Ursula von der Leyen a Manhattan. Al centro del colloquio l’EU Kids Act, proposta UE per limitare l’accesso dei minori ai social e imporre nuove tutele alle piattaforme.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/tim-cook-ursula-europa-eu-kids-act-768x432.jpg","imageAlt":"tim-cook-ursula-europa-eu-kids-act","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18095,"date":"2026-09-28T16:56:17+02:00","modified":"2026-09-28T14:56:17+00:00","slug":"apple-condannata-5-7-miliardi-violazione-brevetti-aptici","title":"Apple condannata a pagare 5,7 miliardi per violazione di brevetti aptici","excerpt":"Un tribunale federale ha ordinato ad Apple di pagare 5,7 miliardi di dollari a Taction Technology per l’infrazione di due brevetti relativi alla tecnologia aptica.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/apple-watch-series-9-display-768x432.jpeg","imageAlt":"apple-watch-series-9-display","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18101,"date":"2026-09-28T16:20:17+02:00","modified":"2026-09-28T14:20:17+00:00","slug":"watchos-27-12-novita-da-provare-su-apple-watch","title":"watchOS 27: 12 novità da provare su Apple Watch","excerpt":"watchOS 27 è disponibile dal 14 settembre. Ecco 12 cambiamenti e funzioni da scoprire, tra Siri dedicato, Smart Stack più intelligente, nuove gesture e aggiornamenti per salute e allenamenti.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/watchOS-27-Hands-On-Thumb-768x432.jpg","imageAlt":"watchOS-27-Hands-On-Thumb","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18099,"date":"2026-09-28T15:58:01+02:00","modified":"2026-09-28T13:58:01+00:00","slug":"nuovo-ipad-mini-codice-apple-chip-a20-pro-dettaglio-iphone","title":"Nuovo iPad mini: il codice Apple svela chip A20 Pro e un dettaglio “preso” dall’iPhone","excerpt":"Dal codice Apple emergono riferimenti al prossimo iPad mini: tra le indicazioni c’è il chip A20 Pro, lo stesso degli iPhone 18 Pro, oltre a un dettaglio riconducibile all’iPhone.","categoryName":"iPad","categorySlug":"ipad","categoryId":10,"imageUrl":"https://static.techjournal.it/2026/09/ipad-mini-2026-leak-768x432.jpg","imageAlt":"ipad-mini-2026-leak","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18097,"date":"2026-09-28T15:35:48+02:00","modified":"2026-09-28T13:35:48+00:00","slug":"apple-tv-screensaver-audio-si-parte-da-snoopy","title":"Apple TV: gli screensaver potrebbero avere l’audio, si parte da Snoopy","excerpt":"Nel codice di tvOS 27 sono emerse impostazioni nascoste per attivare effetti sonori nei salvaschermo di Apple TV. Il primo a beneficiarne potrebbe essere quello dedicato a Snoopy.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/tvos-27-salvaschermo-audio-featured-768x432.jpg","imageAlt":"tvos-27-salvaschermo-audio-featured","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18103,"date":"2026-09-28T15:00:49+02:00","modified":"2026-09-28T13:03:57+00:00","slug":"apple-valuta-quattro-concept-nuovo-headset-vision-pro","title":"Apple valuta quattro concept per un nuovo headset Vision Pro","excerpt":"Apple starebbe esplorando quattro diverse idee per un nuovo headset legato alla linea Vision Pro, con l’obiettivo di definire forme, funzionalità e approcci di prodotto differenti.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/Vision-Pro-M5-Announcement-768x423.jpg","imageAlt":"Vision-Pro-M5-Announcement","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":0,"review":null