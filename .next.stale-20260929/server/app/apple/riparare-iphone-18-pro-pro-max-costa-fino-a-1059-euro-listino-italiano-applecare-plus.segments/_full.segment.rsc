3f:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L4b",null,{"posts":[{"id":18099,"date":"2026-09-28T15:58:01+02:00","modified":"2026-09-28T13:58:01+00:00","slug":"nuovo-ipad-mini-codice-apple-chip-a20-pro-dettaglio-iphone","title":"Nuovo iPad mini: il codice Apple svela chip A20 Pro e un dettaglio “preso” dall’iPhone","excerpt":"Dal codice Apple emergono riferimenti al prossimo iPad mini: tra le indicazioni c’è il chip A20 Pro, lo stesso degli iPhone 18 Pro, oltre a un dettaglio riconducibile all’iPhone.","categoryName":"iPad","categorySlug":"ipad","categoryId":10,"imageUrl":"https://static.techjournal.it/2026/09/ipad-mini-2026-leak-768x432.jpg","imageAlt":"ipad-mini-2026-leak","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18074,"date":"2026-09-26T09:06:00+02:00","modified":"2026-09-26T07:06:00+00:00","slug":"texture-grana-stili-fotografici-solo-iphone-18-pro-duo-apple-aggiorna-comunicato","title":"Texture e grana degli Stili fotografici solo su iPhone 18 Pro e Duo: Apple aggiorna il comunicato","excerpt":"Apple ha corretto la nota del comunicato stampa italiano di iPhone 18 Pro: i nuovi controlli per texture e grana degli Stili fotografici non arriveranno su iPhone 16, iPhone 17 e iPhone Air, ma risultano riservati a iPhone 18 Pro e Duo.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/texture-pelle-morbida-stile-fotografico-ios-27-iphone-768x432.jpg","imageAlt":"texture-pelle-morbida-stile-fotografico-ios-27-iphone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18072,"date":"2026-09-26T08:44:00+02:00","modified":"2026-09-26T06:44:00+00:00","slug":"apple-conferma-aggiornamento-bugfix-iphone-18-pro-prossima-settimana","title":"Apple conferma: aggiornamento di correzione bug per iPhone 18 Pro la prossima settimana","excerpt":"Apple ha confermato l’arrivo di un aggiornamento di correzione bug per iPhone 18 Pro la prossima settimana, con l’obiettivo di migliorare stabilità e prestazioni.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/Face-ID-iPhone-18-Pro-768x432.jpg","imageAlt":"Face-ID-iPhone-18-Pro","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18009,"date":"2026-09-24T08:22:00+02:00","modified":"2026-09-24T06:22:00+00:00","slug":"apple-limita-texture-e-grain-niente-su-iphone-piu-vecchi","title":"Apple limita Texture e Grain: niente su iPhone più vecchi","excerpt":"I nuovi controlli Texture e Grain per le Photographic Styles in iOS 27 risultano disponibili solo su iPhone 18 Pro e, per iPhone Duo, su specifiche fotocamere. La compatibilità indicata inizialmente per “i modelli che supportano le Photographic Styles” è stata poi ristretta.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/photographic-styles-3402x-768x432.jpg","imageAlt":"photographic-styles-3402x","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17967,"date":"2026-09-22T08:22:00+02:00","modified":"2026-09-22T06:22:00+00:00","slug":"alcuni-utenti-iphone-18-pro-segnalano-problemi-con-face-id","title":"Alcuni utenti iPhone 18 Pro segnalano problemi con Face ID","excerpt":"Alcuni utenti iPhone 18 Pro segnalano difficoltà legate al funzionamento di Face ID. Al momento si tratta di indiscrezioni e non di un quadro ufficiale.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/Face-ID-iPhone-18-Pro-768x432.jpg","imageAlt"