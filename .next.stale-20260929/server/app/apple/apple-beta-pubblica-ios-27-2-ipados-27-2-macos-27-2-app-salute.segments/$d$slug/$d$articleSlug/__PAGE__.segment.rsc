c:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L25",null,{"posts":[{"id":18020,"date":"2026-09-23T12:33:22+02:00","modified":"2026-09-23T10:33:22+00:00","slug":"apple-prime-beta-pubbliche-ios-27-2-macos-golden-gate-27-2","title":"Apple avvia le prime beta pubbliche di iOS 27.2 e macOS Golden Gate 27.2","excerpt":"Apple ha rilasciato le prime beta pubbliche di iOS 27.2, iPadOS 27.2, macOS Golden Gate 27.2, tvOS 27.2 e watchOS 27.2. Novità principali: app Salute ridisegnata e nuove opzioni in Apple TV con Siri AI in più lingue.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/iOS-27.2-Next-to-iPhone-768x432.jpg","imageAlt":"iOS-27.2-Next-to-iPhone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17960,"date":"2026-09-21T22:12:43+02:00","modified":"2026-09-21T20:12:43+00:00","slug":"apple-seconda-beta-ios-27-2","title":"Apple rilascia la seconda beta di iOS 27.2 e aggiorna anche iPadOS","excerpt":"Apple ha distribuito la seconda beta di iOS 27.2 agli sviluppatori, a una settimana dalla prima. Presente anche una beta di iPadOS 27.2, con novità su app Salute e Siri.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/iOS-27.2-Next-to-iPhone-768x432.jpg","imageAlt":"iOS-27.2-Next-to-iPhone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18087,"date":"2026-09-26T12:02:00+02:00","modified":"2026-09-26T10:02:00+00:00","slug":"macos-golden-gate-cosa-sparisce-e-cosa-cambia-con-macos-28","title":"macOS Golden Gate: cosa sparisce oggi e cosa cambia con macOS 28","excerpt":"Con macOS Golden Gate Apple taglia supporto per Intel, Boot Camp, Rosetta 2 (in modo definitivo) e servizi legacy come AFP, Time Capsule e AirPort Utility. Ulteriori riduzioni sono attese con macOS 28.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18085,"date":"2026-09-26T09:28:00+02:00","modified":"2026-09-26T07:28:00+00:00","slug":"come-controllare-data-di-produzione-mac-macos-27","title":"Come controllare la data di produzione del tuo Mac in macOS 27","excerpt":"Con macOS 27 Golden Gate puoi risalire alla data di produzione del tuo Mac tramite la sezione “Regulatory Certification” nel System Report.","categoryName":"Guide","categorySlug":"guide","categoryId":196,"imageUrl":"https://static.techjournal.it/2026/09/2026-mac-mini-blue-768x432.jpeg","imageAlt":"2026-mac-mini-blue","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17994,"date":"2026-09-22T14:17:10+02:00","modified":"2026-09-22T12:17:10+00:00","slug":"apple-licenzia-parte-team-fitness-plus-integrazione-app-salute","title":"Apple licenzia parte del team di Fitness+: possibile integrazione in Salute","excerpt":"Apple avrebbe licenziato parte del team di Fitness+. Il servizio potrebbe essere integrato nell’app Salute, con un possibile cambio di strategia per l’esperienza fitness su iPhone e Apple Watch.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/apple-fitness-768x432.jpg","imageAlt":"apple-fitness","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16477,"date":"2026-07-24T08:33:43+02:00","modified":"2026-07-24T06:33:43+00:00","slug":"chatgpt-integrazione-apple-health-rollout-stati-uniti","title":"ChatGPT: integrazione con Apple Health in rollout negli Stati Uniti","excerpt":"La funzione “Health in ChatGPT”, che integra cartelle cliniche e dati Apple Health, è in rollout per gli utenti negli Stati Uniti. Disponibile su web e iOS per piani Free, Go, Plus e Pro.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/07/chatgpt-health-768x432.jpg","imageAlt":"chatgpt-health","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null}],"heading":"Articoli correlati"}]}]
