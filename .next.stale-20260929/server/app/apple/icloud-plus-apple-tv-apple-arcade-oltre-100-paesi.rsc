3e:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L4a",null,{"posts":[{"id":18097,"date":"2026-09-28T15:35:48+02:00","modified":"2026-09-28T13:35:48+00:00","slug":"apple-tv-screensaver-audio-si-parte-da-snoopy","title":"Apple TV: gli screensaver potrebbero avere l’audio, si parte da Snoopy","excerpt":"Nel codice di tvOS 27 sono emerse impostazioni nascoste per attivare effetti sonori nei salvaschermo di Apple TV. Il primo a beneficiarne potrebbe essere quello dedicato a Snoopy.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/tvos-27-salvaschermo-audio-featured-768x432.jpg","imageAlt":"tvos-27-salvaschermo-audio-featured","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17790,"date":"2026-09-15T12:24:00+02:00","modified":"2026-09-15T10:24:00+00:00","slug":"nuova-apple-tv-homepod-mini-lanci-in-arrivo-entro-lanno","title":"Nuova Apple TV e HomePod Mini: lanci in arrivo entro l’anno","excerpt":"Nuovi dispositivi Apple in arrivo: una nuova Apple TV e un HomePod Mini, con ulteriori novità in preparazione per il lancio entro l’anno.","categoryName":"Smart Home","categorySlug":"smart-home","categoryId":11,"imageUrl":"https://static.techjournal.it/2026/09/HomePod-mini-and-Apple-TV-Sage-768x432.jpg","imageAlt":"HomePod-mini-and-Apple-TV-Sage","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17627,"date":"2026-09-11T12:46:00+02:00","modified":"2026-09-11T10:46:00+00:00","slug":"apple-tv-4k-nuovo-chip-salto-potenza-apple-intelligence","title":"Apple TV 4K: il nuovo chip potrebbe essere un salto di potenza per Apple Intelligence","excerpt":"Le indiscrezioni sulla nuova Apple TV 4K puntano a un chip più moderno e pronto per Apple Intelligence. Ora emergono segnali che suggeriscono un salto di potenza più grande del previsto.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/apple-tv-a19-chip-768x432.jpg","imageAlt":"apple-tv-a19-chip","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17567,"date":"2026-09-10T10:12:00+02:00","modified":"2026-09-09T17:52:23+00:00","slug":"prossimo-apple-tv-4k-chip-a19-ram-8-12-gb","title":"Chip A19 per il prossimo Apple TV 4K: possibili RAM da 8 o 12 GB","excerpt":"Il prossimo Apple TV 4K potrebbe passare a un chip A19 o A19 Pro. In arrivo anche più RAM (8 o 12 GB) e nuove funzioni legate a Siri, rete Wi‑Fi 7 e un Siri Remote aggiornato.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/Where-is-the-New-Apple-TV-Feature-768x432.jpg","imageAlt":"Where-is-the-New-Apple-TV-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17295,"date":"2026-08-29T12:02:00+02:00","modified":"2026-08-29T10:02:00+00:00","slug":"apple-tv-acquista-small-prophets-prima-volta","title":"Apple TV acquista “Small Prophets”: prima volta per un successo già affermato","excerpt":"Apple TV ha acquistato i diritti mondiali di “Small Prophets”, serie inglese già diventata un successo prima dell’arrivo sulla piattaforma. Debutto globale dal 7 ottobre, con eccezione del Regno Unito.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/08/Apple-TV-Color-768x432.jpg","imageAlt":"Apple-TV-Color","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":4,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17238,"date":"2026-08-28T12:02:00+02:00","modified":"2026-08-28T10:02:00+00:00","slug":"ios-27-nuove-funzioni-ai-apple-tv-4k-homepod","title":"iOS 27: nuove funzioni AI in arrivo su Apple TV 4K ed HomePod","excerpt":"Dai primi indizi sul codice di iOS 27 emergono possibili nuove funzioni basate sull’intelligenza artificiale in arrivo su Apple TV 4K e HomePod.","categoryName":"Smart Home","categorySlug":"smart-home","categoryId":11,"imageUrl":"https://static.techjournal.it/2026/08/apple-tv-homepod-siri-ai-768x432.jpg","imageAlt":"apple-tv-homepod-siri-ai","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17055,"date":"2026-08-21T08:44:00+02:00","modified":"2026-08-21T06:44:00+00:00","slug":"macos-26-7-rc-indizi-nuovi-prodotti-apple","title":"macOS 26.7 RC svela indizi su oltre 10 nuovi prodotti Apple","excerpt":"Nel codice di macOS 26.7 Release Candidate compaiono riferimenti a AirPods con fotocamera a infrarossi, iPhone pieghevole, un nuovo hub smart home, MacBook e iPad mini con OLED e un Siri Remote aggiornato per Apple TV.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/08/Apple-Event-Logo-768x432.jpeg","imageAlt":"Apple-Event-Logo","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":5,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17035,"date":"2026-08-20T09:28:00+02:00","modified":"2026-08-20T07:28:00+00:00","slug":"apple-tv-4k-nuova-generazione-a17-pro-siri-ai-wi-fi-7","title":"Apple TV 4K di nuova generazione: chip A17 Pro, Siri AI e Wi‑Fi 7","excerpt":"I rumor indicano almeno cinque novità per la prossima Apple TV 4K: chip A17 Pro (o più recente), più RAM, Siri AI su tvOS 27, chip N1 con Wi‑Fi 7 e un nuovo Siri Remote.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/08/apple-tv-4k-yellow-bg-feature-768x432.jpg","imageAlt":"apple-tv-4k-yellow-bg-feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null}],"heading":"Articoli correlati"}]}]
