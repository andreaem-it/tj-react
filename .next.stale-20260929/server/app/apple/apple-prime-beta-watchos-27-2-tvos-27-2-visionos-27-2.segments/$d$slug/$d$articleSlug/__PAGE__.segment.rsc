c:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L27",null,{"posts":[{"id":17962,"date":"2026-09-21T22:34:52+02:00","modified":"2026-09-21T20:34:52+00:00","slug":"apple-seconda-beta-watchos-27-2-tvos-27-2-visionos-27-2","title":"Apple rilascia le seconde beta di watchOS 27.2, tvOS 27.2 e visionOS 27.2","excerpt":"A una settimana dalla prima tornata, Apple distribuisce le seconde beta di watchOS 27.2, tvOS 27.2 e visionOS 27.2. In parallelo, iOS 27.2 e watchOS 27.2 introducono test per la nuova app Salute con Insights e Longevity.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/General-visionOS-watchOS-and-tvOS-Betas-Feature-Redux-768x432.jpg","imageAlt":"General-visionOS-watchOS-and-tvOS-Betas-Feature-Redux","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16890,"date":"2026-08-11T22:50:23+02:00","modified":"2026-08-11T20:50:23+00:00","slug":"tvos-27-watchos-27-terze-beta-pubbliche","title":"tvOS 27 e watchOS 27: disponibili le terze beta pubbliche","excerpt":"Apple rilascia le terze beta pubbliche di tvOS 27 e watchOS 27, con novità su Siri AI, Smart Stack, Find My e miglioramenti per Apple TV e HomePod.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/08/watchos-27-768x432.jpg","imageAlt":"watchos-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16446,"date":"2026-07-23T09:28:00+02:00","modified":"2026-07-23T07:28:00+00:00","slug":"tvos-27-watchos-27-seconde-beta-pubbliche","title":"tvOS 27 e watchOS 27: disponibili le seconde beta pubbliche","excerpt":"Apple ha rilasciato le seconde beta pubbliche di tvOS 27 e watchOS 27, con novità su Siri AI, Smart Stack, Find My e miglioramenti per Apple TV. In arrivo anche una beta per HomePod e HomePod mini.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/07/watchos-27-768x432.jpg","imageAlt":"watchos-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16247,"date":"2026-07-14T12:02:00+02:00","modified":"2026-07-14T10:02:00+00:00","slug":"tvos-27-watchos-27-prime-beta-pubbliche-disponibili","title":"tvOS 27 e watchOS 27: prime beta pubbliche disponibili","excerpt":"Apple rilascia le prime beta pubbliche di tvOS 27 e watchOS 27, insieme a una beta di HomePod Software 27. Novità su Siri AI, Smart Stack, Find My e Apple Music.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/07/watchos-27-768x432.jpg","imageAlt":"watchos-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":3,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18101,"date":"2026-09-28T16:20:17+02:00","modified":"2026-09-28T14:20:17+00:00","slug":"watchos-27-12-novita-da-provare-su-apple-watch","title":"watchOS 27: 12 novità da provare su Apple Watch","excerpt":"watchOS 27 è disponibile dal 14 settembre. Ecco 12 cambiamenti e funzioni da scoprire, tra Siri dedicato, Smart Stack più intelligente, nuove gesture e aggiornamenti per salute e allenamenti.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/watchOS-27-Hands-On-Thumb-768x432.jpg","imageAlt":"watchOS-27-Hands-On-Thumb","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18097,"date":"2026-09-28T15:35:48+02:00","modified":"2026-09-28T13:35:48+00:00","slug":"apple-tv-screensaver-audio-si-parte-da-snoopy","title":"Apple TV: gli screensaver potrebbero avere l’audio, si parte da Snoopy","excerpt":"Nel codice di tvOS 27 sono emerse impostazioni nascoste per attivare effetti sonori nei salvaschermo di Apple TV. Il primo a beneficiarne potrebbe essere quello dedicato a Snoopy.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/tvos-27-salvaschermo-audio-featured-768x432.jpg","imageAlt":"tvos-27-salvaschermo-audio-featured","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18066,"date":"2026-09-26T08:00:00+02:00","modified":"2026-09-26T06:00:00+00:00","slug":"watchos-27-2-indizi-anteprime-screenshot-stile-iphone-su-apple-watch","title":"watchOS 27.2: indizi di anteprime screenshot “stile iPhone” su Apple Watch","excerpt":"In watchOS 27.2 potrebbero arrivare anteprime degli screenshot su Apple Watch con opzioni per condividerli o eliminarli, in un’esperienza più simile a quella dell’iPhone.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/watchos-27-2-screenshot-768x432.jpg","imageAlt":"watchos-27-2-screenshot","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17171,"date":"2026-08-24T22:20:09+02:00","modified":"2026-08-24T20:20:09+00:00","slug":"apple-rilascia-beta-7-tvos-27-sviluppatori","title":"Apple rilascia la beta 7 di tvOS 27 agli sviluppatori","excerpt":"Apple ha distribuito la settima beta di tvOS 27 agli sviluppatori per i test. Tra le novità: app Podcasts ridisegnata, testo più grande, Control Center più reattivo e miglioramenti in AirPlay.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/08/tvOS-27-Feature-768x432.jpg","imageAlt":"tvOS-27-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":4,"review":null,"changelog":[],"tldr":[],"breaking":null}],"heading":"Articoli correlati"}]}]
