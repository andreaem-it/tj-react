c:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L27",null,{"posts":[{"id":18050,"date":"2026-09-25T09:28:00+02:00","modified":"2026-09-25T07:28:00+00:00","slug":"apple-beta-pubblica-ios-27-2-ipados-27-2-macos-27-2-app-salute","title":"Apple rilascia la beta pubblica di iOS 27.2, iPadOS 27.2 e macOS 27.2: arriva l’app Salute","excerpt":"Disponibile la prima beta pubblica di iOS 27.2, iPadOS 27.2 e macOS 27.2: la nuova app Salute è tra le novità provabili da subito dai tester.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/ios-27.2-beta-1-pubblica-768x432.jpg","imageAlt":"ios-27.2-beta-1-pubblica","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18016,"date":"2026-09-24T09:28:00+02:00","modified":"2026-09-24T07:28:00+00:00","slug":"stili-fotografici-pelle-morbida-texture-anche-su-iphone-precedenti-ios-27","title":"Stili fotografici: “Pelle Morbida” e nuove texture arrivano anche su iPhone precedenti con iOS 27","excerpt":"Con iOS 27 i nuovi controlli per texture e grana degli Stili fotografici, inclusi “Pelle Morbida”, potranno essere usati anche su dispositivi iPhone precedenti.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/ios-27-texture-soft-skin-768x432.jpg","imageAlt":"ios-27-texture-soft-skin","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18009,"date":"2026-09-24T08:22:00+02:00","modified":"2026-09-24T06:22:00+00:00","slug":"apple-limita-texture-e-grain-niente-su-iphone-piu-vecchi","title":"Apple limita Texture e Grain: niente su iPhone più vecchi","excerpt":"I nuovi controlli Texture e Grain per le Photographic Styles in iOS 27 risultano disponibili solo su iPhone 18 Pro e, per iPhone Duo, su specifiche fotocamere. La compatibilità indicata inizialmente per “i modelli che supportano le Photographic Styles” è stata poi ristretta.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/photographic-styles-3402x-768x432.jpg","imageAlt":"photographic-styles-3402x","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18020,"date":"2026-09-23T12:33:22+02:00","modified":"2026-09-23T10:33:22+00:00","slug":"apple-prime-beta-pubbliche-ios-27-2-macos-golden-gate-27-2","title":"Apple avvia le prime beta pubbliche di iOS 27.2 e macOS Golden Gate 27.2","excerpt":"Apple ha rilasciato le prime beta pubbliche di iOS 27.2, iPadOS 27.2, macOS Golden Gate 27.2, tvOS 27.2 e watchOS 27.2. Novità principali: app Salute ridisegnata e nuove opzioni in Apple TV con Siri AI in più lingue.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/iOS-27.2-Next-to-iPhone-768x432.jpg","imageAlt":"iOS-27.2-Next-to-iPhone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17990,"date":"2026-09-22T11:48:25+02:00","modified":"2026-09-22T09:48:25+00:00","slug":"non-si-puo-piu-fare-downgrade-da-ios-27-a-ios-26","title":"Non si può più fare downgrade da iOS 27 a iOS 26","excerpt":"Apple non sta più firmando iOS 26.6.2: dopo l’aggiornamento a iOS 27 non è più possibile tornare a iOS 26. Inoltre non si può passare a iOS 26.7 perché è un aggiornamento OTA senza file di ripristino.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/iOS-27-Feature-Warm-768x432.jpg","imageAlt":"iOS-27-Feature-Warm","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17960,"date":"2026-09-21T22:12:43+02:00","modified":"2026-09-21T20:12:43+00:00","slug":"apple-seconda-beta-ios-27-2","title":"Apple rilascia la seconda beta di iOS 27.2 e aggiorna anche iPadOS","excerpt":"Apple ha distribuito la seconda beta di iOS 27.2 agli sviluppatori, a una settimana dalla prima. Presente anche una beta di iPadOS 27.2, con novità su app Salute e Siri.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/iOS-27.2-Next-to-iPhone-768x432.jpg","imageAlt":"iOS-27.2-Next-to-iPhone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17936,"date":"2026-09-20T09:28:00+02:00","modified":"2026-09-20T07:28:00+00:00","slug":"top-stories-ios-27-macos-golden-gate-siri-ai-waitlist","title":"Top Stories: iOS 27 e macOS Golden Gate disponibili, Siri AI in waitlist e altro","excerpt":"Disponibili iOS 27 e macOS Golden Gate con Siri AI e nuove funzioni. Siri AI richiede una waitlist, iPhone 18 Pro Max negli USA usa un modem diverso e iCloud+ si amplia in oltre 100 paesi.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/top-stories-2026-09-19-768x432.jpg","imageAlt":"top-stories-2026-09-19","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17829,"date":"2026-09-17T09:28:00+02:00","modified":"2026-09-17T07:28:00+00:00","slug":"ios-27-siri-ai-lista-attesa-come-attivarla","title":"iOS 27 e Siri AI: lista d’attesa e come attivarla su iPhone","excerpt":"Dopo l’aggiornamento a iOS 27, Siri AI e l’app dedicata non sono immediatamente disponibili per tutti: serve iscriversi alla lista d’attesa. Ecco i passaggi e i requisiti dei modelli compatibili.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/macO