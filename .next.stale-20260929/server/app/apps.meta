{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[slug]/layout,_N_T_/[slug]/page,_N_T_/apps,tj-post,tj-post:apps,tj-categories,tj-posts"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/_index",
    "/$d$slug/__PAGE__"
  ],
  "prefetchHints": {
    "hints": 0,
    "slots": {
      "children": {
        "hints": 64,
        "slots": {
          "children": {
            "hints": 160,
            "slots": null
          }
        }
      }
    }
  }
}