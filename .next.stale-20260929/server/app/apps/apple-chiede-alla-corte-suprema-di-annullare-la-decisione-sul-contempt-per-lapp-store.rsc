3d:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L45",null,{"posts":[{"id":17792,"date":"2026-09-15T12:46:00+02:00","modified":"2026-09-15T10:46:00+00:00","slug":"xchat-scompare-dall-app-store","title":"L’app di messaggistica standalone XChat di X scompare dall’App Store","excerpt":"L’app di messaggistica standalone XChat di X non risulta più disponibile sull’App Store. Un cambiamento che riporta l’attenzione sulle modalità con cui gli utenti accedono alle chat.","categoryName":"Applicazioni","categorySlug":"applicazioni","categoryId":13,"imageUrl":"https://static.techjournal.it/2026/09/X-twitter-logo-1-768x432.jpg","imageAlt":"X-twitter-logo-1","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17528,"date":"2026-09-09T08:00:00+02:00","modified":"2026-09-09T06:00:00+00:00","slug":"apple-punta-a-guadagnare-di-piu-dall-app-store-reazione-schiller","title":"Apple punta a guadagnare di più dall’App Store: la reazione di Schiller","excerpt":"Apple starebbe cercando nuove modalità per aumentare i ricavi legati all’App Store. La strategia avrebbe però incontrato resistenze interne, con una reazione negativa da parte di Phil Schiller.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/app-store-768x384.webp","imageAlt":"app-store","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17376,"date":"2026-09-02T09:06:00+02:00","modified":"2026-09-02T07:06:00+00:00","slug":"mac-app-store-app-universali-abbandonare-mac-intel","title":"Mac App Store: le app universali possono ora abbandonare i Mac Intel","excerpt":"Apple consente agli sviluppatori di rimuovere il supporto per i Mac Intel per le app universali del Mac App Store che richiedono macOS 13 o successivo. Gli utenti Intel continueranno a usare l’ultima versione compatibile.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/intel-macs-no-more-updates-768x432.jpg","imageAlt":"intel-macs-no-more-updates","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17343,"date":"2026-09-01T09:06:00+02:00","modified":"2026-09-01T07:06:00+00:00","slug":"phil-schiller-lascia-guida-app-store-eventi-apple-torna-eddy-cue","title":"Phil Schiller lascia la guida dell’App Store e degli eventi Apple: lo store torna a Eddy Cue","excerpt":"Phil Schiller lascia la guida dell’App Store e l’organizzazione degli eventi Apple. La responsabilità dello store torna a Eddy Cue, mentre in azienda si completa il passaggio di consegne al vertice.","categoryName":"Applicazioni","categorySlug":"applicazioni","categoryId":13,"imageUrl":"https://static.techjournal.it/2026/09/schiller-app-store-768x432.jpg","imageAlt":"schiller-app-store","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":3,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17045,"date":"2026-08-20T13:30:00+02:00","modified":"2026-08-20T11:30:00+00:00","slug":"apple-cambia-ancora-app-store-europa-cosa-cambia-per-gli-utenti-19-08-2026","title":"Apple cambia ancora l’App Store in Europa: cosa cambia per gli utenti","excerpt":"Apple aggiorna ancora le regole dell’App Store nell’Unione Europea. Ecco i cambiamenti principali che impattano gli utenti.","categoryName":"Applicazioni","categorySlug":"applicazioni","categoryId":13,"imageUrl":"https://static.techjournal.it/2026/08/Apple-Store-App-Liquid-Glass-Feature-768x432.jpg","imageAlt":"Apple-Store-App-Liquid-Glass-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17019,"date":"2026-08-20T08:22:00+02:00","modified":"2026-08-20T06:22:00+00:00","slug":"apple-aggiorna-commissioni-regole-app-store-ue-dma","title":"Apple aggiorna commissioni e regole App Store UE per adeguarsi al Digital Markets Act","excerpt":"Apple modifica commissioni e policy per le app nell’Unione Europea: rimozione di alcune fee, introduzione di una Core Technology Commission al 5% e nuove percentuali per acquisti in-app, pagamenti alternativi e distribuzione via web o marketplace.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/08/apple-app-store-ios-768x432.jpg","imageAlt":"apple-app-store-ios","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16940,"date":"2026-08-15T08:00:00+02:00","modified":"2026-08-15T06:00:00+00:00","slug":"apple-valuta-commissione-fino-al-15-per-link-fuori-dall-app-store","title":"Apple valuta una commissione fino al 15% per i link fuori dall’App Store","excerpt":"Apple starebbe valutando una commissione per gli sviluppatori fino al 15% quando le app includono link che portano fuori dall’App Store.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/08/Liquid-Glass-App-Store-Feature-768x432.jpg","imageAlt":"Liquid-Glass-App-Store-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16932,"date":"2026-08-13T15:17:13+02:00","modified":"2026-08-13T13:17:13+00:00","slug":"corte-suprema-apple-rinvio-24-ore-commissioni-app-store","title":"La Corte Suprema concede ad Apple 24 ore di rinvio nella disputa sulle commissioni dell’App Store","excerpt":"La Corte Suprema ha concesso ad Apple un rinvio di 24 ore nella battaglia legale sulle commissioni dell’App Store, prolungando di un giorno la fase di confronto.","categoryName":"Applicazioni","categorySlug":"applicazioni","categoryId":13,"imageUrl":"https://static.techjournal.it/2026/08/app-store-blue-banner-epic-1-768x432.jpg","imageAlt":"app-store-blue-