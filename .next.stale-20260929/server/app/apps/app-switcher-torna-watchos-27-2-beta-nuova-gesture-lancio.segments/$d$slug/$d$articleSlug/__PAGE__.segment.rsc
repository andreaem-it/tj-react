a:["$","div",null,{"className":"px-3 py-6 md:p-8","children":[null,null,false,["$","div",null,{"id":"article-reading-18014","children":["$","$L1d",null,{"safeHtml":"<p><a href=\"/topic/watchos-27\" class=\"tj-entity-link\">watchOS 27</a>.2 Beta introduce un ritorno atteso: l’<strong>App Switcher</strong> torna sull’orologio, insieme a una <strong>nuova gesture</strong> dedicata al lancio delle app.</p>\n<p>La modifica riguarda quindi sia la gestione rapida delle applicazioni sia il modo in cui l’utente avvia le funzioni dal polso, con l’obiettivo di semplificare l’interazione durante l’uso quotidiano.</p>\n<h2 id=\"cosa-cambia-con-watchos-27-2-beta\">Cosa cambia con watchOS 27.2 Beta</h2>\n<ul>\n<li><strong>Ritorno dell’App Switcher</strong> per passare più rapidamente tra le app.</li>\n<li><strong>Nuova gesture di lancio</strong> per avviare le applicazioni in modo più diretto.</li>\n</ul>\n<h2 id=\"impatto-sull-esperienza-d-uso\">Impatto sull’esperienza d’uso</h2>\n<p>Con l’App Switcher di nuovo disponibile e una gesture aggiornata, l’interazione risulta più orientata alla velocità: meno passaggi per raggiungere ciò che serve e un flusso più immediato tra le app.</p>\n","postId":18014}]}],["$","$L1e",null,{"postId":18014,"targetId":"article-reading-18014"}],false,["$","div",null,{"className":"mt-8 border-t border-border pt-5","children":[["$","h2",null,{"className":"mb-3 text-xs font-semibold uppercase tracking-wide text-muted","children":"Argomenti"}],["$","nav",null,{"aria-label":"Argomenti dell'articolo","children":["$","ul",null,{"className":"flex flex-wrap items-center gap-2","children":[["$","li","watchos-27",{"children":["$","$L3",null,{"prefetch":false,"href":"/topic/watchos-27","className":"inline-flex min-h-11 items-center rounded-full border border-border bg-surface-overlay px-3 py-1 text-xs font-medium text-foreground transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent","children":"watchOS 27"}]}]]}]}]]}],null,null,["$","section",null,{"className":"mt-8 rounded-lg border border-border bg-surface-overlay p-4 md:p-5","aria-labelledby":"tj-story","children":[["$","div",null,{"className":"mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1","children":[["$","h2",null,{"id":"tj-story","className":"text-sm font-semibold uppercase tracking-wide text-muted","children":["Gli sviluppi su ","watchOS 27"]}],["$","$L3",null,{"prefetch":false,"href":"/topic/watchos-27","className":"inline-flex min-h-11 items-center rounded text-sm text-accent hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent","children":[25," articoli →"]}]]}],[["$","p",null,{"className":"mb-2 text-xs font-semibold text-muted","children":"Dopo questo articolo"}],["$","ol",null,{"className":"mb-4 space-y-2 border-l border-border pl-3","children":[["$","li","18042",{"children":["$","$L3",null,{"prefetch":false,"href":"/tech/apple-rilascia-watchos-27-0-1-fix-riavvii-imprevisti","className":"group flex min-h-11 flex-col justify-center rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent","children":[["$","time",null,{"className":"block text-xs uppercase tracking-wide text-muted","dateTime":"2026-09-25T08:00:00+02:00","children":"25 settembre 2026"}],["$","span",null,{"className":"text-sm text-foreground group-hover:text-accent group-hover:underline","children":"Apple rilascia watchOS 27.0.1: fix per riavvii imprevisti"}]]}]}],["$","li","18066",{"children":["$","$L3",null,{"prefetch":false,"href":"/tech/watchos-27-2-indizi-anteprime-screenshot-stile-iphone-su-apple-watch","className":"group flex min-h-11 flex-col justify-center rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent","children":["$L1f","$L20"]}]}],"$L21"]}]],"$L22"]}],null,"$L23"]}]
b:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L24",null,{"posts":[{"id":18101,"date":"2026-09-28T16:20:17+02:00","modified":"2026-09-28T14:20:17+00:00","slug":"watchos-27-12-novita-da-provare-su-apple-watch","title":"watchOS 27: 12 novità da provare su Apple Watch","excerpt":"watchOS 27 è disponibile dal 14 settembre. Ecco 12 cambiamenti e funzioni da scoprire, tra Siri dedicato, Smart Stack più intelligente, nuove gesture e aggiornamenti per salute e allenamenti.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/watchOS-27-Hands-On-Thumb-768x432.jpg","imageAlt":"watchOS-27-Hands-On-Thumb","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18066,"date":"2026-09-26T08:00:00+02:00","modified":"2026-09-26T06:00:00+00:00","slug":"watchos-27-2-indizi-anteprime-screenshot-stile-iphone-su-apple-watch","title":"watchOS 27.2: indizi di anteprime screenshot “stile iPhone” su Apple Watch","excerpt":"In watchOS 27.2 potrebbero arrivare anteprime degli screenshot su Apple Watch con opzioni per condividerli o eliminarli, in un’esperienza più simile a quella dell’iPhone.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/watchos-27-2-screenshot-768x432.jpg","imageAlt":"watchos-27-2-screenshot","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18042,"date":"2026-09-25T08:00:00+02:00","modified":"2026-09-25T06:00:00+00:00","slug":"apple-rilascia-watchos-27-0-1-fix-riavvii-imprevisti","title":"Apple rilascia watchOS 27.0.1: fix per riavvii imprevisti","excerpt":"Apple ha rilasciato watchOS 27.0.1, aggiornamento minore per Apple Watch Series 12 e Apple Watch Ultra 4. Include correzioni di bug e un fix per riavvii inattesi.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/watchos-27-768x432.jpg","imageAlt":"watchos-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17964,"date":"2026-09-21T22:57:12+02:00","modified":"2026-09-21T20:57:12+00:00","slug":"pin-music-in-cima-alla-libreria-su-apple-watch-come-funziona","title":"Pin Music in cima alla libreria su Apple Watch: come funziona","excerpt":"Con watchOS 27 e un abbonamento Apple Music, puoi fissare brani, artisti, album e playlist in cima alla libreria dell’Apple Watch per trovarli e avviarli più velocemente.","categoryName":"Guide","categorySlug":"guide","categoryId":196,"imageUrl":"https://static.techjournal.it/2026/09/pin-music-library-768x432.jpeg","imageAlt":"pin-music-library","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17962,"date":"2026-09-21T22:34:52+02:00","modified":"2026-09-21T20:34:52+00:00","slug":"apple-seconda-beta-watchos-27-2-tvos-27-2-visionos-27-2","title":"Apple rilascia le seconde beta di watchOS 27.2, tvOS 27.2 e visionOS 27.2","excerpt":"A una settimana dalla prima tornata, Apple distribuisce le seconde beta di watchOS 27.2, tvOS 27.2 e visionOS 27.2. In parallelo, iOS 27.2 e watchOS 27.2 introducono test per la nuova app Salute con Insights e Longevity.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/General-visionOS-watchOS-and-tvOS-Betas-Feature-Redux-768x432.jpg","imageAlt":"General-visionOS-watchOS-and-tvOS-Betas-Feature-Redux","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17876,"date":"2026-09-18T09:28:00+02:00","modified":"2026-09-18T07:28:00+00:00","slug":"watchos-27-toglie-funzione-doppio-clic-digital-crown","title":"watchOS 27 toglie una funzione: doppio clic sulla Digital Crown cambia comportamento","excerpt":"Con watchOS 27 Apple introduce Live Rewind sui modelli più recenti, ma il doppio clic sulla Digital Crown perde la funzione di salto tra app: succede sia ai nuovi Apple Watch sia a chi aggiorna modelli precedenti.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/watchos-27-768x432.jpg","imageAlt":"watchos-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17858,"date":"2026-09-18T08:22:00+02:00","modified":"2026-09-18T06:22:00+00:00","slug":"apple-prime-beta-watchos-27-2-tvos-27-2-visionos-27-2","title":"Apple rilascia le prime beta di watchOS 27.2, tvOS 27.2 e visionOS 27.2","excerpt":"Apple ha reso disponibili le prime versioni beta di watchOS 27.2, tvOS 27.2 e visionOS 27.2, aprendo la fase di test per le piattaforme dedicate a Apple Watch, Apple TV e Vision Pro.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/General-visionOS-watchOS-and-tvOS-Betas-Feature-Redux-768x432.jpg","imageAlt":"General-visionOS-watchOS-and-tvOS-Betas-Feature-Redux","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17802,"date":"2026-09-16T12:02:00+02:00","modified":"2026-09-16T10:02:00+00:00","slug":"apple-rilascia-watchos-27-siri-ai-nuove-watch-face-smart-stack","title":"Apple rilascia watchOS 27: Siri AI, nuove watch face e miglioramenti a Smart Stack","excerpt":"watchOS 27 arriva con Siri AI, una nuova watch face e aggiornamenti a Smart Stack, per rendere più immediato l’accesso alle informazioni direttamente dal polso.","categoryName":"Intelligenza Artificiale","categorySlug":"