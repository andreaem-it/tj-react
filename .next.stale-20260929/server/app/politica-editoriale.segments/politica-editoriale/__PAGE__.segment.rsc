3:["$","p",null,{"children":["Quando un rumor si conferma o viene smentito, aggiorniamo l’articolo originale invece di pubblicarne uno nuovo quasi identico, mantenendo traccia delle modifiche in"," ",["$","$L2",null,{"href":"/correzioni","className":"text-accent hover:underline","children":"Correzioni"}],". Per la lista delle fonti che utilizziamo abitualmente, vedi"," ",["$","$L2",null,{"href":"/fonti","className":"text-accent hover:underline","children":"Fonti"}],"."]}]
4:["$","section",null,{"children":[["$","h2",null,{"className":"text-lg font-semibold text-foreground","children":"7. Diversità di punti di vista"}],["$","p",null,{"children":"Riconosciamo la varietà di opinioni nel mondo tech. Cerchiamo di presentare una gamma equilibrata di prospettive, evitando il partigianaggio e garantendo una copertura imparziale dei fatti."}]]}]
5:["$","section",null,{"children":[["$","h2",null,{"className":"text-lg font-semibold text-foreground","children":"8. Responsabilità sociale"}],["$","p",null,{"children":"Ci impegniamo a usare tecnologia e informazione in modo responsabile. Evitiamo la diffusione di notizie false o sensazionalistiche e promuoviamo un uso etico delle tecnologie emergenti."}]]}]
6:["$","section",null,{"children":[["$","h2",null,{"className":"text-lg font-semibold text-foreground","children":"9. Coinvolgimento della community"}],["$","p",null,{"children":"Il feedback dei lettori è benvenuto. Invitiamo chi legge a esprimere opinioni, suggerimenti e correzioni: il dialogo contribuisce a migliorare la qualità del giornale."}]]}]
7:["$","section",null,{"children":[["$","h2",null,{"className":"text-lg font-semibold text-foreground","children":"10. Aggiornamenti"}],["$","p",null,{"children":"La presente politica editoriale può essere rivista e aggiornata periodicamente per riflettere nuove esigenze editoriali, normative o cambiamenti del contesto tecnologico."}]]}]
