3:["$","div",null,{"className":"flex flex-col lg:flex-row gap-8","children":[["$","div",null,{"className":"flex-1 min-w-0","children":["$","$Lf",null,{"initialPosts":[{"id":18044,"date":"2026-09-25T08:22:00+02:00","modified":"2026-09-25T06:22:00+00:00","slug":"apple-sports-aggiornamento-piu-campionati-calcio-tabelloni-tennis-tempo-reale","title":"Apple Sports si aggiorna: più campionati di calcio e tabelloni tennis in tempo reale","excerpt":"L’app Apple Sports riceve un aggiornamento con nuovi campionati di calcio e la possibilità, per i fan del tennis, di seguire i tabelloni dei tornei in tempo reale con risultati e incontri per turno.","categoryName":"Applicazioni","categorySlug":"applicazioni","categoryId":13,"imageUrl":"https://static.techjournal.it/2026/09/Apple-Sports-Feature-768x432.jpg","imageAlt":"Apple-Sports-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18016,"date":"2026-09-24T09:28:00+02:00","modified":"2026-09-24T07:28:00+00:00","slug":"stili-fotografici-pelle-morbida-texture-anche-su-iphone-precedenti-ios-27","title":"Stili fotografici: “Pelle Morbida” e nuove texture arrivano anche su iPhone precedenti con iOS 27","excerpt":"Con iOS 27 i nuovi controlli per texture e grana degli Stili fotografici, inclusi “Pelle Morbida”, potranno essere usati anche su dispositivi iPhone precedenti.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/ios-27-texture-soft-skin-768x432.jpg","imageAlt":"ios-27-texture-soft-skin","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18014,"date":"2026-09-24T09:06:00+02:00","modified":"2026-09-24T07:06:00+00:00","slug":"app-switcher-torna-watchos-27-2-beta-nuova-gesture-lancio","title":"App Switcher torna in watchOS 27.2 Beta con una nuova gesture di lancio","excerpt":"Nella beta di watchOS 27.2 torna l’App Switcher, accompagnato da una nuova gesture per il lancio delle app. Un cambiamento pensato per rendere più rapido il passaggio tra contenuti.","categoryName":"Applicazioni","categorySlug":"applicazioni","categoryId":13,"imageUrl":"https://static.techjournal.it/2026/09/apple-watch-app-switcher-768x432.jpeg","imageAlt":"apple-watch-app-switcher","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18020,"date":"2026-09-23T12:33:22+02:00","modified":"2026-09-23T10:33:22+00:00","slug":"apple-prime-beta-pubbliche-ios-27-2-macos-golden-gate-27-2","title":"Apple avvia le prime beta pubbliche di iOS 27.2 e macOS Golden Gate 27.2","excerpt":"Apple ha rilasciato le prime beta pubbliche di iOS 27.2, iPadOS 27.2, macOS Golden Gate 27.2, tvOS 27.2 e watchOS 27.2. Novità principali: app Salute ridisegnata e nuove opzioni in Apple TV con Siri AI in più lingue.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/iOS-27.2-Next-to-iPhone-768x432.jpg","imageAlt":"iOS-27.2-Next-to-iPhone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18028,"date":"2026-09-23T12:20:25+02:00","modified":"2026-09-23T10:20:25+00:00","slug":"whatsapp-aggiorna-ios-apple-watch-instagram-facebook-nelle-chat-agenti-emoji","title":"WhatsApp aggiorna iOS e Apple Watch: Instagram e Facebook nelle chat, nuove chat con agenti e emoji complete","excerpt":"WhatsApp sta distribuendo tre novità tra iPhone e Apple Watch: condivisione di storie, post e reel di Instagram/Facebook senza uscire dall’app, chat con agenti di terze parti anche su iOS e un set completo di emoji per le reazioni sull’orologio.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/whatsapp-768x432.jpg","imageAlt":"whatsapp","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18022,"date":"2026-09-23T11:12:41+02:00","modified":"2026-09-23T09:12:41+00:00","slug":"shazam-iphone-aggiornamento-icona-sticker-imessage","title":"Shazam per iPhone si aggiorna: nuova icona e sticker per iMessage","excerpt":"Aggiornamento per l’app Shazam su iOS con una nuova icona e un set di sticker da usare in iMessage, anche durante le chiamate FaceTime.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/Shazam-New-Icon-768x432.jpg","imageAlt":"Shazam-New-Icon","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17994,"date":"2026-09-22T14:17:10+02:00","modified":"2026-09-22T12:17:10+00:00","slug":"apple-licenzia-parte-team-fitness-plus-integrazione-app-salute","title":"Apple licenzia parte del team di Fitness+: possibile integrazione in Salute","excerpt":"Apple avrebbe licenziato parte del team di Fitness+. Il servizio potrebbe essere integrato nell’app Salute, con un possibile cambio di strategia per l’esperienza fitness su iPhone e Apple Watch.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/apple-fitness-768x432.jpg","imageAlt":"apple-fitness","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17990,"date":"2026-09-22T11:48:25+02:00","modified":"2026-09-22T09:48:25+00:00","slug":"non-si-puo-piu-fare-downgrade-da-ios-27-a-ios-26","title":"Non si può più fare downgrade da iOS 27 a iOS 26","excerpt":"Apple non sta più firmando iOS 26.6.2: dopo l’aggiornamento a iOS 27 non è più possibile tornare a iOS 26. Inoltre non si può passare a iOS 26.7 perché è un aggiornamento OTA senza file di ripristino.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/iOS-27-Feature-Warm-768x432.jpg","imageAlt":"iOS-27-Feature-Warm","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17992,"date":"2026-09-22T11:42:17+02:00","modified":"2026-09-22T09:42:17+00:00","slug":"magic-diary-diario-ai-terza-persona-privato-iphone","title":"Magic Diary: il diario con l’AI che riscrive le giornate in terza persona, restando privato su iPhone","excerpt":"Magic Diary trasforma i vostri appunti in un racconto in terza persona: l’AI riscrive le giornate mantenendo l’esperienza focalizzata sulla privacy direttamente su iPhone.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/magic-diary-1-768x432.jpg","imageAlt":"magic-diary-1","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17967,"date":"2026-09-22T08:22:00+02:00","modified":"2026-09-22T06:22:00+00:00","slug":"alcuni-utenti-iphone-18-pro-segnalano-problemi-con-face-id","title":"Alcuni utenti iPhone 18 Pro segnalano problemi con Face ID","excerpt":"Alcuni utenti iPhone 18 Pro segnalano difficoltà legate al funzionamento di Face ID. Al momento si tratta di indiscrezioni e non di un quadro ufficiale.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/Face-ID-iPhone-18-Pro-768x432.jpg","imageAlt":"Face-ID-iPhone-18-Pro","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17958,"date":"2026-09-22T08:00:00+02:00","modified":"2026-09-22T06:00:00+00:00","slug":"apple-seconda-beta-macos-golden-gate-27-2-sviluppatori","title":"Apple rilascia la seconda beta di macOS Golden Gate 27.2 agli sviluppatori","excerpt":"Apple sta testando macOS Golden Gate 27.2 e ha reso disponibile agli sviluppatori la seconda beta, a una settimana dalla prima. Novità attesa: Siri AI in nuove lingue.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17960,"date":"2026-09-21T22:12:43+02:00","modified":"2026-09-21T20:12:43+00:00","slug":"apple-seconda-beta-ios-27-2","title":"Apple rilascia la seconda beta di iOS 27.2 e aggiorna anche iPadOS","excerpt":"Apple ha distribuito la seconda beta di iOS 27.2 agli sviluppatori, a una settimana dalla prima. Presente anche una beta di iPadOS 27.2, con novità su app Salute e Siri.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/iOS-27.2-Next-to-iPhone-768x432.jpg","imageAlt":"iOS-27.2-Next-to-iPhone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null}],"initialConsumedPosts":["$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:0:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:1:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:2:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:3:props:children:props:post","$3:props:children:0:props:children:props:initialPosts:0","$3:props:children:0:props:children:props:initialPosts:1","$3:props:children:0:props:children:props:initialPosts:2","$3:props:children:0:props:children:props:initialPosts:3","$3:props:children:0:props:children:props:initialPosts:4","$3:props:children:0:props:children:props:initialPosts:5","$3:props:children:0:props:children:props:initialPosts:6",