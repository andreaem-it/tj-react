b:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L25",null,{"posts":[{"id":17712,"date":"2026-09-13T12:24:00+02:00","modified":"2026-09-13T10:24:00+00:00","slug":"apple-nuovi-accessori-iphone-18-pro-airpods-pro-3-laccetto-polso-custodia-trasparente","title":"Apple presenta i nuovi accessori per iPhone 18 Pro e AirPods Pro 3: laccetto da polso e custodia trasparente aggiornata","excerpt":"Con iPhone 18 Pro e AirPods Pro 3 arrivano nuovi accessori: debutta un laccetto da polso e la custodia trasparente viene aggiornata. Ecco cosa cambia.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/iphone-18-pro-accessori-768x432.jpg","imageAlt":"iphone-18-pro-accessori","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17706,"date":"2026-09-13T09:28:00+02:00","modified":"2026-09-13T07:28:00+00:00","slug":"reminder-airpods-5-senza-cavo-di-ricarica-nella-confezione","title":"Reminder: AirPods 5 senza cavo di ricarica nella confezione","excerpt":"Per chi preordina AirPods 5: Apple non include nella confezione né un cavo USB‑C né un caricatore. Serve procurarseli a parte in base alla versione scelta.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/AirPods-5-Gradient-768x432.jpg","imageAlt":"AirPods-5-Gradient","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17653,"date":"2026-09-11T16:26:00+02:00","modified":"2026-09-11T14:26:00+00:00","slug":"apple-rinnova-accessori-iphone-18-pro-custodie-colori-wrist-strap","title":"Apple rinnova gli accessori per iPhone 18 Pro: nuove custodie, colori e un cinturino da polso inedito","excerpt":"Tornano le custodie trasparenti con anello MagSafe circolare e arrivano nuove opzioni colore. In più, Apple introduce un Wrist Strap compatibile anche con AirPods Pro 3.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/accessori-apple-iphone-18-pro-768x464.png","imageAlt":"accessori-apple-iphone-18-pro","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17635,"date":"2026-09-11T12:46:00+02:00","modified":"2026-09-11T10:46:00+00:00","slug":"apple-presenta-le-airpods-5-ecco-tutte-le-novita","title":"Apple presenta le AirPods 5, ecco tutte le novità","excerpt":"Apple presenta AirPods 5 con cancellazione del rumore migliorata del 50% e qualità audio superiore. Ecco le principali novità annunciate.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/Apple-AirPods-5-hero-260909_big.jpg.large_2x-768x512.jpg","imageAlt":"Apple-AirPods-5-hero-260909_big.jpg.large_2x","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17569,"date":"2026-09-10T10:56:00+02:00","modified":"2026-09-09T17:52:24+00:00","slug":"airpods-turn-10-dieci-anni","title":"AirPods Turn 10: i primi auricolari wireless Apple compiono dieci anni","excerpt":"Il 7 settembre 2016 Apple presentò i primi AirPods: oggi sono passati 10 anni. Nel frattempo, l’azienda continua a vendere EarPods cablati con connettori 3,5 mm, Lightning e USB-C.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/Original-AirPods-iPhone-7-768x437.jpeg","imageAlt":"Original-AirPods-iPhone-7","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17429,"date":"2026-09-03T18:50:41+02:00","modified":"2026-09-03T16:50:41+00:00","slug":"quattro-nuovi-modelli-airpods-in-arrivo-quando-arrivera-ognuno","title":"Quattro nuovi modelli di AirPods in arrivo: ecco come stimare quando arriverà ciascuno","excerpt":"La gamma AirPods di Apple è già ampia, ma le indiscrezioni sui modelli successivi continuano. Facciamo ordine tra i nuovi arrivi e proviamo a stimare le tempistiche per ciascun modello.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/airpods-2027-768x432.jpg","imageAlt":"airpods-2027","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17382,"date":"2026-09-02T12:02:00+02:00","modified":"2026-09-02T10:02:00+00:00","slug":"airpods-con-fotocamere-audio-spaziale-piu-preciso","title":"AirPods con fotocamere: come potrebbero migliorare l’audio spaziale","excerpt":"L’ipotesi di AirPods con fotocamere torna al centro: l’obiettivo sarebbe rendere l’audio spaziale più preciso, grazie a nuove capacità di percezione dell’ambiente.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/CDB8ABC8-8319-4BF1-B792-358368C42154-768x432.png","imageAlt":"CDB8ABC8-8319-4BF1-B792-358368C42154","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17345,"date":"2026-09-01T09:28:00+02:00","modified":"2026-09-01T07:28:00+00:00","slug":"airpods-con-fotocamere-audio-spaziale-rilevamento-schermo","title":"AirPods con fotocamere: audio spaziale più preciso grazie al rilevamento dello schermo","excerpt":"Codice di macOS Tahoe 26.7 suggerisce che AirPods con fotocamere potrebbero migliorare il spatial audio individuando lo schermo guardato dall’utente e restringendo l’audio alla sorgente corretta.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/AirPods-Pro-4-With-Camera-Thumb-768x432.jpg","imageAlt":"AirPods-Pro-4-With-Camera-Thumb","authorName":"","authorAvatarUrl":