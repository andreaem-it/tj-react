33:["$","div",null,{"className":"flex flex-col lg:flex-row gap-8","children":[["$","div",null,{"className":"flex-1 min-w-0","children":["$","$L34",null,{"initialPosts":[{"id":16999,"date":"2026-08-19T09:28:00+02:00","modified":"2026-08-19T07:28:00+00:00","slug":"apple-sesta-beta-visionos-27-sviluppatori","title":"Apple rilascia la sesta beta di visionOS 27 per gli sviluppatori","excerpt":"Apple mette a disposizione degli sviluppatori la sesta beta di visionOS 27, a una settimana dalla quinta. Novità tra Siri AI, ambienti spaziali e miglioramenti all’interfaccia.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/08/curved_windows_visionos-27-768x499.jpg","imageAlt":"curved_windows_visionos-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16865,"date":"2026-08-10T23:04:43+02:00","modified":"2026-08-10T21:04:43+00:00","slug":"apple-mlb-3d-apple-immersive-vision-pro","title":"Apple porta il baseball MLB in 3D su Vision Pro con Apple Immersive","excerpt":"Arriva un nuovo vantaggio per gli utenti Vision Pro: per la prima volta Friday Night Baseball sarà trasmesso in Apple Immersive, con feed 3D registrato in 8K e campo visivo a 180°.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/08/Apple-Friday-Night-Baseball-2026-768x433.jpg","imageAlt":"Apple-Friday-Night-Baseball-2026","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16858,"date":"2026-08-10T22:13:19+02:00","modified":"2026-08-10T20:13:19+00:00","slug":"apple-quinta-beta-visionos-27-sviluppatori","title":"Apple rilascia la quinta beta di visionOS 27 agli sviluppatori","excerpt":"Apple ha distribuito la quinta beta di visionOS 27 agli sviluppatori per i test. Tra le novità: Siri AI, ambienti spaziali da panorama e nuove funzioni per finestre, Centro di Controllo e notifiche.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/08/curved_windows_visionos-27-768x499.jpg","imageAlt":"curved_windows_visionos-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16552,"date":"2026-07-28T09:28:00+02:00","modified":"2026-07-28T07:28:00+00:00","slug":"apple-rilascia-visionos-26-6-per-vision-pro","title":"Apple rilascia visionOS 26.6 per Vision Pro","excerpt":"Apple ha reso disponibile visionOS 26.6, il sesto aggiornamento del sistema per Vision Pro. Include correzioni, miglioramenti di sicurezza e ottimizzazioni per Spotlight in vista di visionOS 27.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/07/visionOS-26-Feature-768x432.jpg","imageAlt":"visionOS-26-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16397,"date":"2026-07-21T12:02:00+02:00","modified":"2026-07-21T10:02:00+00:00","slug":"apple-rilascia-release-candidate-watchos-26-6-tvos-26-6-visionos-26-6","title":"Apple rilascia i Release Candidate di watchOS 26.6, tvOS 26.6 e visionOS 26.6","excerpt":"Apple mette a disposizione dei developer i Release Candidate di watchOS 26.6, tvOS 26.6 e visionOS 26.6. Sono la fase finale prima del rilascio pubblico, salvo problemi emersi durante i test.","categoryName":"Vision Pro","categorySlug":"vision-pro","categoryId":989,"imageUrl":"https://static.techjournal.it/2026/07/General-visionOS-watchOS-and-tvOS-Betas-Feature-Redux-768x432.jpg","imageAlt":"General-visionOS-watchOS-and-tvOS-Betas-Feature-Redux","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16387,"date":"2026-07-21T08:44:00+02:00","modified":"2026-07-21T06:44:00+00:00","slug":"apple-quarta-beta-visionos-27-sviluppatori","title":"Apple rilascia la quarta beta di visionOS 27 agli sviluppatori","excerpt":"Apple ha distribuito agli sviluppatori la quarta beta di visionOS 27. Tra le novità: Siri AI, ambienti spaziali da foto panorama, nuove opzioni per Web Environment e miglioramenti all’interfaccia.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/07/curved_windows_visionos-27-768x499.jpg","imageAlt":"curved_windows_visionos-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":4,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16387,"date":"2026-07-21T08:44:00+02:00","modified":"2026-07-21T06:44:00+00:00","slug":"apple-quarta-beta-visionos-27-sviluppatori","title":"Apple rilascia la quarta beta di visionOS 27 agli sviluppatori","excerpt":"Apple ha distribuito agli sviluppatori la quarta beta di visionOS 27. Tra le novità: Siri AI, ambienti spaziali da foto panorama, nuove opzioni per Web Environment e miglioramenti all’interfaccia.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/07/curved_windows_visionos-27-768x499.jpg","imageAlt":"curved_windows_visionos-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":4,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16095,"date":"2026-07-09T12:24:00+02:00","modified":"2026-07-09T10:24:00+00:00","slug":"report-display-piu-economici-apple-vision-pro-rallenta-samsung","title":"Report: la produzione di display più economici per Apple Vision Pro rallenta in Samsung","excerpt":"Un report indica che il lavoro sui display più economici destinati ad Apple Vision Pro sta rallentando presso Samsung, segnalando possibili cambiamenti nelle tempistiche di fornitura.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/07/Vision-Pro-M5-Announcement-768x423.jpg","imageAlt":"Vision-Pro-M5-Announcement","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":4,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16040,"date":"2026-07-07T09:28:00+02:00","modified":"2026-07-07T07:28:00+00:00","slug":"apple-terza-beta-visionos-27-agli-sviluppatori","title":"Apple rilascia la terza beta di visionOS 27 agli sviluppatori","excerpt":"La terza beta di visionOS 27 arriva agli sviluppatori a due settimane dalla precedente. Tra le novità: Siri AI, ambienti spaziali da panorama, supporto Web Environment e nuove modifiche all’interfaccia.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/07/curved_windows_visionos-27-768x499.jpg","imageAlt":"curved_windows_visionos-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":5,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":15824,"date":"2026-06-29T08:22:00+02:00","modified":"2026-06-29T06:22:00+00:00","slug":"apple-perde-paul-meade-addio-vision-pro-occhiali-smart","title":"Apple perde Paul Meade: addio al Vision Pro e ai futuri occhiali smart","excerpt":"Paul Meade, dirigente alla guida dei Vision Products di Apple, sarebbe in procinto di lasciare l’azienda per passare ad OpenAI. Un altro cambio ai vertici nel settore Vision Pro e occhiali smart.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/06/apple-paul-meade-lascia-openai-vision-pro-occhiali-smart-768x432.jpg","imageAlt":"apple-paul-meade-lascia-openai-vision-pro-occhiali-smart","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":15725,"date":"2026-06-24T12:02:00+02:00","modified":"2026-06-24T10:02:00+00:00","slug":"reality-composer-pro-3-tracce-the-machinery","title":"Reality Composer Pro 3: tracce di “The Machinery” nel codice","excerpt":"Una beta di Reality Composer Pro 3, lo strumento Apple per creare esperienze spaziali su Vision Pro, include riferimenti a “The Machinery”, progetto di sviluppo giochi poi interrotto nel 2022.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/06/apple-vision-pro-orange-768x432.jpg","imageAlt":"apple-vision-pro-orange","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":15703,"date":"2026-06-23T12:02:00+02:00","modified":"2026-06-23T10:02:00+00:00","slug":"apple-seconda-beta-visionos-27-sviluppatori","title":"Apple rilascia la seconda beta di visionOS 27 agli sviluppatori","excerpt":"La seconda beta di visionOS 27 arriva agli sviluppatori a due settimane dalla prima. Tra le novità: Siri AI, ambienti spaziali da panorama, nuove opzioni per Web Environment e miglioramenti all’interfaccia.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/06/curved_windows_visionos-27-768x499.jpg","imageAlt":"curved_windows_visionos-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":3,"review":null,"changelog":[],"tldr":[],"breaking":null}],"initialConsumedPosts":["$29:props:children:2:props:children:props:children:0:props:children:props:post","$29:props:children:2:props:children:props:children:1:props:children:props:post","$29:props:children:2:props:children:props:children:2:props:children:props:post","$29:props:children:2:props:children:props:children:3:props:children:props:post","$33:props:children:0:props:children:props:initialPosts:0","$33:props:children:0:props:children:props:initialPosts:1","$33:props:children:0:props:children:props:initialPosts:2","$33:props:child