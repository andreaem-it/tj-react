0:{"buildId":"9TlFmGfeM2r8bkklJXHxo","data":[{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"w-full min-w-0 max-w-7xl mx-auto px-[5px] md:px-4 py-6","children":[["$","h1",null,{"className":"sr-only","children":"Wi-Fi: ultime notizie e articoli"}],"$undefined",["$","section",null,{"className":"w-full mb-6 md:mb-8","children":["$","div",null,{"className":"grid grid-cols-1 lg:grid-cols-12 lg:grid-rows-2 gap-2 md:gap-3","children":[["$","div",null,{"className":"relative lg:col-start-1 lg:col-span-6 lg:row-span-2 min-h-[240px] sm:min-h-[280px] lg:min-h-[320px]","children":["$","$L2",null,{"post":{"id":8457,"date":"2024-01-10T17:17:30+01:00","modified":"2024-01-10T16:20:46+00:00","slug":"annunciato-wi-fi-7-le-prestazioni-saranno-incredibili","title":"Annunciato Wi-Fi 7, le prestazioni saranno incredibili","excerpt":"Lo standard Wi-Fi 7 segna una svolta significativa nella connettività wireless, offrendo prestazioni notevolmente migliorate rispetto al suo predecessore, il Wi-Fi 6E. Con una velocità di trasferimento massima di 46 Gbps, cinque volte superiore a quella del Wi-Fi 6E, questa nuova generazione promette di rivoluzionare il modo in cui interagiamo con la tecnologia. Una delle…","categoryName":"Wi-Fi","categorySlug":"wi-fi","categoryId":6,"imageUrl":"https://static.techjournal.it/2024/01/j-768x346.webp","imageAlt":"j","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":3762,"review":null,"changelog":[],"tldr":[],"breaking":null},"variant":"hero","size":"large","priority":true}]}],["$","div",null,{"className":"relative lg:col-start-7 lg:col-span-3 lg:row-span-2 min-h-[160px] sm:min-h-[190px] lg:min-h-[320px]","children":["$","$L2",null,{"post":{"id":44,"date":"2020-02-15T02:27:36+01:00","modified":"2020-02-15T13:24:29+00:00","slug":"wi-fi-6-nuovo-standard-rilasciato","title":"Wi-Fi 6, nuovo standard rilasciato","excerpt":"La novità è più sostanziale che formale, ma sarà sicuramente apprezzata dai moltissimi utenti che, per un motivo o per l'altro, hanno a che fare con dispositivi Wi-Fi. L'Institute of Electrical and Electronic Engineers (spesso abbreviato in IEEE) ha annunciato la propria intenzione di cambiare nome agli standard Wi-Fi così da renderli immediatamente riconoscibili e facilitare il compito degli…","categoryName":"Wi-Fi","categorySlug":"wi-fi","categoryId":6,"imageUrl":"https://static.techjournal.it/2020/02/wifi-6-696x398-1-768x439.png","imageAlt":"wifi 6 696x398 1","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":4601,"review":null,"changelog":[],"tldr":[],"breaking":null},"variant":"hero","size":"medium"}]}],["$","div",null,{"className":"relative lg:col-start-10 lg:col-span-3 lg:row-span-2 min-h-[160px] sm:min-h-[190px] lg:min-h-[320px]"}],false]}]}],"$undefined",["$","div",null,{"className":"flex flex-col lg:flex-row gap-8","children":[["$","div",null,{"className":"flex-1 min-w-0","children":["$","$L3",null,{"initialPosts":[],"initialConsumedPosts":["$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:0:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:1:props:children:props:post"],"initialTotalPages":1,"initialPagesConsumed":1,"categoryId":6,"emptyGridIsExpected":true}]}],["$","div",null,{"className":"flex flex-col gap-6 lg:w-[320px] shrink-0","children":[["$","$L4",null,{}],["$","aside",null,{"className":"w-full shrink-0 rounded-surface bg-sidebar-bg p-panel lg:w-[320px]","children":[["$","h2",null,{"className":"text-foreground font-bold text-lg mb-4","children":"Offerte"}],["$","div",null,{"className":"space-y-3","children":[["$","$L5","17825",{"href":"/offerte/airpods-5-hands-on-migliore-cancellazione-rumore-prezzo-basso