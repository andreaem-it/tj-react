3:["$","div",null,{"className":"flex flex-col lg:flex-row gap-8","children":[["$","div",null,{"className":"flex-1 min-w-0","children":["$","$Lf",null,{"initialPosts":[{"id":18037,"date":"2026-09-24T12:46:00+02:00","modified":"2026-09-24T10:46:00+00:00","slug":"mac-studio-m5-max-m5-ultra-prime-recensioni-prezzo-altissimo","title":"Mac Studio M5 Max ed M5 Ultra, le prime recensioni: il Mac più potente di sempre, ma il prezzo arriva a cifre altissime","excerpt":"Le prime recensioni di Mac Studio con chip M5 Max e M5 Ultra lo descrivono come il Mac più potente mai realizzato, ma con un listino che può raggiungere cifre molto elevate.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/mac-studio-2026-review-768x432.jpg","imageAlt":"mac-studio-2026-review","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18020,"date":"2026-09-23T12:33:22+02:00","modified":"2026-09-23T10:33:22+00:00","slug":"apple-prime-beta-pubbliche-ios-27-2-macos-golden-gate-27-2","title":"Apple avvia le prime beta pubbliche di iOS 27.2 e macOS Golden Gate 27.2","excerpt":"Apple ha rilasciato le prime beta pubbliche di iOS 27.2, iPadOS 27.2, macOS Golden Gate 27.2, tvOS 27.2 e watchOS 27.2. Novità principali: app Salute ridisegnata e nuove opzioni in Apple TV con Siri AI in più lingue.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/iOS-27.2-Next-to-iPhone-768x432.jpg","imageAlt":"iOS-27.2-Next-to-iPhone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17969,"date":"2026-09-22T08:44:00+02:00","modified":"2026-09-22T06:44:00+00:00","slug":"nuovi-mac-mini-e-mac-studio-in-arrivo-domani-chip-m6-m5-pro-m5-max-m5-ultra","title":"Nuovi Mac mini e Mac Studio in arrivo domani: chip M6, M5 Pro, M5 Max e M5 Ultra","excerpt":"Apple prepara il lancio dei nuovi Mac mini e Mac Studio per martedì 22 settembre: aggiornamenti di specifiche con chip M6, M5 Pro, M5 Max e M5 Ultra, senza cambiamenti di design rilevanti.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/Mac-mini-vs-Studio-Feature-Sans-Text-1-768x432.jpg","imageAlt":"Mac-mini-vs-Studio-Feature-Sans-Text-1","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17958,"date":"2026-09-22T08:00:00+02:00","modified":"2026-09-22T06:00:00+00:00","slug":"apple-seconda-beta-macos-golden-gate-27-2-sviluppatori","title":"Apple rilascia la seconda beta di macOS Golden Gate 27.2 agli sviluppatori","excerpt":"Apple sta testando macOS Golden Gate 27.2 e ha reso disponibile agli sviluppatori la seconda beta, a una settimana dalla prima. Novità attesa: Siri AI in nuove lingue.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17856,"date":"2026-09-18T08:00:00+02:00","modified":"2026-09-18T06:00:00+00:00","slug":"apple-prima-beta-macos-golden-gate-27-2-sviluppatori","title":"Apple rilascia la prima beta di macOS Golden Gate 27.2 agli sviluppatori","excerpt":"Apple avvia la beta di macOS Golden Gate 27.2 per gli sviluppatori. Il test arriva a pochi giorni dal rilascio di macOS Golden Gate 27.0 e riaccende le attese su funzioni di Apple Intelligence e su Suggestions in Messaggi.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17848,"date":"2026-09-17T12:46:00+02:00","modified":"2026-09-17T10:46:00+00:00","slug":"macos-27-interrompe-backup-time-machine-airport-time-capsule","title":"Reminder: macOS 27 interrompe i backup Time Machine su AirPort Time Capsule","excerpt":"Con macOS 27, Time Machine non potrà più eseguire backup su AirPort Time Capsule: viene rimosso il supporto AFP e i backup passano esclusivamente a SMB.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/time-capsule-768x432.jpg","imageAlt":"time-capsule","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17831,"date":"2026-09-17T12:02:00+02:00","modified":"2026-09-17T10:02:00+00:00","slug":"primo-benchmark-chip-m5-ultra-boost-prestazionale","title":"Primo benchmark per il chip M5 Ultra: boost prestazionale in evidenza","excerpt":"Il primo risultato di benchmark relativo al chip M5 Ultra mostra un incremento delle prestazioni, offrendo un primo assaggio della nuova generazione di silicio orientata all’AI.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/M5-Ultra-Hero-768x432.jpeg","imageAlt":"M5-Ultra-Hero","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17821,"date":"2026-09-16T12:02:00+02:00","modified":"2026-09-16T10:02:00+00:00","slug":"ultimo-imac-intel-21-5-2019-vintage-apple","title":"L’ultimo iMac Intel da 21,5” 4K del 2019 entra nella lista Vintage Apple","excerpt":"Apple ha aggiunto l’iMac 2019 21,5” 4K alla lista dei prodotti Vintage: le riparazioni sono possibili solo se sono disponibili i ricambi.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/iMac-Blue-Isolated-768x432.jpg","imageAlt":"iMac-Blue-Isolated","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17798,"date":"2026-09-16T09:06:00+02:00","modified":"2026-09-16T07:06:00+00:00","slug":"apple-rilascia-macos-tahoe-26-7-e-macos-sequoia-15-8","title":"Apple rilascia macOS Tahoe 26.7 e macOS Sequoia 15.8","excerpt":"Apple ha pubblicato macOS Tahoe 26.7 e macOS Sequoia 15.8. Gli aggiornamenti includono correzioni di sicurezza e si scaricano da Impostazioni di Sistema > Aggiornamento software.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/macos-tahoe-768x432.jpg","imageAlt":"macos-tahoe","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17786,"date":"2026-09-16T08:22:00+02:00","modified":"2026-09-16T06:22:00+00:00","slug":"macbook-pro-oled-touch-macos-27-1","title":"MacBook Pro con schermo OLED touch e macOS 27.1: cosa sappiamo","excerpt":"Un nuovo MacBook Pro con display OLED touch e l’arrivo di macOS 27.1 sono al centro delle indiscrezioni: ecco i punti chiave su ciò che è stato indicato.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/Apple-MacBook-Pro-M4-hero-768x432.jpg","imageAlt":"Apple-MacBook-Pro-M4-hero","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17754,"date":"2026-09-14T08:22:00+02:00","modified":"2026-09-14T06:22:00+00:00","slug":"animazione-apertura-iphone-duo-arriva-su-macbook-mac-duo","title":"L’animazione di apertura di iPhone Duo arriva sul MacBook: Mac Duo è gratis, open source e ha sei effetti","excerpt":"L’animazione di sfocatura prospettica di iPhone Duo, che segnala il passaggio tra display all’apertura o alla chiusura, arriva su MacBook con Mac Duo: progetto gratuito, open source e con sei effetti.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/mac-duo-effetto-apertura-768x432.jpg","imageAlt":"mac-duo-effetto-apertura","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17539,"date":"2026-09-08T12:18:27+02:00","modified":"2026-09-08T10:18:27+00:00","slug":"macbook-pieghevole-apple-non-avrebbe-chiuso-progetto-piu-lontano-del-previsto","title":"MacBook pieghevole, Apple non avrebbe chiuso il progetto: è solo molto più lontano del previsto","excerpt":"Nuovi elementi sulla roadmap di Mac e iPad suggeriscono che il MacBook pieghevole non sarebbe stato cancellato, ma rimandato più in là rispetto alle attese.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/macbook-pieghevole-768x432.jpg","imageAlt":"macbook-pieghevole","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null}],"initialConsumedPosts":["$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:0:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:1:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:2:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:3:props:children:props:post","$3:props:children:0:props:children:props:initialPosts:0","$3:props:children:0:props:children:props:initialPosts:1","$3:props:children:0:props:children:props:initialPosts:2","$3:props:children:0:props:children:props:initialPosts:3","$3:props:children:0:props:children:props:initialPosts:4","$3:props:children:0:props:children:props:initialPosts:5","$3:props:children:0:props:children:props:initialPosts:6","$3:props:children:0:prop