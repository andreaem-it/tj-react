    "/_full",
    "/_index",
    "/$d$slug/$d$articleSlug/__PAGE__"
  ],
  "prefetchHints": {
    "hints": 0,
    "slots": {
      "children": {
        "hints": 64,
        "slots": {
          "children": {
            "hints": 96,
            "slots": {
              "children": {
