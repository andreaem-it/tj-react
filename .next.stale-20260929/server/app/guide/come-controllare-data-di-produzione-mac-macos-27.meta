  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[slug]/layout,_N_T_/[slug]/[articleSlug]/layout,_N_T_/[slug]/[articleSlug]/page,_N_T_/guide/come-controllare-data-di-produzione-mac-macos-27,tj-post,tj-post:come-controllare-data-di-produzione-mac-macos-27,tj-categories,tj-posts"
  },
  "segmentPaths": [
