40:["$","footer",null,{"className":"mt-8 pt-6 pb-6 border-t border-border px-3 md:px-8","children":["$","$L4d",null,{"posts":[{"id":18101,"date":"2026-09-28T16:20:17+02:00","modified":"2026-09-28T14:20:17+00:00","slug":"watchos-27-12-novita-da-provare-su-apple-watch","title":"watchOS 27: 12 novità da provare su Apple Watch","excerpt":"watchOS 27 è disponibile dal 14 settembre. Ecco 12 cambiamenti e funzioni da scoprire, tra Siri dedicato, Smart Stack più intelligente, nuove gesture e aggiornamenti per salute e allenamenti.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/watchOS-27-Hands-On-Thumb-768x432.jpg","imageAlt":"watchOS-27-Hands-On-Thumb","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17621,"date":"2026-09-11T09:28:00+02:00","modified":"2026-09-11T07:28:00+00:00","slug":"apple-watch-series-12-ultra-4-audio-intelligence","title":"Apple Watch Series 12 e Ultra 4: arrivano le nuove funzioni “Audio Intelligence”","excerpt":"Apple annuncia “Audio Intelligence” per Apple Watch Series 12 e Apple Watch Ultra 4: Siri Recap, Live Rewind, Shazam e Sound Recognition. Funzioni in beta più avanti nel 2026.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/apple-watch-series-12-768x432.jpg","imageAlt":"apple-watch-series-12","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18066,"date":"2026-09-26T08:00:00+02:00","modified":"2026-09-26T06:00:00+00:00","slug":"watchos-27-2-indizi-anteprime-screenshot-stile-iphone-su-apple-watch","title":"watchOS 27.2: indizi di anteprime screenshot “stile iPhone” su Apple Watch","excerpt":"In watchOS 27.2 potrebbero arrivare anteprime degli screenshot su Apple Watch con opzioni per condividerli o eliminarli, in un’esperienza più simile a quella dell’iPhone.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/watchos-27-2-screenshot-768x432.jpg","imageAlt":"watchos-27-2-screenshot","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18042,"date":"2026-09-25T08:00:00+02:00","modified":"2026-09-25T06:00:00+00:00","slug":"apple-rilascia-watchos-27-0-1-fix-riavvii-imprevisti","title":"Apple rilascia watchOS 27.0.1: fix per riavvii imprevisti","excerpt":"Apple ha rilasciato watchOS 27.0.1, aggiornamento minore per Apple Watch Series 12 e Apple Watch Ultra 4. Include correzioni di bug e un fix per riavvii inattesi.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/watchos-27-768x432.jpg","imageAlt":"watchos-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18028,"date":"2026-09-23T12:20:25+02:00","modified":"2026-09-23T10:20:25+00:00","slug":"whatsapp-aggiorna-ios-apple-watch-instagram-facebook-nelle-chat-agenti-emoji","title":"WhatsApp aggiorna iOS e Apple Watch: Instagram e Facebook nelle chat, nuove chat con agenti e emoji complete","excerpt":"WhatsApp sta distribuendo tre novità tra iPhone e Apple Watch: condivisione di storie, post e reel di Instagram/Facebook senza uscire dall’app, chat con agenti di terze parti anche su iOS e un set completo di emoji per le reazioni sull’orologio.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/whatsapp-768x432.jpg","imageAlt":"whatsapp","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17980,"date":"2026-09-23T08:00:00+02:00","modified":"2026-09-23T06:00:00+00:00","slug":"apple-watch-series-12-ultra-4-riavvii-inattesi","title":"Apple Watch Series 12 e Ultra 4: segnalati riavvii inattesi","excerpt":"Alcuni proprietari di Apple Watch Series 12 e Ultra 4 segnalano riavvii inattesi. Un problema che, al momento, resta circoscritto alle segnalazioni degli utenti.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/apple-watch-s12-ultra-4-768x432.jpg","imageAlt":"apple-watch-s12-ultra-4","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17999,"date":"2026-09-22T22:20:47+02:00","modified":"2026-09-22T20:20:47+00:00","slug":"apple-watch-series-10-vs-series-12-guida-aggiornamento","title":"Apple Watch Series 10 vs Series 12: guida all’upgrade","excerpt":"Apple Watch Series 12 introduce un nuovo chip, RAM doppia, sensori salute ridisegnati, 5G e nuove funzioni audio. Ecco quando conviene davvero passare da Series 10.","categoryName":"Guide","categorySlug":"guide","categoryId":196,"imageUrl":"https://static.techjournal.it/2026/09/apple-watch-series-10-gold-titanium-768x432.jpg","imageAlt":"apple-watch-series-10-gold-titanium","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17994,"date":"2026-09-22T14:17:10+02:00","modified":"2026-09-22T12:17:10+00:00","slug":"apple-licenzia-parte-team-fitness-plus-integrazione-app-salute","title":"Apple licenzia parte del team di Fitness+: possibile integrazione in Salute","excerpt":"Apple avrebbe licenziato parte del team di Fitness+. Il servizio potrebbe essere integrato nell’app Salute, con un possibile cambio di strategia per l’esperienza fitness su iPhone e Apple Watch.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/apple-fitness-768x432.jpg","imageAlt":"apple-fitness","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null}],"heading":"Articoli correlati"}]}]
