3:["$","div",null,{"className":"flex flex-col lg:flex-row gap-8","children":[["$","div",null,{"className":"flex-1 min-w-0","children":["$","$Lf",null,{"initialPosts":[{"id":18103,"date":"2026-09-28T15:00:49+02:00","modified":"2026-09-28T13:03:57+00:00","slug":"apple-valuta-quattro-concept-nuovo-headset-vision-pro","title":"Apple valuta quattro concept per un nuovo headset Vision Pro","excerpt":"Apple starebbe esplorando quattro diverse idee per un nuovo headset legato alla linea Vision Pro, con l’obiettivo di definire forme, funzionalità e approcci di prodotto differenti.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/Vision-Pro-M5-Announcement-768x423.jpg","imageAlt":"Vision-Pro-M5-Announcement","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18087,"date":"2026-09-26T12:02:00+02:00","modified":"2026-09-26T10:02:00+00:00","slug":"macos-golden-gate-cosa-sparisce-e-cosa-cambia-con-macos-28","title":"macOS Golden Gate: cosa sparisce oggi e cosa cambia con macOS 28","excerpt":"Con macOS Golden Gate Apple taglia supporto per Intel, Boot Camp, Rosetta 2 (in modo definitivo) e servizi legacy come AFP, Time Capsule e AirPort Utility. Ulteriori riduzioni sono attese con macOS 28.","categoryName":"Mac","categorySlug":"mac","categoryId":12,"imageUrl":"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg","imageAlt":"macOS-27-next-to-MacBook-Pro-Running-macOS-27","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18085,"date":"2026-09-26T09:28:00+02:00","modified":"2026-09-26T07:28:00+00:00","slug":"come-controllare-data-di-produzione-mac-macos-27","title":"Come controllare la data di produzione del tuo Mac in macOS 27","excerpt":"Con macOS 27 Golden Gate puoi risalire alla data di produzione del tuo Mac tramite la sezione “Regulatory Certification” nel System Report.","categoryName":"Guide","categorySlug":"guide","categoryId":196,"imageUrl":"https://static.techjournal.it/2026/09/2026-mac-mini-blue-768x432.jpeg","imageAlt":"2026-mac-mini-blue","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18074,"date":"2026-09-26T09:06:00+02:00","modified":"2026-09-26T07:06:00+00:00","slug":"texture-grana-stili-fotografici-solo-iphone-18-pro-duo-apple-aggiorna-comunicato","title":"Texture e grana degli Stili fotografici solo su iPhone 18 Pro e Duo: Apple aggiorna il comunicato","excerpt":"Apple ha corretto la nota del comunicato stampa italiano di iPhone 18 Pro: i nuovi controlli per texture e grana degli Stili fotografici non arriveranno su iPhone 16, iPhone 17 e iPhone Air, ma risultano riservati a iPhone 18 Pro e Duo.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/texture-pelle-morbida-stile-fotografico-ios-27-iphone-768x432.jpg","imageAlt":"texture-pelle-morbida-stile-fotografico-ios-27-iphone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18072,"date":"2026-09-26T08:44:00+02:00","modified":"2026-09-26T06:44:00+00:00","slug":"apple-conferma-aggiornamento-bugfix-iphone-18-pro-prossima-settimana","title":"Apple conferma: aggiornamento di correzione bug per iPhone 18 Pro la prossima settimana","excerpt":"Apple ha confermato l’arrivo di un aggiornamento di correzione bug per iPhone 18 Pro la prossima settimana, con l’obiettivo di migliorare stabilità e prestazioni.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/Face-ID-iPhone-18-Pro-768x432.jpg","imageAlt":"Face-ID-iPhone-18-Pro","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18068,"date":"2026-09-26T08:22:00+02:00","modified":"2026-09-26T06:22:00+00:00","slug":"square-annuncia-integrazione-apple-business","title":"Square annuncia l’integrazione con Apple Business per aggiornare i dati","excerpt":"Square introduce una nuova integrazione con Apple Business per aiutare le attività a mantenere informazioni aggiornate su Apple Maps, Apple Wallet e Siri AI direttamente dal Dashboard.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/Square-Apple-Maps-768x432.jpeg","imageAlt":"Square-Apple-Maps","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18066,"date":"2026-09-26T08:00:00+02:00","modified":"2026-09-26T06:00:00+00:00","slug":"watchos-27-2-indizi-anteprime-screenshot-stile-iphone-su-apple-watch","title":"watchOS 27.2: indizi di anteprime screenshot “stile iPhone” su Apple Watch","excerpt":"In watchOS 27.2 potrebbero arrivare anteprime degli screenshot su Apple Watch con opzioni per condividerli o eliminarli, in un’esperienza più simile a quella dell’iPhone.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/watchos-27-2-screenshot-768x432.jpg","imageAlt":"watchos-27-2-screenshot","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18058,"date":"2026-09-25T12:02:00+02:00","modified":"2026-09-25T10:02:00+00:00","slug":"copland-apple-prova-os-in-browser-emulazione","title":"Copland di Apple torna a vivere: prova l’OS in emulazione direttamente dal browser","excerpt":"Dopo anni di sviluppo e cancellazione, Copland può finalmente essere provato in emulazione: grazie a modifiche a DingusPPC, è disponibile una versione avviabile nel browser.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/mac-copland-os-768x432.jpg","imageAlt":"mac-copland-os","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18070,"date":"2026-09-25T12:02:00+02:00","modified":"2026-09-25T10:02:00+00:00","slug":"qualcomm-rinnova-accordo-globale-licenza-brevetti-apple-2027","title":"Qualcomm rinnova l’accordo globale di licenza brevetti con Apple","excerpt":"Qualcomm ha annunciato il rinnovo dell’accordo globale di licenza brevetti con Apple, con efficacia dal 1° aprile 2027. L’intesa è separata dal contratto per i modem cellulari.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/Qualcomm-Apple-Logos-768x432.jpg","imageAlt":"Qualcomm-Apple-Logos","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18050,"date":"2026-09-25T09:28:00+02:00","modified":"2026-09-25T07:28:00+00:00","slug":"apple-beta-pubblica-ios-27-2-ipados-27-2-macos-27-2-app-salute","title":"Apple rilascia la beta pubblica di iOS 27.2, iPadOS 27.2 e macOS 27.2: arriva l’app Salute","excerpt":"Disponibile la prima beta pubblica di iOS 27.2, iPadOS 27.2 e macOS 27.2: la nuova app Salute è tra le novità provabili da subito dai tester.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/ios-27.2-beta-1-pubblica-768x432.jpg","imageAlt":"ios-27.2-beta-1-pubblica","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18048,"date":"2026-09-25T09:06:00+02:00","modified":"2026-09-25T07:06:00+00:00","slug":"tim-cook-incontra-ursula-von-der-leyen-eu-kids-act-social-minori","title":"Tim Cook incontra Ursula von der Leyen: sul tavolo l’EU Kids Act per limitare i social ai minori","excerpt":"Tim Cook ha incontrato Ursula von der Leyen a Manhattan. Al centro del colloquio l’EU Kids Act, proposta UE per limitare l’accesso dei minori ai social e imporre nuove tutele alle piattaforme.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/tim-cook-ursula-europa-eu-kids-act-768x432.jpg","imageAlt":"tim-cook-ursula-europa-eu-kids-act","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18046,"date":"2026-09-25T08:44:00+02:00","modified":"2026-09-25T06:44:00+00:00","slug":"apple-intelligence-oltre-30gb-su-alcuni-mac-con-macos-27-golden-gate","title":"Apple Intelligence supera i 30GB su alcuni Mac con macOS 27 Golden Gate","excerpt":"Dopo l’installazione di macOS 27 Golden Gate, Apple Intelligence può scaricare modelli AI multi‑gigabyte sul Mac. In alcuni casi lo spazio occupato supera i 30GB, anche oltre le soglie indicate da Apple.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/apple-intelligence-black-768x432.jpeg","imageAlt":"apple-intelligence-black","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null}],"initialConsumedPosts":["$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:0:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:1:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:2:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:3:props:children:props:post","$3:props:children:0:props:children:props:initialPosts:0","$3:props:children:0:props:children:props:initialPosts:1","$3:props:child