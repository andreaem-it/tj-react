3:["$","div",null,{"className":"flex flex-col lg:flex-row gap-8","children":[["$","div",null,{"className":"flex-1 min-w-0","children":["$","$Lf",null,{"initialPosts":[{"id":17490,"date":"2026-09-06T08:44:00+02:00","modified":"2026-09-06T06:44:00+00:00","slug":"macos-26-7-code-hints-due-nuovi-controller-apple","title":"macOS 26.7: i “code hints” suggeriscono due nuovi controller Apple in arrivo","excerpt":"Nel codice di macOS 26.7 emergono indizi che puntano allo sviluppo di due controller per videogiochi Apple non ancora annunciati.","categoryName":"Games","categorySlug":"games","categoryId":7,"imageUrl":"https://static.techjournal.it/2026/09/apple-game-controller-graphic.jpg-768x432.png","imageAlt":"apple-game-controller-graphic.jpg","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17281,"date":"2026-08-29T09:28:00+02:00","modified":"2026-08-29T07:28:00+00:00","slug":"pikachu-ad-apple-park-tim-cook-john-ternus-ospitano-ceo-the-pokemon-company","title":"Pikachu ad Apple Park: Tim Cook e John Ternus ospitano il CEO di The Pokémon Company","excerpt":"Apple ha accolto il team di Pokémon ad Apple Park. Tim Cook ha condiviso un video con Pikachu in giro per il campus, mentre Tim Cook e John Ternus hanno ospitato il CEO di The Pokémon Company.","categoryName":"Games","categorySlug":"games","categoryId":7,"imageUrl":"https://static.techjournal.it/2026/08/Pikachu-pokemon-apple-park-768x432.jpg","imageAlt":"Pikachu-pokemon-apple-park","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":3,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16263,"date":"2026-07-15T11:34:13+02:00","modified":"2026-07-15T09:34:13+00:00","slug":"lego-considera-set-imac-g3-bondi-blue","title":"LEGO valuta un set “Bondi Blue” ispirato all’iMac G3","excerpt":"Il progetto LEGO Ideas dedicato all’iMac G3 in colorazione Bondi Blue è passato in “Parking Lot”, uno stato che non esclude la produzione e può richiedere ulteriore tempo di revisione.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/07/LEGO-imac-g31-768x512.jpeg","imageAlt":"LEGO-imac-g31","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":16229,"date":"2026-07-15T08:00:00+02:00","modified":"2026-07-15T06:00:00+00:00","slug":"apple-punta-a-un-pairing-stile-airpods-per-meta-occhiali-e-quest","title":"Apple punta a un pairing “stile AirPods” per gli occhiali Meta e Quest","excerpt":"Apple starebbe lavorando a un sistema di pairing simile a quello degli AirPods per facilitare l’abbinamento con occhiali Meta e dispositivi Quest.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/07/AirPods-Pro-Second-Generation-2-Pairing-Feature-1-768x432.jpg","imageAlt":"AirPods-Pro-Second-Generation-2-Pairing-Feature-1","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":3,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":15973,"date":"2026-07-04T12:24:00+02:00","modified":"2026-07-04T10:24:00+00:00","slug":"apple-arcade-si-aggiorna-con-quattro-nuovi-giochi-tra-cui-pocket-city-2-plus","title":"Apple Arcade si aggiorna con quattro nuovi giochi, tra cui Pocket City 2+","excerpt":"Apple Arcade aggiunge quattro nuovi giochi: Pocket City 2+, un dungeon crawler, un titolo dedicato alla pesca e sfide di disegno a tempo. Arrivano dopo Family Feud Pocket.","categoryName":"Games","categorySlug":"games","categoryId":7,"imageUrl":"https://static.techjournal.it/2026/07/apple-arcade-luglio-2026-768x432.jpg","imageAlt":"apple-arcade-luglio-2026","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":15895,"date":"2026-07-01T10:50:30+02:00","modified":"2026-07-01T08:50:30+00:00","slug":"apple-arcade-aggiunge-5-giochi-quiz-city-builder-pesca-disegno-roguelike","title":"Apple Arcade aggiunge 5 giochi: quiz, city builder, pesca, disegno e roguelike","excerpt":"Apple Arcade si arricchisce con Family Feud Pocket e altri quattro titoli, tra generi che spaziano dal quiz al city builder, fino a pesca, disegno e roguelike.","categoryName":"Games","categorySlug":"games","categoryId":7,"imageUrl":"https://static.techjournal.it/2026/07/Family-Feud-Pocket-1-768x432.jpg","imageAlt":"Family-Feud-Pocket-1","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":5,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":15308,"date":"2026-06-03T11:08:34+02:00","modified":"2026-06-03T09:08:34+00:00","slug":"nintendo-music-arriva-su-ipad-e-carplay-ricerca-via-siri","title":"Nintendo Music arriva su iPad e CarPlay: ricerca via Siri","excerpt":"Nintendo Music si aggiorna con supporto per iPad e CarPlay e introduce la ricerca dei brani tramite Siri. L’app consente agli abbonati Nintendo Switch Online di ascoltare le colonne sonore dei giochi Nintendo.","categoryName":"Games","categorySlug":"games","categoryId":7,"imageUrl":"https://static.techjournal.it/2026/06/Nintendo-Music-16x9-1-768x432.jpg","imageAlt":"Nintendo-Music-16x9-1","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":14968,"date":"2026-05-19T11:00:57+02:00","modified":"2026-05-19T08:05:49+00:00","slug":"ios-27-generatori-wallpaper-scorciatoie-ai","title":"iOS 27: generatori di wallpaper e scorciatoie create con AI","excerpt":"Secondo Bloomberg, iOS 27 introdurrà un generatore di wallpaper personalizzati tramite Image Playground e un aggiornamento di Shortcuts con creazione automatica basata su AI.","categoryName":"iOS","categorySlug":"ios-games","categoryId":103,"imageUrl":"https://static.techjournal.it/2026/05/iOS-27-Mock-Quick-768x432.jpg","imageAlt":"iOS-27-Mock-Quick","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":2,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":11211,"date":"2025-11-14T20:56:43+01:00","modified":"2025-11-14T19:56:43+00:00","slug":"red-dead-redemption-ios-dicembre-2","title":"Red Dead Redemption e Undead Nightmare in arrivo su iOS il 2 dicembre","excerpt":"Rockstar Games ha annunciato che il celebre gioco open-world Red Dead Redemption e il suo pacchetto di espansione Undead Nightmare arriveranno su iOS e Android il 2 dicembre.","categoryName":"iOS","categorySlug":"ios-games","categoryId":103,"imageUrl":"https://static.techjournal.it/2025/11/red-dead-redemption-ios-768x431.jpg","imageAlt":"red dead redemption ios","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":131,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":8950,"date":"2025-01-17T00:17:24+01:00","modified":"2025-01-30T23:19:04+00:00","slug":"nintendo-annuncia-la-sua-nuova-switch-2","title":"Nintendo annuncia la sua nuova Switch 2","excerpt":"Il 16 gennaio 2025, Nintendo ha annunciato ufficialmente la sua nuova console, la Nintendo Switch 2, prevista per il rilascio entro l’anno.  Questo nuovo dispositivo mantiene l’approccio ibrido del modello originale, offrendo sia funzionalità portatili che la possibilità di collegamento alla TV. Design e Caratteristiche Principali La Nintendo Switch 2 presenta un design simile al…","categoryName":"Games","categorySlug":"games","categoryId":7,"imageUrl":"https://static.techjournal.it/2025/01/DmhKEbengkqAamsJ8Sroik-970-80-768x432.webp","imageAlt":"DmhKEbengkqAamsJSroik","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":1844,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":8927,"date":"2024-12-09T20:58:40+01:00","modified":"2024-12-09T19:58:48+00:00","slug":"addio-a-gamestop-acquisita-diventera-gamelife","title":"Addio a GameStop, acquisita diventerà GameLife","excerpt":"La notizia non è proprio fresca, sono settimane che se ne parla, GameStop, il celebre colosso di negozi gaming, chiude i battenti, dopo che la società Cidiverte ne ha acquisito il 100% delle quote. I negozi fisici non chiuderanno i battenti, ma manterranno per 6 mesi le insegne attuali per poi convertirle in GameLife, e…","categoryName":"Games","categorySlug":"games","categoryId":7,"imageUrl":"https://static.techjournal.it/2024/12/gamestop8481.logowik.com_-768x576.webp","imageAlt":"gamestop logowik com","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":1978,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":8356,"date":"2023-12-12T20:49:24+01:00","modified":"2023-12-12T23:07:37+00:00","slug":"ps5-pro-in-arrivo-cosa-sappiamo-finora","title":"PS5 Pro in Arrivo: Cosa Sappiamo Finora","excerpt":"Pare che Sony stia considerando il lancio di una PS5 Pro, seguendo la strategia adottata con successo nella scorsa generazione. In passato, era già trapelata una notizia secondo cui Sony avrebbe potuto presentare un nuovo modello di PS5 PS5 Base Accessibile: Opportunità di Acquisto su Amazon Quest'Anno Nel corso di quest'anno, la PS5 base è…","categoryName":"PlayStation","categorySlug":"playstation","categoryId":8,"imageUrl":"https://static.techjournal.it/2023/12/ocLBZy5u4kkuYKuxUDgJhf-1200-80-768x432.webp","imageAlt":"ocLBZyukkuYKuxUDgJhf","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a048068414