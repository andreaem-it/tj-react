:"Apple ha corretto la nota del comunicato stampa italiano di iPhone 18 Pro: i nuovi controlli per texture e grana degli Stili fotografici non arriveranno su iPhone 16, iPhone 17 e iPhone Air, ma risultano riservati a iPhone 18 Pro e Duo.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/texture-pelle-morbida-stile-fotografico-ios-27-iphone-768x432.jpg","imageAlt":"texture-pelle-morbida-stile-fotografico-ios-27-iphone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},"variant":"hero","size":"medium"}]}],["$","div",null,{"className":"relative lg:col-start-10 lg:col-span-3 lg:row-start-1 min-h-[160px] sm:min-h-[190px] lg:min-h-[158px]","children":["$","$L2",null,{"post":{"id":18072,"date":"2026-09-26T08:44:00+02:00","modified":"2026-09-26T06:44:00+00:00","slug":"apple-conferma-aggiornamento-bugfix-iphone-18-pro-prossima-settimana","title":"Apple conferma: aggiornamento di correzione bug per iPhone 18 Pro la prossima settimana","excerpt":"Apple ha confermato l’arrivo di un aggiornamento di correzione bug per iPhone 18 Pro la prossima settimana, con l’obiettivo di migliorare stabilità e prestazioni.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/Face-ID-iPhone-18-Pro-768x432.jpg","imageAlt":"Face-ID-iPhone-18-Pro","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},"variant":"hero","size":"small"}]}],["$","div",null,{"className":"relative lg:col-start-10 lg:col-span-3 lg:row-start-2 min-h-[160px] sm:min-h-[190px] lg:min-h-[158px]","children":["$","$L2",null,{"post":{"id":18033,"date":"2026-09-24T12:02:00+02:00","modified":"2026-09-24T10:02:00+00:00","slug":"iphone-duo-scalda-troppo-4k-prima-prova-punto-preciso","title":"iPhone Duo scalda troppo in 4K: la prima prova indica un punto preciso","excerpt":"Le prime verifiche su iPhone Duo durante la registrazione video in 4K segnalano un surriscaldamento anomalo. L’attenzione si concentra su un’area specifica del dispositivo.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/iphone-duo-fotocamera-768x432.jpg","imageAlt":"iphone-duo-fotocamera","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},"variant":"hero","size":"small"}]}]]}]}],"$undefined","$L3","$undefined"]}],["$L4"],"$L5"]}],"isPartial":"$@6","staleTime":"$7","varyParams":null},{"rsc":"$L8","isPartial":"$@9","staleTime":"$7","varyParams":null},{"rsc":"$La","isPartial":"$@b","staleTime":"$7","varyParams":"$c"}],"isUpgradeableISRFallback":false,"a":"$@d","rootVaryParams":null,"needsRuntimeRequest":"$@e"}
