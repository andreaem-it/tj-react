3:["$","div",null,{"className":"flex flex-col lg:flex-row gap-8","children":[["$","div",null,{"className":"flex-1 min-w-0","children":["$","$Lf",null,{"initialPosts":[{"id":18016,"date":"2026-09-24T09:28:00+02:00","modified":"2026-09-24T07:28:00+00:00","slug":"stili-fotografici-pelle-morbida-texture-anche-su-iphone-precedenti-ios-27","title":"Stili fotografici: “Pelle Morbida” e nuove texture arrivano anche su iPhone precedenti con iOS 27","excerpt":"Con iOS 27 i nuovi controlli per texture e grana degli Stili fotografici, inclusi “Pelle Morbida”, potranno essere usati anche su dispositivi iPhone precedenti.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/ios-27-texture-soft-skin-768x432.jpg","imageAlt":"ios-27-texture-soft-skin","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18012,"date":"2026-09-24T08:44:00+02:00","modified":"2026-09-24T06:44:00+00:00","slug":"apple-iphone-doppio-display-2029","title":"Apple: iPhone con tecnologia a doppio display in arrivo nel 2029","excerpt":"Apple starebbe pianificando l’introduzione della tecnologia a doppio display, già associata a iPhone, su modelli Pro nel 2029.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/iphone-2028-punch-hole-design-768x432.jpg","imageAlt":"iphone-2028-punch-hole-design","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18009,"date":"2026-09-24T08:22:00+02:00","modified":"2026-09-24T06:22:00+00:00","slug":"apple-limita-texture-e-grain-niente-su-iphone-piu-vecchi","title":"Apple limita Texture e Grain: niente su iPhone più vecchi","excerpt":"I nuovi controlli Texture e Grain per le Photographic Styles in iOS 27 risultano disponibili solo su iPhone 18 Pro e, per iPhone Duo, su specifiche fotocamere. La compatibilità indicata inizialmente per “i modelli che supportano le Photographic Styles” è stata poi ristretta.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/photographic-styles-3402x-768x432.jpg","imageAlt":"photographic-styles-3402x","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18007,"date":"2026-09-23T14:00:00+02:00","modified":"2026-09-23T12:22:28+00:00","slug":"apple-lavora-funzione-anti-rapina-bloccare-iphone-auto-lock","title":"Apple lavora a una funzione anti-rapina per bloccare gli iPhone rubati","excerpt":"Nelle ultime build di iOS 27.2 emergono riferimenti a una funzione interna chiamata “AutoLock” che, in caso di rapina, potrebbe bloccare l’iPhone e attivare la protezione del dispositivo rubato.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/apple-lock-security-bug-vulnerability-fix-privacy-768x432.jpg","imageAlt":"apple-lock-security-bug-vulnerability-fix-privacy","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18022,"date":"2026-09-23T11:12:41+02:00","modified":"2026-09-23T09:12:41+00:00","slug":"shazam-iphone-aggiornamento-icona-sticker-imessage","title":"Shazam per iPhone si aggiorna: nuova icona e sticker per iMessage","excerpt":"Aggiornamento per l’app Shazam su iOS con una nuova icona e un set di sticker da usare in iMessage, anche durante le chiamate FaceTime.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/Shazam-New-Icon-768x432.jpg","imageAlt":"Shazam-New-Icon","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":18005,"date":"2026-09-22T23:20:17+02:00","modified":"2026-09-22T21:20:17+00:00","slug":"tap-to-pay-su-iphone-arriva-in-8-nuovi-paesi","title":"Tap to Pay su iPhone arriva in 8 nuovi Paesi","excerpt":"Apple estende Tap to Pay on iPhone in otto nuovi Paesi: Argentina, Colombia, Costa Rica, Repubblica Dominicana, Guatemala, Honduras, Panama e Perù.","categoryName":"Apple","categorySlug":"apple","categoryId":2,"imageUrl":"https://static.techjournal.it/2026/09/Tap-to-Pay-on-iPhone-General-768x432.jpg","imageAlt":"Tap-to-Pay-on-iPhone-General","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17984,"date":"2026-09-22T09:06:00+02:00","modified":"2026-09-22T07:06:00+00:00","slug":"iphone-20-pro-primi-prototipi-display-piu-grandi-piu-definiti-forse-curvi-quattro-lati","title":"iPhone 20 Pro: i primi prototipi mostrano display più grandi, più definiti e forse curvi su quattro lati","excerpt":"I primi prototipi di iPhone 20 Pro suggeriscono un salto sul display: dimensioni maggiori, maggiore definizione e la possibilità di un design curvo su quattro lati.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/iphone-20-pro-display-senza-cornici-768x432.jpg","imageAlt":"iphone-20-pro-display-senza-cornici","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17967,"date":"2026-09-22T08:22:00+02:00","modified":"2026-09-22T06:22:00+00:00","slug":"alcuni-utenti-iphone-18-pro-segnalano-problemi-con-face-id","title":"Alcuni utenti iPhone 18 Pro segnalano problemi con Face ID","excerpt":"Alcuni utenti iPhone 18 Pro segnalano difficoltà legate al funzionamento di Face ID. Al momento si tratta di indiscrezioni e non di un quadro ufficiale.","categoryName":"iOS","categorySlug":"ios","categoryId":14,"imageUrl":"https://static.techjournal.it/2026/09/Face-ID-iPhone-18-Pro-768x432.jpg","imageAlt":"Face-ID-iPhone-18-Pro","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17956,"date":"2026-09-21T21:50:24+02:00","modified":"2026-09-21T19:50:24+00:00","slug":"iphone-14-pro-vs-iphone-18-pro-guida-alla-upgrade","title":"iPhone 14 Pro vs iPhone 18 Pro: guida all’upgrade","excerpt":"Dopo quattro generazioni, iPhone 18 Pro porta display più grandi, USB‑C, ricarica più rapida, nuove fotocamere, più autonomia e supporto ad Apple Intelligence. Ecco quando conviene davvero passare da iPhone 14 Pro.","categoryName":"Guide","categorySlug":"guide","categoryId":196,"imageUrl":"https://static.techjournal.it/2026/09/iphone-14-pro-vs-iphone-18-pro-768x432.jpg","imageAlt":"iphone-14-pro-vs-iphone-18-pro","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17949,"date":"2026-09-21T12:25:09+02:00","modified":"2026-09-21T10:25:09+00:00","slug":"ifixit-pubblica-teardown-iphone-18-pro-nuove-funzionalita","title":"iFixit pubblica il teardown di iPhone 18 Pro: ecco cosa emerge","excerpt":"Un teardown di iPhone 18 Pro offre uno sguardo ravvicinato all’hardware e alle novità interne del dispositivo, con l’analisi di iFixit sulle componenti e sulla struttura del telefono.","categoryName":"Guide","categorySlug":"guide","categoryId":196,"imageUrl":"https://static.techjournal.it/2026/09/iFixit-iPhone-18-Pro-Teardown-768x432.jpg","imageAlt":"iFixit-iPhone-18-Pro-Teardown","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17946,"date":"2026-09-21T09:50:25+02:00","modified":"2026-09-21T07:50:25+00:00","slug":"apple-pencil-piu-corto-iphone-duo-progetto-cancellato-supporto-usb-c-in-arrivo","title":"Apple Pencil più corto per iPhone Duo: progetto cancellato, supporto al modello USB‑C in arrivo","excerpt":"Un Apple Pencil più corto pensato per iPhone Duo era in sviluppo, ma Apple lo avrebbe cancellato per problemi tecnici legati alla produzione. In alternativa, iPhone Duo riceverà più avanti il supporto all’Apple Pencil USB‑C esistente.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/iphone-duo-hero-768x432.jpg","imageAlt":"iphone-duo-hero","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17925,"date":"2026-09-20T09:06:00+02:00","modified":"2026-09-20T07:06:00+00:00","slug":"iphone-18-pro-max-usa-modem-qualcomm-snapdragon-x80","title":"iPhone 18 Pro Max USA con modem Qualcomm Snapdragon X80: cosa cambia","excerpt":"Un teardown conferma che la variante statunitense di iPhone 18 Pro Max monta il modem Qualcomm Snapdragon X80. Nel resto del mondo, invece, Apple usa il modem C2.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/deep-black-iphone-18-pro-768x432.jpg","imageAlt":"deep-black-iphone-18-pro","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null}],"initialConsumedPosts":["$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:0:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:1:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:2:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:3:props:children:props:post","$3:props:children:0:props:children:props:initialPosts:0","$3:props:children:0:props:children:props:initialPosts:1","$3:props:children:0:props:children:props:initialPosts:2","$3:props:children:0:props:children:props:initialPosts:3","$3:props:children:0:props:children:props:initialPosts:4","$3:props:children:0:props:children:props:initialPosts:5","$3:props:children:0:props:children:props:initialPosts:6","$3:props:children:0:props:children:props:initialPosts:7","$3:props:children:0:props:children:props:initialPosts:8","$3:props:children:0:props:children:props:initialPosts:9","$3:props:children:0:props:children:props:initialPosts:10","$3:props:children:0:props:children:props:initialPosts:11"],"initialTotalPages":49,"initialPagesConsumed":2,"categoryId":4,"emptyGridIsExpected":false}]}],"$L10"]}]
