3:["$","div",null,{"className":"flex flex-col lg:flex-row gap-8","children":[["$","div",null,{"className":"flex-1 min-w-0","children":["$","$Lf",null,{"initialPosts":[{"id":18024,"date":"2026-09-23T11:20:09+02:00","modified":"2026-09-23T09:20:09+00:00","slug":"gpt-6-sol-luna-miglioramenti-astra-piani-economici","title":"I nuovi modelli GPT-6 Sol e Luna di OpenAI portano miglioramenti Astra anche nei piani più economici","excerpt":"OpenAI introduce i modelli GPT-6 Sol e Luna, estendendo i miglioramenti legati ad Astra anche ai piani più economici. Una novità pensata per aumentare prestazioni e accessibilità.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/openai-logo-teal-768x432.jpg","imageAlt":"openai-logo-teal","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17992,"date":"2026-09-22T11:42:17+02:00","modified":"2026-09-22T09:42:17+00:00","slug":"magic-diary-diario-ai-terza-persona-privato-iphone","title":"Magic Diary: il diario con l’AI che riscrive le giornate in terza persona, restando privato su iPhone","excerpt":"Magic Diary trasforma i vostri appunti in un racconto in terza persona: l’AI riscrive le giornate mantenendo l’esperienza focalizzata sulla privacy direttamente su iPhone.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/magic-diary-1-768x432.jpg","imageAlt":"magic-diary-1","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17960,"date":"2026-09-21T22:12:43+02:00","modified":"2026-09-21T20:12:43+00:00","slug":"apple-seconda-beta-ios-27-2","title":"Apple rilascia la seconda beta di iOS 27.2 e aggiorna anche iPadOS","excerpt":"Apple ha distribuito la seconda beta di iOS 27.2 agli sviluppatori, a una settimana dalla prima. Presente anche una beta di iPadOS 27.2, con novità su app Salute e Siri.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/iOS-27.2-Next-to-iPhone-768x432.jpg","imageAlt":"iOS-27.2-Next-to-iPhone","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17951,"date":"2026-09-21T12:47:18+02:00","modified":"2026-09-21T10:47:18+00:00","slug":"sito-settlement-siri-ai-ora-online-apple-paghera-alcuni-proprietari-iphone","title":"Sito per il settlement Siri AI ora online: Apple pagherà alcuni proprietari di iPhone","excerpt":"È online il sito dedicato al settlement legato a Siri AI: Apple prevede pagamenti ad alcuni proprietari di iPhone. Ecco cosa significa per gli utenti.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/iOS-18-Siri-Personal-Context-768x432.jpg","imageAlt":"iOS-18-Siri-Personal-Context","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17936,"date":"2026-09-20T09:28:00+02:00","modified":"2026-09-20T07:28:00+00:00","slug":"top-stories-ios-27-macos-golden-gate-siri-ai-waitlist","title":"Top Stories: iOS 27 e macOS Golden Gate disponibili, Siri AI in waitlist e altro","excerpt":"Disponibili iOS 27 e macOS Golden Gate con Siri AI e nuove funzioni. Siri AI richiede una waitlist, iPhone 18 Pro Max negli USA usa un modem diverso e iCloud+ si amplia in oltre 100 paesi.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/top-stories-2026-09-19-768x432.jpg","imageAlt":"top-stories-2026-09-19","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17872,"date":"2026-09-18T08:44:00+02:00","modified":"2026-09-18T06:44:00+00:00","slug":"macos-golden-gate-50-novita-siri-app-interfaccia","title":"macOS Golden Gate: 50 novità tra Siri, app Apple e interfaccia","excerpt":"macOS 27 Golden Gate porta un’esperienza Siri rinnovata, nuove funzioni in Safari, Foto, Mail e Calendario, miglioramenti all’interfaccia e aggiornamenti per AirDrop, i widget e molto altro.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/50-New-macOS-Golden-Gate-Features-and-Changes-Worth-Checking-Out-Feature-768x432.jpg","imageAlt":"50-New-macOS-Golden-Gate-Features-and-Changes-Worth-Checking-Out-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17850,"date":"2026-09-17T13:08:00+02:00","modified":"2026-09-17T11:08:00+00:00","slug":"kids-act-ue-stop-social-under-13-chatbot-ai","title":"Kids Act UE: stop ai social per under 13 e limiti per chatbot AI","excerpt":"L’UE prepara il Kids Act: divieto di social media per i minori di 13 anni senza supervisione, regole più stringenti tra 13 e 15 e obblighi di tutela anche per gaming e chatbot AI.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/european-commission-768x432.jpg","imageAlt":"european-commission","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17854,"date":"2026-09-17T12:24:00+02:00","modified":"2026-09-17T10:24:00+00:00","slug":"iphone-18-pro-apple-reference-image-negativo-digitale","title":"iPhone 18 Pro, Apple Reference Image: il “negativo digitale” per attestare lo scatto","excerpt":"Con iPhone 18 Pro e iPhone 18 Pro Max, Apple introduce Apple Reference Image: una modalità che mira a dimostrare che una foto è stata scattata davvero con un iPhone e non è stata modificata.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/iphone-18-pro-apple-reference-image-1-1-768x432.jpg","imageAlt":"iphone-18-pro-apple-reference-image-1-1","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17831,"date":"2026-09-17T12:02:00+02:00","modified":"2026-09-17T10:02:00+00:00","slug":"primo-benchmark-chip-m5-ultra-boost-prestazionale","title":"Primo benchmark per il chip M5 Ultra: boost prestazionale in evidenza","excerpt":"Il primo risultato di benchmark relativo al chip M5 Ultra mostra un incremento delle prestazioni, offrendo un primo assaggio della nuova generazione di silicio orientata all’AI.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/M5-Ultra-Hero-768x432.jpeg","imageAlt":"M5-Ultra-Hero","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17844,"date":"2026-09-17T12:02:00+02:00","modified":"2026-09-17T10:02:00+00:00","slug":"fornitore-memoria-apple-valuta-produzione-usa-con-intel","title":"Fornitore di memoria di Apple valuta produzione negli Stati Uniti con Intel","excerpt":"SK Hynix, fornitore di memoria per Apple, sarebbe in colloqui esplorativi con Intel per produrre chip di memoria negli Stati Uniti. Ipotesi: leasing di parte dell’impianto in Ohio o joint venture con cloud provider.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/sk-hynix-intel-768x432.png","imageAlt":"sk-hynix-intel","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17852,"date":"2026-09-17T12:02:00+02:00","modified":"2026-09-17T10:02:00+00:00","slug":"apple-tornare-mercato-server-tecnologia-nvidia","title":"Apple potrebbe tornare nel mercato server con tecnologia Nvidia","excerpt":"Apple valuta un ritorno nel mercato dei server integrando tecnologie Nvidia, con un possibile focus su infrastrutture per l’AI e data center.","categoryName":"Tecnologia","categorySlug":"tecnologia","categoryId":5,"imageUrl":"https://static.techjournal.it/2026/09/apple-silicon-gray-768x432.jpg","imageAlt":"apple-silicon-gray","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":0,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":17829,"date":"2026-09-17T09:28:00+02:00","modified":"2026-09-17T07:28:00+00:00","slug":"ios-27-siri-ai-lista-attesa-come-attivarla","title":"iOS 27 e Siri AI: lista d’attesa e come attivarla su iPhone","excerpt":"Dopo l’aggiornamento a iOS 27, Siri AI e l’app dedicata non sono immediatamente disponibili per tutti: serve iscriversi alla lista d’attesa. Ecco i passaggi e i requisiti dei modelli compatibili.","categoryName":"Intelligenza Artificiale","categorySlug":"intelligenza-artificiale","categoryId":188,"imageUrl":"https://static.techjournal.it/2026/09/macOS-iOS-27-Siri-App-Feature-768x432.jpg","imageAlt":"macOS-iOS-27-Siri-App-Feature","authorName":"","authorAvatarUrl":"","authorSlug":"","viewCount":1,"review":null,"changelog":[],"tldr":[],"breaking":null}],"initialConsumedPosts":["$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:0:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:1:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:2:props:children:props:post","$0:data:0:rsc:props:children:0:props:children:2:props:children:props:children:3:props:children:props:post","$3:props:children:0:props:children:props:initialPosts:0","$3:props:children:0:props:children:props:initialPosts:1","$3:props:children:0:props:children:props:initialPosts:2","$3