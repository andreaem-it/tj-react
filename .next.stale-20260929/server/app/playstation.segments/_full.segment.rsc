33:["$","div",null,{"className":"relative lg:col-start-10 lg:col-span-3 lg:row-start-2 min-h-[160px] sm:min-h-[190px] lg:min-h-[158px]","children":["$","$L32",null,{"post":{"id":6918,"date":"2021-05-09T12:39:05+02:00","modified":"2021-05-09T12:26:19+00:00","slug":"ps5-in-arrivo-nuovi-dualsene","title":"PS5: In arrivo nuovi DualSene","excerpt":"Sono stati scoperti nuovi leak oggi che svelano i nuovi DualSense in arrivo. A differenza dei recenti rumor che parlano di un possibile nuovo modello di PS5 in arrivo nel prossimo anno, questa volta i cambiamenti al controller non sarebbero così eclatanti. Stando a quanto trapelato, nelle prossime settimane, Sony potrebbe presentare una nuova linea…","categoryName":"PlayStation","categorySlug":"playstation","categoryId":8,"imageUrl":"https://static.techjournal.it/2021/05/img_0564-768x432.png","imageAlt":"img 0564","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":5128,"review":null,"changelog":[],"tldr":[],"breaking":null},"variant":"hero","size":"small"}]}]
34:["$","div",null,{"className":"flex flex-col lg:flex-row gap-8","children":[["$","div",null,{"className":"flex-1 min-w-0","children":["$","$L35",null,{"initialPosts":[{"id":6914,"date":"2021-05-06T21:00:31+02:00","modified":"2021-05-06T19:00:37+00:00","slug":"sony-potrebbe-presentare-un-nuovo-modello-di-ps5-gia-il-prossimo-anno","title":"Sony potrebbe presentare un nuovo modello di PS5 già il prossimo anno","excerpt":"Non è passato molto dalla presentazione di PS5 e già circolano voci su un possibile nuovo modello. Si tratta ovviamente di rumors, ma un nuovo report sembrerebbe avvalorare la tesi. Quest'ultimo tratta l'argomento più a fondo e sembra proprio che Sony abbia in mente di presentare un nuovo modello di PS5 molto prima di quanto…","categoryName":"PlayStation","categorySlug":"playstation","categoryId":8,"imageUrl":"https://static.techjournal.it/2021/05/ps5-147287-768x432.jpeg","imageAlt":"ps5 147287","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":4778,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":829,"date":"2021-03-29T19:14:24+02:00","modified":"2021-03-29T18:51:55+00:00","slug":"sony-10-miliardi-di-profitto-per-la-sezione-console-bonus-di-7-mensilita-ai-dipendenti","title":"Sony: 10 miliardi di profitto per la sezione console, bonus di 7 mensilità ai dipendenti","excerpt":"Per Sony è stato un’anno incredibile, con l’uscita di PS5, la divisione Games ha ottenuto profitti da record raggiungendo numeri da record nella storia dell’azienda. Il colosso, dato il grande sforzo di tutto il personale, ha deciso di premiare tutto lo staff della sede giapponese con il versamento di 7 mensilità di stipendio sui conti…","categoryName":"PlayStation","categorySlug":"playstation","categoryId":8,"imageUrl":"https://static.techjournal.it/2021/03/img_0389-768x432.jpg","imageAlt":"img 0389","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":4472,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":177,"date":"2020-06-12T11:17:51+02:00","modified":"2020-10-23T10:29:44+00:00","slug":"sony-presenta-ps5-e-ps5-digital-edition","title":"SONY presenta PS5 e PS5 Digital Edition","excerpt":"Nel corso di un evento online andato in onda ieri, Sony ha finalmente svelato l'aspetto di PlayStation 5, che sarà disponibile anche in una seconda versione senza lettore BD 4K. L'hardware per il resto rimane lo stesso, quindi molti potrebbero preferirla per il prezzo più abbordabile, anche se non si sa ancora di quanto. Le forme della…","categoryName":"PlayStation","categorySlug":"playstation","categoryId":8,"imageUrl":"https://static.techjournal.it/2020/06/2020_06_12_sony_ps5_discless_560_s-768x512.jpg","imageAlt":"2020 06 12 sony ps5 discless 560 s","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":4401,"review":null,"changelog":[],"tldr":[],"breaking":null},{"id":54,"date":"2020-02-17T02:59:01+01:00","modified":"2020-10-23T10:34:25+00:00","slug":"ps5-prezzo-lancio-piu-alto-di-ps4","title":"PS5, prezzo lancio più alto di PS4","excerpt":"Sono settimane di fuoco per Sony e Microsoft. Le due aziende stanno lavorando alle loro console next-gen, preparando ulteriori annunci - sia lato hardware che software - per conquistare l'attenzione del pubblico. Mentre la casa di Redmond ha già scoperto le sue carte con Xbox Series X, il colosso giapponese si è limitata a ufficializzare il logo della sua…","categoryName":"PlayStation","categorySlug":"playstation","categoryId":8,"imageUrl":"https://static.techjournal.it/2020/02/ps5-fanmade-768x383.png","imageAlt":"ps5 fanmade","authorName":"Andrea Emili","authorAvatarUrl":"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g","authorSlug":"andreaem","viewCount":3103,"review":null,"changelog":[],"tldr":[],"breaking":null}],"initialConsumedPosts":["$29:props:children:2:props:children:props:children:0:props:children:props:post","$29:props:children:2:props:children:props:children:1:props:children:props:post","$29:props:children:2:props:children:props:children:2:props:children:props:post","$33:props:children:props:post","$34:props:children:0:props:children:props:initialPosts:0","$34:props:children:0:props:children:props:initialPosts:1","$34:props:children:0:props:children:props:initialPosts:2","$34:props:children:0:props:children:props:initialPosts:3"],"initialTotalPages":1,"initialPagesConsumed":1,"categoryId":8,"emptyGridIsExpected":false}]}],"$L36"]}]
