g\":null},{\"id\":13422,\"date\":\"2026-02-28T13:07:46+01:00\",\"modified\":\"2026-02-28T12:39:16+00:00\",\"slug\":\"apple-record-vendite-iphone-europa-2025\",\"title\":\"Apple Stabilisce un Record di Vendite di iPhone in Europa nel 2025\",\"excerpt\":\"Apple ha spedito 36,9 milioni di iPhone in Europa nel 2025, registrando una crescita del 6% rispetto all'anno precedente e conquistando una quota record del 27% del mercato degli smartphone nella regione.\",\"categoryName\":\"Apple\",\"categorySlug\":\"apple\",\"categoryId\":2,\"imageUrl\":\"https://static.techjournal.it/2026/02/Apple-iPhone-16-family-lineup-768x432.jpg\",\"imageAlt\":\"Apple iPhone family lineup\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":26,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":13414,\"date\":\"2026-02-28T13:07:31+01:00\",\"modified\":\"2026-02-28T12:41:06+00:00\",\"slug\":\"iphone-18-pro-riporta-funzionalita-samsung-abbandonata\",\"title\":\"iPhone 18 Pro riporta una funzionalità abbandonata da Samsung anni fa\",\"excerpt\":\"L'iPhone 18 Pro e l'iPhone 18 Pro Max di Apple sono attesi con un'importante novità: una fotocamera principale con apertura variabile, una funzionalità che Samsung ha abbandonato nel 2020.\",\"categoryName\":\"iPhone\",\"categorySlug\":\"iphone\",\"categoryId\":4,\"imageUrl\":\"https://static.techjournal.it/2026/02/iphone-17-cameras-zoom-768x432.jpg\",\"imageAlt\":\"iphone cameras zoom\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":24,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":13377,\"date\":\"2026-02-20T23:02:53+01:00\",\"modified\":\"2026-02-21T10:35:52+00:00\",\"slug\":\"iphone-fold-lancio-prezzo-cosa-aspettarsi-2\",\"title\":\"iPhone Fold: Lancio, Prezzo e Cosa Aspettarsi dal Foldable di Apple\",\"excerpt\":\"Apple è attesa al lancio di un nuovo iPhone pieghevole quest'anno, con il dispositivo che potrebbe arrivare nel 2026.\",\"categoryName\":\"iPhone\",\"categorySlug\":\"iphone\",\"categoryId\":4,\"imageUrl\":\"https://static.techjournal.it/2026/02/Apple-Foldable-Thumb-768x432.jpg\",\"imageAlt\":\"Apple Foldable Thumb\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":33,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":13335,\"date\":\"2026-02-18T21:32:54+01:00\",\"modified\":\"2026-02-21T10:33:50+00:00\",\"slug\":\"10-motivi-per-aspettare-iphone-18-pro-2\",\"title\":\"10 Motivi per Aspettare l'iPhone 18 Pro di Apple\",\"excerpt\":\"Apple sta preparando il lancio della serie iPhone 18, con importanti novità per l'iPhone 18 Pro e Pro Max. Ecco dieci motivi per cui potrebbe valere la pena aspettare.\",\"categoryName\":\"iPhone\",\"categorySlug\":\"iphone\",\"categoryId\":4,\"imageUrl\":\"https://static.techjournal.it/2026/02/Dynamic-Island-iPhone-18-Pro-Feature-768x432.jpg\",\"imageAlt\":\"Dynamic Island iPhone Pro Feature\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":37,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":13125,\"date\":\"2026-02-10T19:32:18+01:00\",\"modified\":\"2026-02-10T18:32:18+00:00\",\"slug\":\"samsung-pianifica-fotocamera-diaframma-variabile\",\"title\":\"Samsung Pianifica di Seguire l'iPhone 18 Pro con una Fotocamera a Diaframma Variabile\",\"excerpt\":\"Samsung sta pianificando di aggiungere un diaframma variabile alle fotocamere dei suoi smartph