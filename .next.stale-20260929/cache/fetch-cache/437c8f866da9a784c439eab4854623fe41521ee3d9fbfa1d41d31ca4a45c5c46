elog\":[],\"tldr\":[],\"breaking\":null},{\"id\":17969,\"date\":\"2026-09-22T08:44:00+02:00\",\"modified\":\"2026-09-22T06:44:00+00:00\",\"slug\":\"nuovi-mac-mini-e-mac-studio-in-arrivo-domani-chip-m6-m5-pro-m5-max-m5-ultra\",\"title\":\"Nuovi Mac mini e Mac Studio in arrivo domani: chip M6, M5 Pro, M5 Max e M5 Ultra\",\"excerpt\":\"Apple prepara il lancio dei nuovi Mac mini e Mac Studio per martedì 22 settembre: aggiornamenti di specifiche con chip M6, M5 Pro, M5 Max e M5 Ultra, senza cambiamenti di design rilevanti.\",\"categoryName\":\"Apple\",\"categorySlug\":\"apple\",\"categoryId\":2,\"imageUrl\":\"https://static.techjournal.it/2026/09/Mac-mini-vs-Studio-Feature-Sans-Text-1-768x432.jpg\",\"imageAlt\":\"Mac-mini-vs-Studio-Feature-Sans-Text-1\",\"authorName\":\"\",\"authorAvatarUrl\":\"\",\"authorSlug\":\"\",\"viewCount\":0,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":17967,\"date\":\"2026-09-22T08:22:00+02:00\",\"modified\":\"2026-09-22T06:22:00+00:00\",\"slug\":\"alcuni-utenti-iphone-18-pro-segnalano-problemi-con-face-id\",\"title\":\"Alcuni utenti iPhone 18 Pro segnalano problemi con Face ID\",\"excerpt\":\"Alcuni utenti iPhone 18 Pro segnalano difficoltà legate al funzionamento di Face ID. Al momento si tratta di indiscrezioni e non di un quadro ufficiale.\",\"categoryName\":\"iOS\",\"categorySlug\":\"ios\",\"categoryId\":14,\"imageUrl\":\"https://static.techjournal.it/2026/09/Face-ID-iPhone-18-Pro-768x432.jpg\",\"imageAlt\":\"Face-ID-iPhone-18-Pro\",\"authorName\":\"\",\"authorAvatarUrl\":\"\",\"authorSlug\":\"\",\"viewCount\":0,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":17958,\"date\":\"2026-09-22T08:00:00+02:00\",\"modified\":\"2026-09-22T06:00:00+00:00\",\"slug\":\"apple-seconda-beta-macos-golden-gate-27-2-sviluppatori\",\"title\":\"Apple rilascia la seconda beta di macOS Golden Gate 27.2 agli sviluppatori\",\"excerpt\":\"Apple sta testando macOS Golden Gate 27.2 e ha reso disponibile agli sviluppatori la seconda beta, a una settimana dalla prima. Novità attesa: Siri AI in nuove lingue.\",\"categoryName\":\"Mac\",\"categorySlug\":\"mac\",\"categoryId\":12,\"imageUrl\":\"https://static.techjournal.it/2026/09/macOS-27-next-to-MacBook-Pro-Running-macOS-27-768x432.jpg\",\"imageAlt\":\"macOS-27-next-to-MacBook-Pro-Running-macOS-27\",\"authorName\":\"\",\"authorAvatarUrl\":\"\",\"authorSlug\":\"\",\"viewCount\":0,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":17964,\"date\":\"2026-09-21T22:57:12+02:00\",\"modified\":\"2026-09-21T20:57:12+00:00\",\"slug\":\"pin-music-in-cima-alla-libreria-su-apple-watch-come-funziona\",\"title\":\"Pin Music in cima alla libreria su Apple Watch: come funziona\",\"excerpt\":\"Con watchOS 27 e un abbonamento Apple Music, puoi fissare brani, artisti, album e playlist in cima alla libreria dell’Apple Watch per trovarli e avviarli più velocemente.\",\"categoryName\":\"Guide\",\"categorySlug\":\"guide\",\"categoryId\":196,\"imageUrl\":\"https://static.techjournal.it/2026/09/pin-music-library-768x432.jpeg\",\"imageAlt\":\"pin-music-library\",\"authorName\":\"\",\"authorAvatarUrl\":\"\",\"authorSlug\":\"\",\"viewCount\":0,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":17975,\"date\":\"2026-09-21T22:50:19+02:00\",\"modified\":\"2026-09-21T20:50:19+00:00\",\"slug\":\"apple-smart-home-display-in-arrivo-gia-il-prossimo-mese\",\"title\":\"Apple Smart Home Display in arrivo già il prossimo mese\",\"excerpt\":\"Apple starebbe preparando un nuovo Smart Home Display, atteso già il prossimo mese. Un dispositivo pensato per la gestione della casa connessa e l’accesso rapido alle funzioni quotidiane.\",\"categoryName\":\"Smart Home\",\"categorySlug\":\"smart-home\",\"categoryId\":11,\"imageUrl\":\"https://static.techjournal.it/2026/09/Home-Hub-Command-Center-with-Dome-Base-Feature-768x432.jpg\",\"imageAlt\":\"Home-Hub-Command-Center-with-Dome-Base-Feature\",\"authorName\":\"\",\"authorAvatarUrl\":\"\",\"a