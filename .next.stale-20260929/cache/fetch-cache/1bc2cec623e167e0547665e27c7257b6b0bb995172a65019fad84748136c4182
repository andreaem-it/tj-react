ategorySlug\":\"apple\",\"categoryId\":2,\"imageUrl\":\"https://static.techjournal.it/2026/08/iOS-27-Feature-Cool-768x432.jpg\",\"imageAlt\":\"iOS-27-Feature-Cool\",\"authorName\":\"\",\"authorAvatarUrl\":\"\",\"authorSlug\":\"\",\"viewCount\":0,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":17238,\"date\":\"2026-08-28T12:02:00+02:00\",\"modified\":\"2026-08-28T10:02:00+00:00\",\"slug\":\"ios-27-nuove-funzioni-ai-apple-tv-4k-homepod\",\"title\":\"iOS 27: nuove funzioni AI in arrivo su Apple TV 4K ed HomePod\",\"excerpt\":\"Dai primi indizi sul codice di iOS 27 emergono possibili nuove funzioni basate sull’intelligenza artificiale in arrivo su Apple TV 4K e HomePod.\",\"categoryName\":\"Smart Home\",\"categorySlug\":\"smart-home\",\"categoryId\":11,\"imageUrl\":\"https://static.techjournal.it/2026/08/apple-tv-homepod-siri-ai-768x432.jpg\",\"imageAlt\":\"apple-tv-homepod-siri-ai\",\"authorName\":\"\",\"authorAvatarUrl\":\"\",\"authorSlug\":\"\",\"viewCount\":0,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":17236,\"date\":\"2026-08-28T09:28:00+02:00\",\"modified\":\"2026-08-28T07:28:00+00:00\",\"slug\":\"concept-video-iphone-ultra-pieghevole-presentazione\",\"title\":\"Concept video: così potrebbe presentarsi l’iPhone Ultra pieghevole\",\"excerpt\":\"Un concept video firmato da Gunhoo Lee prova a immaginare la presentazione dell’iPhone Ultra pieghevole: un’anteprima digitale curata e molto realistica.\",\"categoryName\":\"Apple\",\"categorySlug\":\"apple\",\"categoryId\":2,\"imageUrl\":\"https://static.techjournal.it/2026/08/iphone-ultra-foldable-video-concept-768x432.jpg\",\"imageAlt\":\"iphone-ultra-foldable-video-concept\",\"authorName\":\"\",\"authorAvatarUrl\":\"\",\"authorSlug\":\"\",\"viewCount\":0,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":17234,\"date\":\"2026-08-28T09:06:00+02:00\",\"modified\":\"2026-08-28T07:06:00+00:00\",\"slug\":\"immagini-trapelate-primo-sguardo-server-ai-apple\",\"title\":\"Immagini trapelate offrono il primo sguardo ai server AI di Apple\",\"excerpt\":\"Le immagini trapelate mostrano un possibile primo dettaglio dell’infrastruttura dedicata all’AI di Apple, con un focus su server e componenti pensati per carichi computazionali intensi.\",\"categoryName\":\"Tecnologia\",\"categorySlug\":\"tecnologia\",\"categoryId\":5,\"imageUrl\":\"https://static.techjournal.it/2026/08/apple-silicon-gray-768x432.jpg\",\"imageAlt\":\"apple-silicon-gray\",\"authorName\":\"\",\"authorAvatarUrl\":\"\",\"authorSlug\":\"\",\"viewCount\":0,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":17232,\"date\":\"2026-08-28T08:44:00+02:00\",\"modified\":\"2026-08-28T06:44:00+00:00\",\"slug\":\"video-presentazione-iphone-pieghevole-o-quasi\",\"title\":\"Ecco il video di presentazione dell’iPhone pieghevole (o quasi)\",\"excerpt\":\"Nuove immagini mostrerebbero la scheda madre dell’iPhone pieghevole, mentre un concept video ne anticipa il presunto design.\",\"categoryName\":\"Apple\",\"categorySlug\":\"apple\",\"categoryId\":2,\"imageUrl\":\"https://static.techjournal.it/2026/08/iphone-ultra-768x437.jpg\",\"imageAlt\":\"Screenshot\",\"authorName\":\"\",\"authorAvatarUrl\":\"\",\"authorSlug\":\"\",\"viewCount\":0,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":17230,\"date\":\"2026-08-28T08:22:00+02:00\",\"modified\":\"2026-08-28T06:22:00+00:00\",\"slug\":\"apple-evento-9-settembre-2026-iphone-18-pro-iphone-pieghevole\",\"title\":\"Apple annuncia l’evento del 9 settembre 2026: iPhone 18 Pro e primo iPhone pieghevole\",\"excerpt\":\"Apple ha annunciato un evento per il 9 settembre 2026. In agenda iPhone 18 Pro, iPhone 18 Pro Max, il primo iPhone pieghevole e nuovi Apple Watch.\",\"categoryName\":\"iPhone\",\"categorySlug\":\"iphone\",\"categoryId\":4,\"imageUrl\":\"https://static.techjournal.it/2026/08/evento-apple-2026-768x384.webp\",\"imageAlt\":\"evento-apple-2026\",\"authorName\":\"\",\"authorAvatarUrl\":