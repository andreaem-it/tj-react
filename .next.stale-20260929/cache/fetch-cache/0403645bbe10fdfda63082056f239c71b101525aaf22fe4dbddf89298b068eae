d\":15640,\"date\":\"2026-06-20T12:02:00+02:00\",\"modified\":\"2026-06-20T10:02:00+00:00\",\"slug\":\"apple-watch-ultra-4-quattro-novita-attese-redesign-sensori-salute\",\"title\":\"Apple Watch Ultra 4: quattro novità attese, dal redesign completo ai nuovi sensori per la salute\",\"excerpt\":\"Quattro cambiamenti attesi per Apple Watch Ultra 4: un redesign più marcato, nuove funzionalità per l’outdoor e, soprattutto, sensori pensati per migliorare il monitoraggio della salute.\",\"categoryName\":\"Tecnologia\",\"categorySlug\":\"tecnologia\",\"categoryId\":5,\"imageUrl\":\"https://static.techjournal.it/2026/06/apple-watch-ultra-4-768x432.jpg\",\"imageAlt\":\"apple-watch-ultra-4\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":3,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":15128,\"date\":\"2026-05-25T11:30:27+02:00\",\"modified\":\"2026-05-25T06:35:19+00:00\",\"slug\":\"watchos-27-nuove-funzioni-salute-watch-face-satelliti-rumor\",\"title\":\"watchOS 27: nuove funzioni tra salute, watch face e satelliti (rumor)\",\"excerpt\":\"Rumor su watchOS 27: miglioramenti al tracciamento della frequenza cardiaca, nuove watch face e possibili funzioni satellitari. Focus anche su stabilità e performance.\",\"categoryName\":\"Watch\",\"categorySlug\":\"watch\",\"categoryId\":186,\"imageUrl\":\"https://static.techjournal.it/2026/05/Apple-Watch-Ultra-2-Black-Titanium-768x432.jpg\",\"imageAlt\":\"Apple-Watch-Ultra-2-Black-Titanium\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":2,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":14976,\"date\":\"2026-05-19T16:00:36+02:00\",\"modified\":\"2026-05-19T08:07:05+00:00\",\"slug\":\"apple-watch-ultra-4-redesign-monitoraggio-pressione\",\"title\":\"Apple Watch Ultra 4: redesign e monitoraggio della pressione\",\"excerpt\":\"Secondo DigiTimes, Apple Watch Ultra 4 potrebbe arrivare con un redesign e una nuova funzione di notifiche per l’ipertensione, in revisione FDA.\",\"categoryName\":\"Watch\",\"categorySlug\":\"watch\",\"categoryId\":186,\"imageUrl\":\"https://static.techjournal.it/2026/05/Apple-Watch-Ultra-2-Black-Titanium-768x432.jpg\",\"imageAlt\":\"Apple-Watch-Ultra-2-Black-Titanium\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":1,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":14318,\"date\":\"2026-04-18T13:32:07+02:00\",\"modified\":\"2026-04-18T11:32:07+00:00\",\"slug\":\"ios-27-nuove-funzioni-oltre-siri-satellite-apple-intelligence\",\"title\":\"iOS 27: nuove funzioni oltre Siri, tra satellite e Apple Intelligence\",\"excerpt\":\"Secondo i rumor, iOS 27 arriverà a settembre dopo il keynote WWDC 2026 del 8 giugno e introdurrà novità su connettività satellitare, Liquid Glass e Apple Intelligence.\",\"categoryName\":\"iOS\",\"categorySlug\":\"ios\",\"categoryId\":14,\"imageUrl\":\"https://static.techjournal.it/2026/04/iOS-27-on-iPhone-17-1-768x432.jpg\",\"imageAlt\":\"iOS-27-on-iPhone-17-1\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":0,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":14298,\"date\":\"2026-04-15T21:19:30+02:00\",\"modified\":\"2026-04-15T19:19:30+00:00\",\"slug\":\"apple-rimuove-app-freecash-dall-app-store-raccolta-dati\",\"title\":\"Apple rimuove l’app Freecash dall’App Store dopo mesi di raccolta dati\",\"excerpt\":\"Apple ha ri