{"kind":"FETCH","data":{"headers":{},"body":"{\"posts\":[{\"id\":15329,\"date\":\"2026-06-08T12:53:20+02:00\",\"modified\":\"2026-06-08T10:53:20+00:00\",\"slug\":\"iphone-ultra-touch-id-al-posto-del-face-id\",\"title\":\"iPhone Ultra: Touch ID al posto del Face ID sul modello pieghevole\",\"excerpt\":\"Le indiscrezioni sul prossimo iPhone pieghevole chiamato iPhone Ultra indicano un cambio importante: Touch ID al posto del Face ID.\",\"categoryName\":\"Apple\",\"categorySlug\":\"apple\",\"categoryId\":2,\"imageUrl\":\"https://static.techjournal.it/2026/06/iphone-ultra-touch-id-768x432.jpg\",\"imageAlt\":\"iphone-ultra-touch-id\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":2,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":15259,\"date\":\"2026-06-01T14:30:06+02:00\",\"modified\":\"2026-05-31T22:39:02+00:00\",\"slug\":\"ios-27-macbook-ultra-iphone-pieghevole-novita-in-arrivo\",\"title\":\"iOS 27, MacBook Ultra e iPhone pieghevole: le novità in arrivo\",\"excerpt\":\"Nuovi leak su Siri in iOS 27, rumor su un possibile “MacBook Ultra”, aggiornamenti su Apple Watch per il monitoraggio glicemico e prime indicazioni sull’iPhone pieghevole.\",\"categoryName\":\"Apple\",\"categorySlug\":\"apple\",\"categoryId\":2,\"imageUrl\":\"https://static.techjournal.it/2026/06/top-stories-2026-05-30-768x432.jpg\",\"imageAlt\":\"top-stories-2026-05-30\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":1,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":15253,\"date\":\"2026-06-01T12:00:38+02:00\",\"modified\":\"2026-05-31T22:38:48+00:00\",\"slug\":\"nuovi-apple-tv-4k-homepod-mini-quasi-pronti-siri-aggiornata-attesa\",