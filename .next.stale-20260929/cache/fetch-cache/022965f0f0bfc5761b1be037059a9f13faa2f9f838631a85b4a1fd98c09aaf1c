ategorySlug\":\"apple\",\"categoryId\":2,\"imageUrl\":\"https://static.techjournal.it/2026/08/iOS-27-Feature-Cool-768x432.jpg\",\"imageAlt\":\"iOS-27-Feature-Cool\",\"authorName\":\"\",\"authorAvatarUrl\":\"\",\"authorSlug\":\"\",\"viewCount\":0,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":17238,\"date\":\"2026-08-28T12:02:00+02:00\",\"modified\":\"2026-08-28T10:02:00+00:00\",\"slug\":\"ios-27-nuove-funzioni-ai-apple-tv-4k-homepod\",\"title\":\"iOS 27: nuove funzioni AI in arrivo su Apple TV 4K ed HomePod\",\"excerpt\":\"Dai primi indizi sul codice di iOS 27 emergono possibili nuove funzioni basate sull’intelligenza artificiale in arrivo su Apple TV 4K e HomePod.\",\"categoryName\":\"Smart Home\",\"categorySlug\":\"smart-home\",\"categoryId\":11,\"imageUrl\":\"https://static.techjournal.it/2026/08/apple-tv-homepod-siri-ai-768x432.jpg\",\"imageAlt\":\"apple-tv-homepod-siri-ai\",\"authorName\":\"\",\"authorAvatarUrl\":\"\",\"authorSlug\":\"\",\"viewCount\":0,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":17236,\"date\":\"2026-08-28T09:28:00+02:00\",\"modified\":\"2026-08-28T07:28:00+00:00\",\"slug\":\"concept-video-iphone-ultra-pieghevole-presentazione\",\"title\":\"Concept video: così potrebbe presentarsi l’iPhone Ultra pieghevole\",\"excerpt\":\"Un concept video firmato da Gunhoo Lee prova a immaginare la presentazione dell’iPhone Ultra pieghevole: un’anteprima digitale curata e molto realistica.\",\"categoryName\":\"Apple\",\"categorySlug\":\"apple\",\"categoryId\":2,\"imageUrl\":\"https://static.techjournal.it/2026/08/iphone-ultra-foldable-video-concept-768x432.jpg\",\"imageAlt\":\"iphone-ultra-foldable-video-concept\",\"authorName\":\"\",\"authorAvatarUrl\":\"\",\"authorSlug\":\"\",\"viewCount\":0,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":17234,\"date\":\"2026-08-28T09:06:00+02:00\",\"modified\":\"2026-08-28T07:06:00+00:00\",\"slug\":\"immagini-trapelate-primo-sguardo-server-ai-appl