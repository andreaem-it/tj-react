ngelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":14677,\"date\":\"2026-05-07T19:33:48+02:00\",\"modified\":\"2026-05-07T13:37:25+00:00\",\"slug\":\"iphone-17-primo-mondo-q1-2026-counterpoint\",\"title\":\"iPhone 17 primo al mondo nel Q1 2026, secondo Counterpoint\",\"excerpt\":\"Nel primo trimestre 2026, iPhone 17 è lo smartphone più venduto a livello globale: 6% delle unità, con la serie che domina le prime tre posizioni secondo Counterpoint.\",\"categoryName\":\"iPhone\",\"categorySlug\":\"iphone\",\"categoryId\":4,\"imageUrl\":\"https://static.techjournal.it/2026/05/iPhone-17-Colors-768x432.jpg\",\"imageAlt\":\"iPhone-17-Colors\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":7,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":14667,\"date\":\"2026-05-07T15:36:01+02:00\",\"modified\":\"2026-05-07T13:36:01+00:00\",\"slug\":\"leaker-apple-ritarda-iphone-18-strategia-di-mercato\",\"title\":\"Leaker: Apple ritarda iPhone 18 per strategia di mercato\",\"excerpt\":\"Secondo il leaker “Fixed Focus Digital”, Apple avrebbe scelto di ritardare l’iPhone 18 standard per estendere le vendite di iPhone 17, ridurre i costi e rafforzarsi contro i rivali Android.\",\"categoryName\":\"Apple\",\"categorySlug\":\"apple\",\"categoryId\":2,\"imageUrl\":\"https://static.techjournal.it/2026/05/iphone-17-models-768x432.jpg\",\"imageAlt\":\"iphone-17-models\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":1,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":14661,\"date\":\"2026-05-07T15:35:25+02:00\",\"modified\":\"2026-05-07T13:35:25+00:00\",\"slug\":\"pixel-non-adotteranno-liquid-glass-apple\",\"title\":\"Pixel non adotteranno il design “Liquid Glass” di Apple\",\"excerpt\":\"Sameer Samat, presidente Android per Google, smentisce l’adozione del design “Liquid Glass” su Pixel. Restano però voci su effetti di traslucenza in Android 17.\",\"categoryName\":\"Tecnologia\",\"categorySlug\":\"tecnologia\",\"categoryId\":5,\"imageUrl\":\"https://static.techjournal.it/2026/05/Photos-App-Icon-Liquid-Glass-768x432.jpg\",\"imageAlt\":\"Photos-App-Icon-Liquid-Glass\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":5,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":14637,\"date\":\"2026-05-06T12:30:15+02:00\",\"modified\":\"2026-05-06T07:08:11+00:00\",\"slug\":\"ios-26-5-tre-nuove-funzioni-rcs-cifrato\",\"title\":\"iOS 26.5: tre nuove funzioni per iPhone, tra cui RCS cifrato\",\"excerpt\":\"Secondo le note di rilascio di Apple, iOS 26.5 introduce tre novità: cifratura end-to-end per RCS tra iOS e Android, “Suggested Places” in Apple Maps e una nuova wallpaper Pride Luminance.\",\"categoryName\":\"iOS\",\"categorySlug\":\"ios\",\"categoryId\":14,\"imageUrl\":\"https://static.techjournal.it/2026/05/iOS-26.5-Glass-Feature-Purple-768x432.jpg\",\"imageAlt\":\"iOS-26.5-Glass-Feature-Purple\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":2,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":14489,\"date\":\"2026-04-28T19:26:47+02:00\",\"modified\":\"2026-04-28T17:26:47+00:00\",\"slug\":\"iphone-20th-anniversary-display-liquid-glass-per-far-sparire-le-cornici\",\"title\":\"iPhone 20th Anniversary: display “Liquid Glass” per far sparire le cornici\",\"excerpt\":\"Secondo un leaker, l’iPhone per il 20° anniversario potrebbe usare una nuova tecnologia di schermo curva per ridurre al minimo la visibilità delle cornici.\",\"categoryName\":\"iPhone\",\"categorySlug\":\"iphone\",\"categoryId\":4,\"imageUrl\":\"https://static.techjournal.it/2026/04/Mostly-Screen-iPhone-Purple-Feature-2027-768x432.jpg\",\"imageAlt\":\"Mostly-Screen-iPhone-Purple-Feature-2027\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":6,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":14334,\"date\":\"2026-04-18T13:32:53+02:00\",\"modified\":\"2026-04-18T11:32:53+00:00\",\"slug\":\"fedelta-iphone-964-android-piu-propensi-a-cambiare\",\"title\":\"Fedeltà iPhone al 96,4%: utenti Android più propensi a cambiare\",\"excerpt\":\"Secondo un sondaggio SellCell, il 96,4% degli utenti iPhone intende restare su iPhone al prossimo upgrade, mentre tra gli utenti Android la quota di chi valuta il cambio sale al 13,6%.\",\"categoryName\":\"Apple\",\"categorySlug\":\"apple\",\"categoryId\":2,\"imageUrl\":\"https://static.techjournal.it/2026/04/smartphone-brand-loyalty-survey-2026-768x497.jpg\",\"imageAlt\":\"smartphone-brand-loyalty-survey-2026\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":1,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":14255,\"date\":\"2026-04-14T08:12:23+02:00\",\"modified\":\"2026-04-14T06:12:23+00:00\",\"slug\":\"iphone-18-pro-deep-red-colore-leaker\",\"title\":\"iPhone 18 Pro: possibile nuovo colore Deep Red, secondo un leaker\",\"excerpt\":\"Un leaker cinese sostiene che Apple stia testando un nuovo Deep Red per iPhone 18 Pro e Pro Max, citando prototipi visti su smartphone Android concorrenti.\",\"categoryName\":\"iPhone\",\"categorySlug\":\"iphone\",\"categoryId\":4,\"imageUrl\":\"https://static.techjournal.it/2026/04/iPhone-18-Pro-Deep-Red-Feature-768x432.jpg\",\"imageAlt\":\"iPhone-18-Pro-Deep-Red-Feature\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":2,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":14243,\"date\":\"2026-04-14T08:11:43+02:00\",\"modified\":\"2026-04-14T06:11:43+00:00\",\"slug\":\"controllare-chi-usa-hotspot-iphone-ios-26-4\",\"title\":\"Come controllare chi usa l’hotspot del tuo iPhone (iOS 26.4)\",\"excerpt\":\"Con iOS 26.4 Apple rende più semplice verificare il consumo dati del Personal Hotspot: ora trovi l’elenco dei dispositivi direttamente nel menu Hotspot.\",\"categoryName\":\"Apple\",\"categorySlug\":\"apple\",\"categoryId\":2,\"imageUrl\":\"https://static.techjournal.it/2026/04/personal-hotspot-768x432.jpeg\",\"imageAlt\":\"personal-hotspot\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":1,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":14237,\"date\":\"2026-04-14T08:11:19+02:00\",\"modified\":\"2026-04-14T06:11:19+00:00\",\"slug\":\"apple-seconda-beta-ios-26-5-ipados-26-5\",\"title\":\"Apple rilascia la seconda beta di iOS 26.5 e iPadOS 26.5\",\"excerpt\":\"Apple ha distribuito agli sviluppatori la seconda beta di iOS 26.5 e iPadOS 26.5 per test. Le novità includono aggiornamenti su Maps, RCS e funzioni per wearables in UE.\",\"categoryName\":\"Apple\",\"categorySlug\":\"apple\",\"categoryId\":2,\"imageUrl\":\"https://static.techjournal.it/2026/04/iOS-26.5-Glass-Feature-Warm-768x432.jpg\",\"imageAlt\":\"iOS-26.5-Glass-Feature-Warm\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":1,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":13991,\"date\":\"2026-03-24T14:02:03+01:00\",\"modified\":\"2026-03-24T13:02:03+00:00\",\"slug\":\"kwikset-serrature-intelligenti-apple-carplay\",\"title\":\"Le serrature intelligenti Kwikset possono ora essere controllate tramite Apple CarPlay\",\"excerpt\":\"Kwikset ha introdotto l'integrazione con CarPlay nell'app Kwikset, consentendo ai proprietari di iPhone di bloccare o sbloccare le serrature intelligenti direttamente dal cruscotto dell'auto.\",\"categoryName\":\"Smart Home\",\"categorySlug\":\"smart-home\",\"categoryId\":11,\"imageUrl\":\"https://static.techjournal.it/2026/03/kwikset-carplay-768x432.jpg\",\"imageAlt\":\"kwikset carplay\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":1,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":13414,\"date\":\"2026-02-28T13:07:31+01:00\",\"modified\":\"2026-02-28T12:41:06+00:00\",\"slug\":\"iphone-18-pro-riporta-funzionalita-samsung-abbandonata\",\"title\":\"iPhone 18 Pro riporta una funzionalità abbandonata da Samsung anni fa\",\"excerpt\":\"L'iPhone 18 Pro e l'iPhone 18 Pro Max di Apple sono attesi con un'importante novità: una fotocamera principale con apertura variabile, una funzionalità che Samsung ha abbandonato nel 2020.\",\"categoryName\":\"iPhone\",\"categorySlug\":\"iphone\",\"categoryId\":4,\"imageUrl\":\"https://static.techjournal.it/2026/02/iphone-17-cameras-zoom-768x432.jpg\",\"imageAlt\":\"iphone cameras zoom\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewC