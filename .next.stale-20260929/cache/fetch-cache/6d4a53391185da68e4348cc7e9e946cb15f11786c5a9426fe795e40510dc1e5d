\":14433,\"date\":\"2026-04-25T12:32:18+02:00\",\"modified\":\"2026-04-25T10:32:18+00:00\",\"slug\":\"annunci-in-arrivo-su-apple-maps-questa-estate-cosa-aspettarsi\",\"title\":\"Annunci in arrivo su Apple Maps questa estate: cosa aspettarsi\",\"excerpt\":\"Apple prevede di mostrare annunci nell’app Apple Maps a partire da questa estate. Ecco dove compariranno, come funzioneranno e le indicazioni su privacy e paesi.\",\"categoryName\":\"Applicazioni\",\"categorySlug\":\"applicazioni\",\"categoryId\":13,\"imageUrl\":\"https://static.techjournal.it/2026/04/Ads-Are-Coming-to-Apple-Maps-Feature-768x432.jpg\",\"imageAlt\":\"Ads-Are-Coming-to-Apple-Maps-Feature\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":2,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":14237,\"date\":\"2026-04-14T08:11:19+02:00\",\"modified\":\"2026-04-14T06:11:19+00:00\",\"slug\":\"apple-seconda-beta-ios-26-5-ipados-26-5\",\"title\":\"Apple rilascia la seconda beta di iOS 26.5 e iPadOS 26.5\",\"excerpt\":\"Apple ha distribuito agli sviluppatori la seconda beta di iOS 26.5 e iPadOS 26.5 per test. Le novità includono aggiornamenti su Maps, RCS e funzioni per wearables in UE.\",\"categoryName\":\"Apple\",\"categorySlug\":\"apple\",\"categoryId\":2,\"imageUrl\":\"https://static.techjournal.it/2026/04/iOS-26.5-Glass-Feature-Warm-768x432.jpg\",\"imageAlt\":\"iOS-26.5-Glass-Feature-Warm\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":1,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":14106,\"date\":\"2026-04-02T13:26:52+02:00\",\"modified\":\"2026-04-02T11:26:52+00:00\",\"slug\":\"siri-in-ios-27-tutto-quello-che-sappiamo\",\"title\":\"Siri in iOS 27: tutto quello che sappiamo (rumor)\",\"excerpt\":\"Secondo i rumor, iOS 27, iPadOS 27 e macOS 27 introdurranno una Siri riprogettata come chatbot, con app dedicata, integrazione di sistema e nuove funzioni basate su Gemini.\",\"categoryName\":\"iOS\",\"categorySlug\":\"ios\",\"categoryId\":14,\"imageUrl\":\"https://static.techjournal.it/2026/04/iOS-27-and-Siri-Finder-Thumb-768x432.jpg\",\"imageAlt\":\"iOS-27-and-Siri-Finder-Thumb\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":1,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":14071,\"date\":\"2026-03-29T22:39:00+02:00\",\"modified\":\"2026-03-29T20:39:00+00:00\",\"slug\":\"ios-27-siri-app-extensions\",\"title\":\"iOS 27: Siri potrebbe arrivare come app con “Extensions”\",\"excerpt\":\"Secondo Mark Gurman, iOS 27, iPadOS 27 e macOS 27 potrebbero includere una nuova app di Siri con una funzione “Extensions” per integrare chatbot di terze parti.\",\"categoryName\":\"Apple\",\"categorySlug\":\"apple\",\"categoryId\":2,\"imageUrl\":\"https://static.techjournal.it/2026/03/iOS-27-on-iPhone-17-1-768x432.jpg\",\"imageAlt\":\"iOS-27-on-iPhone-17-1\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":4,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":14057,\"date\":\"2026-03-26T21:33:08+01:00\",\"modified\":\"2026-03-26T20:33:08+00:00\",\"slug\":\"apple-chatbot-ai-terze-parti-integrabili-con-siri-in-ios-27\",\"title\":\"Apple: chatbot AI di terze parti integrabili con Siri in iOS 27\",\"excerpt\":\"Secondo Bloomberg, Apple in iOS 27 permetterà l’integrazione di chatbot AI di terze parti con Siri, espandendo l’attuale collaborazione con OpenAI/ChatGPT.\",\"categoryName\":\"Intelligenza Artificiale\",\"categorySlug\":\"intelligenza-artificiale\",\"categoryId\":188,\"imageUrl\":\"https://static.techjournal.it/2026/03/Gemini-Siri-Feature-768x432.jpg\",\"imageAlt\":\"Gemini-Siri-Feature\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":0,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":14004,\"date\":\"2026-03-24T19:42:05+01:00\",\"modified\":\"2026-03-24T18:42:05+00:00\",\"slug\":\"apple-rilascia-ios-26-4-ipados-26-4-playlist-playground-emoji-purchase-sharing\",\"title\":\"Apple rilascia iOS 26.4 e iPadOS 26.4: Playlist Playground, emoji e novità su Purchase Sharing\",\"excerpt\":\"Disponibili via aggiornamento over-the-air, iOS 26.4 e iPadOS 26.4 introducono Playlist Playground in beta su Apple Music, nuovi emoji e modifiche a Purchase Sharing nei gruppi Family Sharing.\",\"categoryName\":\"iPhone\",\"categorySlug\":\"iphone\",\"categoryId\":4,\"imageUrl\":\"https://static.techjournal.it/2026/03/ios-26-4-yellow-768x432.jpg\",\"imageAlt\":\"ios yellow\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":1,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":13948,\"date\":\"2026-03-21T00:55:47+01:00\",\"modified\":\"2026-03-20T23:55:47+00:00\",\"slug\":\"apple-rilascia-ios-26-4-ipados-26-4\",\"title\":\"Apple rilascia le versioni candidate di iOS 26.4 e iPadOS 26.4\",\"excerpt\":\"Apple ha rilasciato la versione candidata degli aggiornamenti iOS 26.4 e iPadOS 26.4 per sviluppatori e beta tester pubblici, introducendo nuove funzionalità e miglioramenti.\",\"categoryName\":\"Apple\",\"categorySlug\":\"apple\",\"categoryId\":2,\"imageUrl\":\"https://sta