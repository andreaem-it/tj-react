":[],\"tldr\":[],\"breaking\":null},{\"id\":12702,\"date\":\"2026-01-26T00:15:20+01:00\",\"modified\":\"2026-01-25T23:15:20+00:00\",\"slug\":\"notizie-principali-iphone-18-pro-leak-chatbot-siri-apple-ai-pin\",\"title\":\"Notizie Principali: Leak dell'iPhone 18 Pro, Chatbot Siri, Apple AI Pin e Altro\",\"excerpt\":\"I rumor su Apple stanno aumentando all'inizio del 2026, con chiarimenti sui conflitti riguardanti l'iPhone 18 Pro e nuove informazioni sui piani di Apple per Siri.\",\"categoryName\":\"Apple\",\"categorySlug\":\"apple\",\"categoryId\":2,\"imageUrl\":\"https://static.techjournal.it/2026/01/top-stories-2026-01-24-768x432.jpg\",\"imageAlt\":\"top stories\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":59,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":12656,\"date\":\"2026-01-26T00:10:15+01:00\",\"modified\":\"2026-01-25T23:10:15+00:00\",\"slug\":\"siri-chatbot-google-servers\",\"title\":\"Il chatbot di Siri di Apple potrebbe funzionare sui server di Google\",\"excerpt\":\"Apple sta considerando un cambiamento significativo nel funzionamento di Siri, valutando la possibilità di eseguire il suo chatbot di nuova generazione sull'infrastruttura cloud di Google.\",\"categoryName\":\"Intelligenza Artificiale\",\"categorySlug\":\"intelligenza-artificiale\",\"categoryId\":188,\"imageUrl\":\"https://static.techjournal.it/2026/01/apple-intelligence-black-1-768x432.jpeg\",\"imageAlt\":\"apple intelligence black\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":50,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":12573,\"date\":\"2026-01-20T11:24:54+01:00\",\"modified\":\"2026-01-20T10:24:54+00:00\",