l,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":13727,\"date\":\"2026-03-06T20:33:38+01:00\",\"modified\":\"2026-03-07T14:16:54+00:00\",\"slug\":\"macbook-neo-modelli-esauriti\",\"title\":\"MacBook Neo: Ecco quali modelli stanno esaurendo\",\"excerpt\":\"Se desideri ricevere un MacBook Neo il giorno del lancio, è consigliabile agire in fretta, poiché alcuni modelli stanno iniziando a esaurirsi per la consegna del 11 marzo.\",\"categoryName\":\"Mac\",\"categorySlug\":\"mac\",\"categoryId\":12,\"imageUrl\":\"https://static.techjournal.it/2026/03/MacBook-Neo-Feature-Pastel-1-1-768x432.jpg\",\"imageAlt\":\"MacBook Neo Feature Pastel\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":22,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":13555,\"date\":\"2026-03-02T17:31:03+01:00\",\"modified\":\"2026-03-02T20:29:22+00:00\",\"slug\":\"apple-presenta-nuovo-ipad-air-chip-m4\",\"title\":\"Apple presenta il nuovo iPad Air con chip M4, RAM aumentata, Wi-Fi 7 e altro\",\"excerpt\":\"Apple ha introdotto un nuovo iPad Air, dotato del chip M4 per prestazioni più veloci, 12GB di RAM, chip N1 con supporto Wi-Fi 7 e modem C1X per modelli cellulari.\",\"categoryName\":\"iPad\",\"categorySlug\":\"ipad\",\"categoryId\":10,\"imageUrl\":\"https://static.techjournal.it/2026/03/iPad-Air-M4-Chip-768x432.jpg\",\"imageAlt\":\"iPad Air M Chip\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":26,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":12903,\"date\":\"2026-02-01T15:07:51+01:00\",\"modified\":\"2026-02-01T14:07:51+00:00\",\"slug\":\"apple-cambia-ordine-mac\",\"title\":\"Apple Cambia il Modo di Ordinare un Mac\",\"excerpt\":\"Apple ha recentemente aggiornato il suo negozio online con un nuovo processo di ordinazione per i Mac, che include MacBook Air, MacBook Pro, iMac, Mac mini, Mac Studio e Mac Pro.\",\"categoryName\":\"Apple\",\"categorySlug\":\"apple\",\"categoryId\":2,\"imageUrl\":\"https://static.techjournal.it/2026/02/14-inch-MacBook-Pro-Keyboard-768x438.jpg\",\"imageAlt\":\"inch MacBook Pro Keyboard\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":50,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":12778,\"date\":\"2026-01-30T21:06:08+01:00\",\"modified\":\"2026-01-30T20:06:08+00:00\",\"slug\":\"ipad-16-anni\",\"title\":\"L'iPad di Apple compie 16 anni oggi\",\"excerpt\":\"Oggi si celebra il 16° anniversario dell'iPad, il tablet rivoluzionario di Apple presentato da Steve Jobs nel 2010.\",\"categoryName\":\"iPad\",\"categorySlug\":\"ipad\",\"categoryId\":10,\"imageUrl\":\"https://static.techjournal.it/2026/01/original-ipad-2-768x502.jpg\",\"imageAlt\":\"original ipad\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreaem\",\"viewCount\":51,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":12727,\"date\":\"2026-01-27T08:19:39+01:00\",\"modified\":\"2026-01-27T07:19:39+00:00\",\"slug\":\"apple-presenta-nuovo-airtag\",\"title\":\"Apple presenta il nuovo AirTag con maggiore portata, altoparlante più potente e altro\",\"excerpt\":\"Apple ha introdotto il nuovo AirTag di prossima generazione, con caratteristiche chiave tra cui una maggiore portata per il tracciamento degli oggetti e un altoparlante più potente.\",\"categoryName\":\"Apple\",\"categorySlug\":\"apple\",\"categoryId\":2,\"imageUrl\":\"https://static.techjournal.it/