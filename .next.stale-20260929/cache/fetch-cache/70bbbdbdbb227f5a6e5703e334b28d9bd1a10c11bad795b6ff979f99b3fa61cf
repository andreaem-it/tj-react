:\"Intelligenza Artificiale\",\"categorySlug\":\"intelligenza-artificiale\",\"categoryId\":188,\"imageUrl\":\"https://static.techjournal.it/2026/06/airpods-pro-3-orange-768x432.jpeg\",\"imageAlt\":\"airpods-pro-3-orange\",\"authorName\":\"\",\"authorAvatarUrl\":\"\",\"authorSlug\":\"\",\"viewCount\":3,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":15499,\"date\":\"2026-06-14T19:14:34+02:00\",\"modified\":\"2026-06-14T17:14:34+00:00\",\"slug\":\"apple-celebra-airpods-pro-3-nuovo-spot-cancellazione-rumore-in-ear-mondiali\",\"title\":\"Apple celebra le AirPods Pro 3 con un nuovo spot: la cancellazione del rumore in-ear protagonista ai Mondiali\",\"excerpt\":\"Apple lancia un nuovo spot dedicato alle AirPods Pro 3, mettendo al centro la cancellazione del rumore in-ear e il suo ruolo durante i Mondiali.\",\"categoryName\":\"Tecnologia\",\"categorySlug\":\"tecnologia\",\"categoryId\":5,\"imageUrl\":\"https://static.techjournal.it/2026/06/airpods-pro-3-768x432.jpg\",\"imageAlt\":\"airpods-pro-3\",\"authorName\":\"\",\"authorAvatarUrl\":\"\",\"authorSlug\":\"\",\"viewCount\":1,\"review\":null,\"changelog\":[],\"tldr\":[],\"breaking\":null},{\"id\":15259,\"date\":\"2026-06-01T14:30:06+02:00\",\"modified\":\"2026-05-31T22:39:02+00:00\",\"slug\":\"ios-27-macbook-ultra-iphone-pieghevole-novita-in-arrivo\",\"title\":\"iOS 27, MacBook Ultra e iPhone pieghevole: le novità in arrivo\",\"excerpt\":\"Nuovi leak su Siri in iOS 27, rumor su un possibile “MacBook Ultra”, aggiornamenti su Apple Watch per il monitoraggio glicemico e prime indicazioni sull’iPhone pieghevole.\",\"categoryName\":\"Apple\",\"categorySlug\":\"apple\",\"categoryId\":2,\"imageUrl\":\"https://static.techjournal.it/2026/06/top-stories-2026-05-30-768x432.jpg\",\"imageAlt\":\"top-stories-2026-05-30\",\"authorName\":\"Andrea Emili\",\"authorAvatarUrl\":\"https://secure.gravatar.com/avatar/a6d88f7136ceb04a0480684144e0ec339b40ae840f0d4f1233d56350e82f6a69?s=96&d=mm&r=g\",\"authorSlug\":\"andreae