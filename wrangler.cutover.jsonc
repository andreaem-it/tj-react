{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tj-web",
  "minify": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "routes": [
    { "pattern": "techjournal.it/*", "zone_name": "techjournal.it" },
    { "pattern": "www.techjournal.it/*", "zone_name": "techjournal.it" }
  ],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "tj-web" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "tj-web-cache" }],
  "d1_databases": [{ "binding": "NEXT_TAG_CACHE_D1", "database_name": "tj-web-tags", "database_id": "a339e284-0cad-4c8e-985d-6ce7655e8470" }],
  "durable_objects": { "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }, { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }],
  "observability": { "enabled": true },
  "images": { "binding": "IMAGES" },
  "vars": { "CLOUDFLARE_PREVIEW": "0", "TJ_API_BASE_URL": "https://backend.techjournal.it" }
}
